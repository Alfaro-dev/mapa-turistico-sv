rules_version = '2';

// Cada usuario sube solo dentro de su carpeta ({uid}); todos pueden ver las imágenes.
// Solo imágenes de hasta 5 MB.
service firebase.storage {
  match /b/{bucket}/o {

    function isImageUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Web: fotos de lugares (solo admin) y de reseñas (cada usuario las suyas).
    match /places/{uid}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && request.auth.uid == uid
        && (request.resource == null || isImageUnder5MB());
    }

    match /reviews/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && (request.resource == null || isImageUnder5MB());
    }

    // App: fotos de usuarios, check-ins, negocios y perfil.
    match /photos/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && (request.resource == null || isImageUnder5MB());
    }

    // Todo lo demás: cerrado.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
