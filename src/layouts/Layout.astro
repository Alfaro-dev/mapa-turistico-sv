---
import 'leaflet/dist/leaflet.css';
import '../styles/global.css';
import '../styles/loader.css';
import '../styles/datepicker.css';
import '../styles/lightbox.css';
import '../styles/dropzone.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Goz: volcanes, playas, lagos y pueblos de El Salvador en un mapa, con cómo llegar y reseñas de quienes ya fueron. El Salvador, un país chiquito, pero no te lo acabás.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#F2C14E" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Nunito+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  </head>
  <body>
    <slot />
  </body>
</html>
