---
// Goz: el torogoz con cabeza de pin. Símbolo de la marca.
interface Props { size?: number; simple?: boolean; id?: string; label?: string }
const { size = 40, simple = false, id = 'goz', label } = Astro.props;
const height = Math.round(size * 170 / 124);
const FULL = `<defs><clipPath id="clipUID"><path d="M60 112 C52 98 24 78 24 48 A36 36 0 1 1 96 48 C96 78 68 98 60 112 Z"></path></clipPath></defs><g class="pin"><path d="M60 112 C52 98 24 78 24 48 A36 36 0 1 1 96 48 C96 78 68 98 60 112 Z" fill="#0E7C7B"></path><rect x="0" y="62" width="120" height="60" fill="#C2581F" clip-path="url(#clipUID)"></rect><path d="M30 38 L92 36 L92 52 L32 54 Z" fill="#14302F" clip-path="url(#clipUID)"></path><path d="M93 38 L118 45 L93 51 Z" fill="#14302F"></path><circle cx="72" cy="44" r="5" fill="#F2C14E"></circle><circle cx="73.5" cy="44" r="2.2" fill="#14302F"></circle></g><g class="tail"><path d="M58 108 L50 150" stroke="#14302F" stroke-width="3" stroke-linecap="round"></path><path d="M62 108 L72 150" stroke="#14302F" stroke-width="3" stroke-linecap="round"></path><ellipse cx="49" cy="157" rx="7.5" ry="10" fill="#0E7C7B"></ellipse><ellipse cx="73" cy="157" rx="7.5" ry="10" fill="#C2581F"></ellipse></g>`;
const SIMPLE = `<defs><clipPath id="clipUID"><path d="M60 112 C52 98 24 78 24 48 A36 36 0 1 1 96 48 C96 78 68 98 60 112 Z"></path></clipPath></defs><g class="pin"><path d="M60 112 C52 98 24 78 24 48 A36 36 0 1 1 96 48 C96 78 68 98 60 112 Z" fill="#0E7C7B"></path><rect x="0" y="62" width="120" height="60" fill="#C2581F" clip-path="url(#clipUID)"></rect><path d="M30 38 L92 36 L92 52 L32 54 Z" fill="#14302F" clip-path="url(#clipUID)"></path><path d="M93 38 L118 45 L93 51 Z" fill="#14302F"></path><circle cx="72" cy="44" r="5" fill="#F2C14E"></circle><circle cx="73.5" cy="44" r="2.2" fill="#14302F"></circle></g><g class="tail"><path d="M58 108 L50 150" stroke="#14302F" stroke-width="4" stroke-linecap="round"></path><path d="M62 108 L72 150" stroke="#14302F" stroke-width="4" stroke-linecap="round"></path><ellipse cx="49" cy="157" rx="7.5" ry="10" fill="#0E7C7B"></ellipse><ellipse cx="73" cy="157" rx="7.5" ry="10" fill="#C2581F"></ellipse></g>`;
const body = (simple ? SIMPLE : FULL).replaceAll('UID', id);
---
<svg viewBox="-2 0 124 170" width={size} height={height} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} set:html={body}></svg>
