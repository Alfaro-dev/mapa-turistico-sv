  .biz-list { list-style: none; margin: 0; padding: 0; }
  .biz-row { width: 100%; display: flex; align-items: center; gap: 12px; padding: 8px; margin: 0 -8px; border: 0; background: transparent; color: var(--ink); text-align: left; cursor: pointer; border-radius: 12px; box-sizing: content-box; }
