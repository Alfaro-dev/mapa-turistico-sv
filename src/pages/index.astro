  .sort-chip[aria-pressed="true"] { background: var(--rama); border-color: var(--rama); color: #FFFFFF; }
  .photo-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .photo-cell { position: relative; }
  .photo-cell img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 10px; display: block; background: var(--photo); }
  .photo-badge { position: absolute; left: 6px; top: 6px; padding: 2px 8px; border-radius: 10px; background: var(--plumaje); color: var(--rama); font-size: 11px; font-weight: 800; }
  .vote-btn { position: absolute; right: 6px; bottom: 6px; min-width: 44px; height: 30px; padding: 0 8px; border: 0; border-radius: 15px; background: rgba(255,255,255,0.94); color: var(--ink); display: flex; align-items: center; gap: 4px; font-size: 13px; font-weight: 800; cursor: pointer; box-shadow: 0 1px 4px rgba(20,48,47,0.25); }
  .vote-btn svg { fill: none; stroke: var(--canela); stroke-width: 2.2; }
  .vote-btn.is-voted svg { fill: var(--canela); }
  .gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; margin-top: 14px; }
  .gallery img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px; display: block; }
  .section-title { margin: 28px 0 8px; font-family: var(--font-display); font-size: 20px; font-weight: 800; color: var(--ink); }
  .review { padding: 12px 0; border-top: 1px solid var(--line); }
  .review-head { display: flex; justify-content: space-between; gap: 8px; font-size: 15px; }
  .review-head strong { color: var(--ink); }
  .review-date { margin: 2px 0 0; font-size: 13px; color: var(--muted); }
  .review { position: relative; }
  .report-link { display: block; margin: 6px 0 0 auto; padding: 6px 2px; border: 0; background: none; color: var(--muted); font: inherit; font-size: 13px; font-weight: 700; cursor: pointer; }
  .report-link:hover { color: var(--canela); text-decoration: underline; text-underline-offset: 2px; }
  .report-link:focus-visible { outline: 3px solid var(--turquesa); outline-offset: 2px; border-radius: 6px; }
  .review-text { margin: 6px 0 0; font-size: 15px; line-height: 1.55; color: var(--ink-2); }
  .review-photos { display: flex; gap: 6px; margin-top: 8px; }
  .review-photos img { width: 72px; height: 54px; object-fit: cover; border-radius: 6px; }
  .near-row { width: 100%; display: flex; align-items: center; gap: 12px; padding: 8px 0; border: 0; background: transparent; color: var(--ink); font-size: 15px; cursor: pointer; text-align: left; }
  .near-text { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; }
  .near-name { font-weight: 800; }
  .near-km { color: var(--muted); white-space: nowrap; font-size: 14px; }

  /* Marcadores */
  .pin-wrap { background: none; border: 0; }
  .pin { width: 16px; height: 16px; border-radius: 50%; background: var(--pin); border: 3px solid var(--pin-ring); box-shadow: 0 1px 4px rgba(0,0,0,0.35); box-sizing: border-box; transition: transform .15s; }
  .pin-wrap:hover .pin { transform: scale(1.25); }
  .goz-pin { filter: drop-shadow(0 3px 3px rgba(20,48,47,0.35)); animation: goz-drop .45s cubic-bezier(.3,0,.4,1.4) both; }
  .goz-pin svg { display: block; }
  @keyframes goz-drop { from { transform: translateY(-26px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
  .me-dot { width: 18px; height: 18px; border-radius: 50%; background: #3B82F6; border: 3px solid #FFFFFF; box-shadow: 0 0 0 8px rgba(59,130,246,0.25); box-sizing: border-box; }
  .leaflet-tooltip.pin-label { background: var(--surface); color: var(--ink); border: 0; border-radius: 14px; padding: 4px 10px; font-weight: 700; font-size: 13px; box-shadow: 0 1px 6px rgba(20,48,47,0.25); }
  .leaflet-tooltip.pin-label::before { display: none; }
  .leaflet-control-attribution { margin-right: 76px !important; }

  .only-mobile { display: none !important; }

  /* ---------- Celular: hoja inferior por pasos ---------- */
  @media (max-width: 767px) {
    .only-mobile { display: flex !important; }
    .only-desktop { display: none !important; }
    .searchbox { top: calc(12px + env(safe-area-inset-top)); left: 12px; right: 68px; width: auto; }
    .account { top: calc(14px + env(safe-area-inset-top)); right: 12px; }
    .account-btn { width: 48px; height: 48px; padding: 0; border-radius: 24px; justify-content: center; }
    .account-avatar { width: 40px; height: 40px; border-radius: 20px; }
    .account-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .account-menu { top: 56px; }
    /* En el celular es una hoja que sube desde abajo. */
    .review-dialog { width: 100vw; max-width: 100vw; max-height: 92vh; margin: auto 0 0; border-radius: 24px 24px 0 0; }
    .review-dialog[open] { animation: rv-up .22s ease-out; }
    @keyframes rv-up { from { transform: translateY(24px); opacity: .6; } }
    .rv-grab { display: block; width: 40px; height: 5px; margin: 8px auto 0; border-radius: 3px; background: #D3DFDD; }
    .rv-head { padding: 10px 16px 6px 20px; }
    .review-body { padding: 4px 20px 20px; }
    .review-actions { margin: 4px -20px -20px; padding: 12px 20px calc(14px + env(safe-area-inset-bottom)); }
    .review-title { font-size: 23px; }
    .star-pick { width: 46px; height: 46px; }
    .star-label { width: 100%; margin: 2px 0 0 6px; }
    body.panel-open .searchbox { background: var(--surface); box-shadow: 0 2px 10px rgba(20,48,47,0.2); }
    .chips, body.panel-open .chips { top: calc(76px + env(safe-area-inset-top)); left: 0; right: 0; margin: 0; padding: 4px 12px; }
    .chip { height: 38px; }
    .panel[data-sheet="full"] ~ .chips, body.sheet-full .chips { display: none; }
    .map-controls { right: 12px; bottom: calc(var(--sheet-h, 116px) + 12px); transition: bottom .25s ease; }
    body.sheet-full .map-controls { display: none; }
    .leaflet-control-attribution { display: none; }

    .panel { top: auto; right: 0; width: auto; height: var(--sheet-h, 116px); transform: none; border-radius: 22px 22px 0 0; box-shadow: 0 -4px 18px rgba(20,48,47,0.16); transition: height .25s ease; padding-bottom: env(safe-area-inset-bottom); }
    .panel.is-dragging { transition: none; }
    .sheet-head { flex-direction: column; flex-shrink: 0; touch-action: none; cursor: grab; }
    .sheet-toggle { display: flex; justify-content: center; align-items: center; width: 100%; height: 24px; padding: 0; border: 0; background: transparent; cursor: grab; }
    .grip { width: 40px; height: 5px; border-radius: 3px; background: #B9CCC9; }
    .peek { flex-direction: column; padding: 4px 20px 12px; }
    .peek p { margin: 0; }
    .peek-title { font-family: var(--font-display); font-weight: 800; font-size: 20px; line-height: 1.2; color: var(--ink); }
    .peek-sub { font-size: 14px; font-weight: 600; color: var(--muted); }
    .panel:not([data-sheet="peek"]) .peek { display: none; }
    .panel[data-sheet="peek"] .panel-body { display: none; }
    .panel-body { padding: 4px 20px 24px; }
    .list-title { font-size: 20px; }
    .detail-photo { height: 160px; }
    .detail-title { font-size: 26px; margin-top: 12px; }
    .back-btn { margin-top: -4px; }
  }
</style>

<script>
  import { collection, getDocs, getDoc, addDoc, setDoc, doc, updateDoc, increment, serverTimestamp, query, where, writeBatch, orderBy, limit } from 'firebase/firestore';
  import { signInWithPopup, signOut, onAuthStateChanged } from 'firebase/auth';
  import { db, auth, googleProvider } from '../lib/firebase';
  import { uploadImage } from '../lib/cloudinary';
  import { esc, safeUrl, num } from '../lib/escape';
  import { datePicker } from '../lib/datePicker';
  import { LEGAL } from '../lib/legal';
  import { GOZ_PIN_SVG } from '../lib/gozPin';

  // Foto que no carga: se cambia por el recuadro vacío de la misma forma, sin el ícono roto del navegador.
  document.addEventListener('error', (e) => {
    const img = e.target as HTMLElement;
    if (!(img instanceof HTMLImageElement) || img.dataset.broken) return;
    const s = document.createElement('span');
    s.className = `${img.className} img-broken`.trim();
    s.setAttribute('aria-hidden', 'true');
    img.replaceWith(s);
  }, true);


  declare const L: any;

  interface Place {
    id: string; name: string; category: string; lat: number; lng: number;
    description?: string; municipality?: string; department?: string;
    schedule?: string; price?: string; website?: string;
    photos?: string[]; recommendations?: string[]; visitCount?: number;
  }
  interface Review { id?: string; placeId: string; userId?: string; userName?: string; userPhoto?: string; rating: number; comment?: string; photos?: string[]; visitDate?: string; verified?: boolean; createdAt?: any; }

  const CATEGORY_NAMES: Record<string, string> = {
    playa: 'Playa', montaña: 'Volcán o montaña', histórico: 'Sitio histórico', gastronomía: 'Comida',
    cultura: 'Cultura', aventura: 'Aventura', río: 'Río o cascada', lago: 'Lago', mirador: 'Mirador', pueblo: 'Pueblo', other: 'Lugar',
  };
  // Ícono por categoría: se usa cuando el lugar todavía no tiene foto.
  const CAT_ICON: Record<string, string> = {
    montaña: '<path d="M3 20l6-11 3 4 2-3 7 10z"></path>',
    playa: '<path d="M2 15c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2M2 20c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2"></path><circle cx="17" cy="6" r="2.5"></circle>',
    lago: '<path d="M3 16c3-5 15-5 18 0-3 4-15 4-18 0z"></path><path d="M6 9l3-4 3 4M12 9l3-4 3 4"></path>',
    mirador: '<circle cx="7" cy="14" r="3.5"></circle><circle cx="17" cy="14" r="3.5"></circle><path d="M10.5 14h3M5 10.5L7 5h3M19 10.5L17 5h-3"></path>',
    pueblo: '<path d="M3 21h18M5 21V10l5-4 5 4v11M15 21v-7h4v7M9 21v-4h2v4"></path>',
    histórico: '<path d="M3 21h18M5 21V11M9 21V11M15 21V11M19 21V11M3 11l9-6 9 6z"></path>',
    cultura: '<path d="M12 3a9 9 0 100 18c1.1 0 1.5-.8 1.5-1.5 0-.9-.6-1.3-.6-2.1 0-.9.7-1.4 1.6-1.4H17a4 4 0 004-4c0-5-4-9-9-9z"></path><circle cx="7.5" cy="11" r="1"></circle><circle cx="10" cy="7" r="1"></circle><circle cx="15" cy="7.5" r="1"></circle>',
    río: '<path d="M12 3c3 4 6 7.5 6 11a6 6 0 01-12 0c0-3.5 3-7 6-11z"></path>',
    aventura: '<path d="M7 8a5 5 0 0110 0v12H7z"></path><path d="M9 4.5V3h6v1.5M7 13h10"></path>',
    gastronomía: '<path d="M7 3v8M5 3v5a2 2 0 004 0V3M7 11v10M16 3c-1.7 0-3 2-3 5s1.3 4 3 4v9"></path>',
    other: '<path d="M12 21s-7-6.2-7-11a7 7 0 0114 0c0 4.8-7 11-7 11z"></path><circle cx="12" cy="10" r="2.5"></circle>',
  };
  const catIcon = (c: string, size = 22) => `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${CAT_ICON[c] || CAT_ICON.other}</svg>`;
  // Horario o precio que no dicen nada concreto no se muestran.
  const VAGUE = /^(todo el d[ií]a|de d[ií]a|abierto todo el d[ií]a|todos los d[ií]as|abierto|consult[aá].*|var[ií]a.*|n\/a|-)$/i;
  const specific = (v?: string) => !!v && !VAGUE.test(v.trim());
  const priceText = (v: string) => /^gratis$/i.test(v) ? 'Entrada gratis' : /^con costo$/i.test(v) ? 'Entrada con costo' : v;

  const $ = (id: string) => document.getElementById(id) as any;
  const isMobile = () => window.matchMedia('(max-width: 767px)').matches;
  const normalize = (s: unknown) => String(s ?? '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

  let allPlaces: Place[] = [];
  let filtered: Place[] = [];
  let reviewsByPlace: Record<string, Review[]> = {};
  // Fotos que suben los turistas. La más votada es la portada del lugar.
  interface CPhoto { id: string; placeId: string; userId: string; userName?: string; userPhoto?: string; url: string; votes?: number; createdAt?: any; }
  let photosByPlace: Record<string, CPhoto[]> = {};
  let votedPhotos = new Set<string>();
  const sortPhotos = (list: CPhoto[]) => list.sort((a, b) => num(b.votes) - num(a.votes) || (a.createdAt?.toMillis?.() ?? 0) - (b.createdAt?.toMillis?.() ?? 0));
  // Portada: la foto de turista con más votos (si tiene al menos 1); si no, la foto que cargó Goz.
  function coverOf(p: Place): { url: string; photo?: CPhoto } {
    const top = photosByPlace[p.id]?.[0];
    if (top && num(top.votes) > 0 && safeUrl(top.url)) return { url: safeUrl(top.url), photo: top };
    return { url: safeUrl(p.photos?.[0]) };
  }
  let currentCategory = 'all';
  let currentQuery = '';
  let selectedId: string | null = null;
  let userPos: [number, number] | null = null;
  let detailFromList = false;

  // ---------- Mapa ----------
  const map = L.map('map', { zoomControl: false, attributionControl: true, zoomSnap: 0.25 }).setView([13.70, -89.20], 11);
  // Teselas de OpenStreetMap (gratis, sin clave).
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
  }).addTo(map);

  const markerLayer = L.layerGroup().addTo(map);
  let markers: Record<string, any> = {};
  let meMarker: any = null;

  // ---------- Negocios ----------
  interface Business {
    id: string; name: string; category: string; lat: number; lng: number; placeId?: string; placeName?: string;
    description?: string; address?: string; phone?: string; whatsapp?: string; menu?: string; schedule?: string;
    coverUrl?: string; photos?: string[]; promoToday?: string; featured?: boolean; plan?: string; planUntil?: string; status?: string;
  }
  const BIZ_NAMES: Record<string, string> = { hotel: 'Hospedaje', restaurante: 'Restaurante', cafeteria: 'Cafetería', tienda: 'Tienda', otro: 'Negocio' };
  const BIZ_ICON: Record<string, string> = {
    hotel: '<path d="M3 18v-7h18v7M3 14h18M7 11V8h5v3"></path>',
    restaurante: '<path d="M7 3v8M5 3v5a2 2 0 004 0V3M7 11v10M16 3c-1.7 0-3 2-3 5s1.3 4 3 4v9"></path>',
    cafeteria: '<path d="M4 9h12v5a5 5 0 01-5 5H9a5 5 0 01-5-5zM16 10h1.5a2.5 2.5 0 010 5H16M8 3v3M12 3v3"></path>',
    tienda: '<path d="M5 8h14l-1 12H6zM9 8V6a3 3 0 016 0v2"></path>',
    otro: '<path d="M4 10l2-5h12l2 5M5 10v9h14v-9M4 10h16"></path>',
  };
  const bizIcon = (c: string, size = 16) => `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${BIZ_ICON[c] || BIZ_ICON.otro}</svg>`;
  // Destacado o Pro, con el plan pagado al día (planUntil = AAAA-MM-DD; sin fecha = sin vencimiento).
  const isFeatured = (b: Business) => {
    const paid = !b.planUntil || b.planUntil >= new Date().toLocaleDateString('en-CA');
    return paid && (!!b.featured || b.plan === 'destacado' || b.plan === 'pro');
  };
  interface Coupon { id: string; businessId: string; title: string; description?: string; discount?: string; code?: string; validFrom?: string; validUntil?: string; maxUses?: number; usedCount?: number; active?: boolean; }
  let couponsByBiz: Record<string, Coupon[]> = {};
  let myRedemptions = new Set<string>();
  const couponOk = (c: Coupon) => {
    const now = Date.now();
    return c.active !== false
      && (!c.validFrom || Date.parse(c.validFrom) <= now)
      && (!c.validUntil || Date.parse(c.validUntil) >= now)
      && (!num(c.maxUses) || num(c.usedCount) < num(c.maxUses));
  };
  let allBusinesses: Business[] = [];
  let selectedBizId: string | null = null;
  let bizFromPlace: string | null = null;
  // Lo elegido (Goz o el negocio) va en su propia capa, siempre encima de los demás puntos.
  map.createPane('selPane'); (map.getPane('selPane') as HTMLElement).style.zIndex = '650';
  const bizLayer = L.layerGroup();
  const BIZ_MIN_ZOOM = 12;
  // Carga por zona: franjas de 0.2° de latitud; desde el zoom 9 se piden por zona.
  const BAND = 0.2, ZONE_ZOOM = 9, TOP_LIMIT = 40;

  function renderBizMarkers() {
    bizLayer.clearLayers();
    allBusinesses.forEach((b) => {
      if (!Number.isFinite(b.lat) || !Number.isFinite(b.lng)) return;
      const sel = b.id === selectedBizId;
      const icon = L.divIcon({
        className: 'pin-wrap',
        html: `<div class="biz-pin${isFeatured(b) ? ' is-featured' : ''}${sel ? ' is-selected' : ''}">${bizIcon(b.category, sel ? 18 : 14)}</div>`,
        iconSize: sel ? [36, 36] : [26, 26], iconAnchor: sel ? [18, 18] : [13, 13],
      });
      const m = L.marker([b.lat, b.lng], { icon, keyboard: true, title: b.name, alt: b.name, ...(sel ? { pane: 'selPane' } : {}) });
      m.bindTooltip(esc(b.name), { direction: 'top', offset: [0, sel ? -18 : -13], className: 'pin-label', permanent: sel });
      m.on('click', () => selectBusiness(b.id));
      m.addTo(bizLayer);
    });
  }
  // Los negocios aparecen al acercarse, para no llenar el mapa del país.
  function updateBizLayer() {
    const show = map.getZoom() >= BIZ_MIN_ZOOM || !!selectedBizId;
    if (show && !map.hasLayer(bizLayer)) bizLayer.addTo(map);
    if (!show && map.hasLayer(bizLayer)) map.removeLayer(bizLayer);
  }
  map.on('zoomend', updateBizLayer);

  // Los lugares son puntos turquesa; el elegido es Goz, el torogoz-pin, que cae sobre el punto.
  const pinIcon = (selected: boolean) => selected
    ? L.divIcon({ className: 'pin-wrap', html: `<div class="goz-pin">${GOZ_PIN_SVG}</div>`, iconSize: [44, 61], iconAnchor: [22, 40] })
    : L.divIcon({ className: 'pin-wrap', html: '<div class="pin"></div>', iconSize: [16, 16], iconAnchor: [8, 8] });

  function renderMarkers() {
    markerLayer.clearLayers();
    markers = {};
    filtered.forEach((p) => {
      if (!Number.isFinite(p.lat) || !Number.isFinite(p.lng)) return;
      const sel = p.id === selectedId;
      const m = L.marker([p.lat, p.lng], { icon: pinIcon(sel), keyboard: true, title: p.name, alt: p.name, ...(sel ? { pane: 'selPane' } : {}) });
      m.bindTooltip(esc(p.name), { direction: 'top', offset: [0, sel ? -38 : -9], className: 'pin-label', permanent: sel });
      m.on('click', () => { detailFromList = false; selectPlace(p.id); });
      m.addTo(markerLayer);
      markers[p.id] = m;
    });
  }

  $('zoomIn')?.addEventListener('click', () => map.zoomIn());
  $('zoomOut')?.addEventListener('click', () => map.zoomOut());

  // ---------- Panel de computadora ----------
  const panel = $('panel');
  function setPanelOpen(open: boolean) {
    document.body.classList.toggle('panel-open', open);
    updateClearBtn();
  }

  // ---------- Hoja del celular: asomada, mitad o completa ----------
  type Sheet = 'peek' | 'half' | 'full';
  const PEEK = 116;
  const sheetHeights = () => {
    const h = window.innerHeight;
    return { peek: PEEK, half: Math.round(h * 0.5), full: h - 72 };
  };
  let sheet: Sheet = 'peek';
  function setSheet(s: Sheet) {
    sheet = s;
    panel.dataset.sheet = s;
    const px = sheetHeights()[s];
    document.documentElement.style.setProperty('--sheet-h', `${px}px`);
    document.body.classList.toggle('sheet-full', s === 'full');
    document.body.classList.toggle('panel-open', s !== 'peek');
    $('sheetToggle').setAttribute('aria-expanded', String(s !== 'peek'));
    $('sheetToggleLabel').textContent = s === 'peek' ? 'Ver la lista' : 'Bajar la lista';
    updateClearBtn();
  }

  // Arrastrar la hoja con el dedo y soltarla en la altura más cercana.
  (() => {
    const head = $('sheetHead');
    let startY = 0, startH = 0, moved = false, dragging = false;
    head.addEventListener('pointerdown', (e: PointerEvent) => {
      if (!isMobile()) return;
      dragging = true; moved = false;
      startY = e.clientY; startH = panel.getBoundingClientRect().height;
      panel.classList.add('is-dragging');
      head.setPointerCapture(e.pointerId);
    });
    head.addEventListener('pointermove', (e: PointerEvent) => {
      if (!dragging) return;
      const dy = startY - e.clientY;
      if (Math.abs(dy) > 6) moved = true;
      const hs = sheetHeights();
      const h = Math.max(hs.peek, Math.min(hs.full, startH + dy));
      document.documentElement.style.setProperty('--sheet-h', `${h}px`);
    });
    const end = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      panel.classList.remove('is-dragging');
      if (!moved) {
        setSheet(sheet === 'peek' ? 'half' : 'peek');
        return;
      }
      const h = panel.getBoundingClientRect().height;
      const hs = sheetHeights();
      const velocityUp = startY - e.clientY;
      const order: Sheet[] = ['peek', 'half', 'full'];
      let best: Sheet = order.reduce((a, b) => (Math.abs(hs[b] - h) < Math.abs(hs[a] - h) ? b : a), 'peek' as Sheet);
      if (best === sheet && Math.abs(velocityUp) > 40) {
        const i = order.indexOf(sheet) + (velocityUp > 0 ? 1 : -1);
        best = order[Math.max(0, Math.min(2, i))];
      }
      setSheet(best);
    };
    head.addEventListener('pointerup', end);
    head.addEventListener('pointercancel', end);
    $('sheetToggle').addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setSheet(sheet === 'peek' ? 'half' : 'peek'); }
    });
  })();

  function openList() {
    if (selectedId || selectedBizId) closeDetail(true);
    if (isMobile()) setSheet(sheet === 'peek' ? 'half' : sheet);
    else setPanelOpen(true);
    hideHint();
  }
  function closeAll() {
    if (selectedId || selectedBizId) closeDetail(true);
    if (isMobile()) setSheet('peek');
    else setPanelOpen(false);
  }
  $('listBtn')?.addEventListener('click', openList);
  $('closeList')?.addEventListener('click', closeAll);

  function updateClearBtn() {
    const show = !!currentQuery || !!selectedId || !!selectedBizId || (!isMobile() && document.body.classList.contains('panel-open'));
    $('clearBtn').hidden = !show;
    $('searchIcon').hidden = show;
  }
  $('clearBtn').addEventListener('click', () => {
    if (currentQuery) {
      currentQuery = '';
      $('searchInput').value = '';
      applyFilters();
    }
    closeAll();
  });

  function hideHint() { $('hint')?.classList.add('is-gone'); }

  // ---------- Utilidades ----------
  function distanceKm(a: [number, number], b: [number, number]) {
    const R = 6371, toRad = (d: number) => (d * Math.PI) / 180;
    const dLat = toRad(b[0] - a[0]), dLng = toRad(b[1] - a[1]);
    const h = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(a[0])) * Math.cos(toRad(b[0])) * Math.sin(dLng / 2) ** 2;
    return 2 * R * Math.asin(Math.sqrt(h));
  }
  const fmtKm = (km: number) => (km < 10 ? `${km.toFixed(1)} km` : `${Math.round(km)} km`);
  const placeMeta = (p: Place) => [p.municipality, p.department].filter(Boolean).filter((v, i, a) => a.indexOf(v) === i).join(', ');

  function ratingOf(id: string) {
    const list = reviewsByPlace[id] || [];
    if (!list.length) return null;
    return { avg: list.reduce((s, r) => s + num(r.rating), 0) / list.length, count: list.length };
  }
  const starSvg = '<svg class="star" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3l2.7 5.6 6.2.9-4.5 4.4 1 6.1L12 17.1 6.6 20l1-6.1L3.1 9.5l6.2-.9z"></path></svg>';

  // ---------- Lista ----------
  function applyFilters() {
    const q = normalize(currentQuery.trim());
    filtered = allPlaces.filter((p) => {
      if (currentCategory !== 'all' && p.category !== currentCategory) return false;
      if (!q) return true;
      return [p.name, p.department, p.municipality, CATEGORY_NAMES[p.category], p.category].some((v) => normalize(v).includes(q));
    });
    if (userPos) {
      filtered.sort((a, b) => distanceKm(userPos!, [a.lat, a.lng]) - distanceKm(userPos!, [b.lat, b.lng]));
    }
    renderList();
    renderMarkers();
    updateClearBtn();
  }

  function renderList() {
    // Sin búsqueda, la lista muestra lo que se ve en el mapa (como en un mapa de calles).
    const zone = !currentQuery.trim() && map.getZoom() >= ZONE_ZOOM;
    const view = map.getBounds().pad(0.05);
    const shown = zone ? filtered.filter((p) => view.contains([p.lat, p.lng])) : filtered;
    const n = shown.length;
    const lugares = `${n} ${n === 1 ? 'lugar' : 'lugares'}`;
    $('resultCount').textContent = userPos
      ? `Lo más chulo de aquí, cerquita: ${lugares}, del más cercano al más lejano`
      : zone ? `${lugares} en esta zona` : `${lugares} en el mapa`;
    $('peekTitle').textContent = userPos ? `${lugares} cerca de vos` : `${lugares} para conocer`;
    $('listBtnLabel').textContent = `Ver lista · ${lugares}`;
    $('emptyState').hidden = n > 0;
    $('emptyState').textContent = zone && filtered.length ? 'No hay lugares en esta parte del mapa. Alejate un poco o movete a otra zona.' : 'Ningún lugar coincide. Probá con otra palabra o tocá “Todo”.';
    $('placesList').innerHTML = shown.map((p) => {
      const photo = coverOf(p).url;
      const r = ratingOf(p.id);
      const extra = userPos ? fmtKm(distanceKm(userPos, [p.lat, p.lng])) : (r ? `${starSvg}${r.avg.toFixed(1)}` : '');
      return `<li><button type="button" class="place-row" data-id="${esc(p.id)}">
        ${photo ? `<img class="place-thumb" src="${photo}" alt="" loading="lazy">` : `<span class="place-thumb thumb-icon" aria-hidden="true">${catIcon(p.category)}</span>`}
        <span style="min-width:0">
          <p class="place-name">${esc(p.name)}</p>
          <p class="place-meta">${esc(CATEGORY_NAMES[p.category] || 'Lugar')}${placeMeta(p) ? ` · ${esc(placeMeta(p))}` : ''}</p>
        </span>
        ${extra ? `<span class="place-rating">${extra}</span>` : ''}
      </button></li>`;
    }).join('');
  }

  $('placesList').addEventListener('click', (e: Event) => {
    const row = (e.target as HTMLElement).closest('.place-row') as HTMLElement | null;
    if (row?.dataset.id) { detailFromList = true; selectPlace(row.dataset.id); }
  });

  // ---------- Ficha ----------
  // Centra el lugar en la parte del mapa que queda libre (a la derecha del panel o arriba de la hoja).
  function flyToPlace(p: Place, minZoom = 13) {
    const zoom = Math.max(map.getZoom(), minZoom);
    let pt = map.project(L.latLng(p.lat, p.lng), zoom);
    if (isMobile()) {
      const h = window.innerHeight;
      const top = 130, bottom = h - sheetHeights().half;
      pt = pt.add([0, h / 2 - (top + bottom) / 2]);
    } else {
      pt = pt.subtract([204, 0]);
    }
    map.flyTo(map.unproject(pt, zoom), zoom, { duration: 0.8 });
  }

  async function bumpVisit(id: string) {
    try { await updateDoc(doc(db, 'places', id), { visitCount: increment(1) }); } catch { /* sin conexión o sin permiso: no es grave */ }
  }

  function selectPlace(id: string, opts: { fly?: boolean; count?: boolean } = {}) {
    if (id !== selectedId) detailSub = null;
    const p = allPlaces.find((x) => x.id === id);
    if (!p) return;
    selectedId = id;
    selectedBizId = null; bizFromPlace = null;
    renderMarkers(); renderBizMarkers(); updateBizLayer();
    renderDetail(p);
    if (isMobile()) setSheet('half');
    else setPanelOpen(true);
    if (opts.fly !== false) flyToPlace(p);
    if (opts.count !== false) bumpVisit(id);
    history.replaceState(null, '', `#${encodeURIComponent(id)}`);
    hideHint();
    updateClearBtn();
  }

  // keepPanel: deja el panel como está (lo usa quien cierra o abre todo después).
  function closeDetail(keepPanel = false) {
    detailSub = null;
    selectedId = null;
    if (selectedBizId) { selectedBizId = null; bizFromPlace = null; renderBizMarkers(); updateBizLayer(); }
    $('detailView').hidden = true;
    $('listView').hidden = false;
    history.replaceState(null, '', location.pathname);
    renderMarkers();
    $('panelBody').scrollTop = 0;
    if (!keepPanel && !detailFromList) {
      if (isMobile()) setSheet('peek'); else setPanelOpen(false);
    }
    updateClearBtn();
  }

  const icoCheck = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>';
  const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
  function fmtDate(iso: string) {
    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(iso || '');
    return m ? `${Number(m[3])} de ${MESES[Number(m[2]) - 1]} de ${m[1]}` : iso;
  }
  const icoPin = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0114 0c0 4.8-7 11-7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>';
  const icoPhone = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z"></path></svg>';
  const icoClock = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>';
  const icoTicket = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8a2 2 0 002-2h14a2 2 0 002 2v2a2 2 0 000 4v2a2 2 0 00-2 2H5a2 2 0 00-2-2v-2a2 2 0 000-4z"></path></svg>';
  const icoLink = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M10 14a5 5 0 007 0l3-3a5 5 0 00-7-7l-1 1M14 10a5 5 0 00-7 0l-3 3a5 5 0 007 7l1-1"></path></svg>';

  // Perfil público de quien publicó algo.
  const profileHref = (uid: string) => `/perfil?u=${encodeURIComponent(uid)}`;

  // ---------- Visor de fotos ----------
  // photoId: foto de la comunidad (se puede votar). userId: se muestra quién la subió con enlace a su perfil.
  interface LbItem { url: string; cap?: string; photoId?: string; userId?: string; userName?: string; userPhoto?: string }
  let lbItems: LbItem[] = [];
  let lbIndex = 0;
  const lb = $('lightbox') as HTMLDialogElement;
  const lbPhoto = (it: LbItem) => (it.photoId ? Object.values(photosByPlace).flat().find((x) => x.id === it.photoId) : undefined);
  function lbShow(i: number) {
    if (!lbItems.length) return;
    lbIndex = Math.max(0, Math.min(lbItems.length - 1, i));
    const it = lbItems[lbIndex];
    const img = $('lbImg') as HTMLImageElement;
    if (img.getAttribute('src') !== it.url) {
      img.classList.add('is-loading');
      img.onload = () => img.classList.remove('is-loading');
      img.src = it.url;
    }
    img.alt = it.userName ? `Foto de ${it.userName}` : (it.cap || 'Foto');
    $('lbCount').textContent = lbItems.length > 1 ? `${lbIndex + 1} de ${lbItems.length}` : '';
    // Quién la subió: enlace a su perfil.
    const who = $('lbWho') as HTMLAnchorElement;
    who.hidden = !it.userId;
    if (it.userId) {
      const name = it.userName || 'Visitante';
      who.href = profileHref(it.userId);
      who.setAttribute('aria-label', `Foto de ${name}. Ver su perfil`);
      $('lbName').textContent = name;
      const pic = safeUrl(it.userPhoto || '');
      $('lbAvatar').innerHTML = pic ? `<img src="${pic}" alt="" referrerpolicy="no-referrer">` : esc(name.charAt(0).toUpperCase());
    }
    $('lbCap').textContent = it.userId ? '' : (it.cap || '');
    // Votar y reportar: solo las fotos de la comunidad.
    const ph = lbPhoto(it);
    const rep = $('lbReport') as HTMLButtonElement;
    rep.hidden = !ph || ph.userId === currentUser?.uid;
    if (ph) {
      const done = reportedIds.has(`photo_${ph.id}`);
      rep.classList.toggle('is-done', done);
      rep.setAttribute('aria-label', done ? 'Ya reportaste esta foto' : 'Reportar esta foto');
      rep.title = done ? 'Ya reportaste esta foto' : 'Reportar esta foto';
    }
    const vote = $('lbVote') as HTMLButtonElement;
    vote.hidden = !ph;
    if (ph) {
      const voted = votedPhotos.has(ph.id);
      const n = num(ph.votes);
      vote.classList.toggle('is-voted', voted);
      vote.setAttribute('aria-pressed', String(voted));
      vote.disabled = voted;
      $('lbVoteTxt').textContent = voted ? `Votaste · ${n}` : (n ? `Votar · ${n}` : 'Votar');
      vote.setAttribute('aria-label', voted ? `Ya votaste por esta foto. ${n} ${n === 1 ? 'voto' : 'votos'}` : `Votar por esta foto. ${n} ${n === 1 ? 'voto' : 'votos'}`);
    }
    ($('lbPrev') as HTMLButtonElement).disabled = lbIndex === 0;
    ($('lbNext') as HTMLButtonElement).disabled = lbIndex === lbItems.length - 1;
    $('lbPrev').hidden = $('lbNext').hidden = lbItems.length < 2;
    // Precarga las vecinas para que pasar sea inmediato.
    [lbIndex - 1, lbIndex + 1].forEach((k) => { if (lbItems[k]) new Image().src = lbItems[k].url; });
  }
  function openLightbox(items: LbItem[], i: number) {
    if (!items.length) return;
    lbItems = items;
    if (!lb.open) lb.showModal();
    lbShow(i);
    ($('lbClose') as HTMLElement).focus({ preventScroll: true });
  }
  $('lbReport').addEventListener('click', () => {
    const ph = lbPhoto(lbItems[lbIndex]);
    if (ph) openReport('photo', ph.id, ph.placeId);
  });
  $('lbVote').addEventListener('click', async () => {
    const it = lbItems[lbIndex];
    if (!it?.photoId) return;
    const vote = $('lbVote') as HTMLButtonElement;
    vote.disabled = true;
    await votePhoto(it.photoId);
    if (lb.open) lbShow(lbIndex);
  });
  $('lbClose').addEventListener('click', () => lb.close());
  $('lbPrev').addEventListener('click', () => lbShow(lbIndex - 1));
  $('lbNext').addEventListener('click', () => lbShow(lbIndex + 1));
  lb.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'ArrowLeft') { e.preventDefault(); lbShow(lbIndex - 1); }
    if (e.key === 'ArrowRight') { e.preventDefault(); lbShow(lbIndex + 1); }
  });
  // Tocar el fondo (fuera de la foto) cierra.
  $('lbStage').addEventListener('click', (e: Event) => { if (e.target === $('lbStage')) lb.close(); });
  // Deslizar en el celular.
  let lbX = 0, lbY = 0;
  $('lbStage').addEventListener('pointerdown', (e: PointerEvent) => { lbX = e.clientX; lbY = e.clientY; });
  $('lbStage').addEventListener('pointerup', (e: PointerEvent) => {
    const dx = e.clientX - lbX, dy = e.clientY - lbY;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) lbShow(lbIndex + (dx < 0 ? 1 : -1));
  });
  // Cualquier foto de la ficha abre el visor en vez de descargarse.
  const communityItems = (placeId: string): LbItem[] => (photosByPlace[placeId] || []).map((ph) => ({
    url: safeUrl(ph.url), photoId: ph.id, userId: ph.userId, userName: ph.userName, userPhoto: ph.userPhoto,
  }));
  $('detailView').addEventListener('click', (e: Event) => {
    const t = e.target as HTMLElement;
    const a = t.closest('a[data-lb]') as HTMLAnchorElement | null;
    if (a) {
      e.preventDefault();
      const i = Number(a.dataset.i) || 0;
      if (a.dataset.lb === 'ph' && selectedId) return openLightbox(communityItems(selectedId), i);
      const group = a.closest('[data-lb-group]') as HTMLElement | null;
      const g = group?.dataset || {};
      const items = [...(group?.querySelectorAll('a[data-lb]') || [a])].map((x) => ({
        url: (x as HTMLAnchorElement).href, cap: (x as HTMLElement).dataset.cap || '',
        userId: g.uid || undefined, userName: g.uname || undefined, userPhoto: g.upic || undefined,
      }));
      return openLightbox(items, i);
    }
    if (t.matches('[data-lb-cover]') && selectedId) {
      const p = allPlaces.find((x) => x.id === selectedId);
      const items = communityItems(selectedId);
      if (items.length) return openLightbox(items, 0);
      if (p) openLightbox((p.photos || []).map((u) => ({ url: safeUrl(u), cap: p.name })).filter((x) => x.url), 0);
    }
  });
  $('detailView').addEventListener('keydown', (e: KeyboardEvent) => {
    if ((e.target as HTMLElement).matches('[data-lb-cover]') && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); (e.target as HTMLElement).click(); }
  });

  // ---------- Fotos y reseñas: vista previa en la ficha y vista completa ----------
  let detailSub: null | 'photos' | 'reviews' = null;
  let reviewSort: 'recent' | 'best' | 'worst' | 'photos' | 'verified' = 'recent';
  const PREVIEW_PHOTOS = 6;
  const starsTxt = (n: number) => '★'.repeat(Math.max(0, Math.min(5, Math.round(n)))) + '☆'.repeat(5 - Math.max(0, Math.min(5, Math.round(n))));
  const reviewsOf = (id: string) => [...(reviewsByPlace[id] || [])].sort((a, b) => (b.createdAt?.toMillis?.() ?? 0) - (a.createdAt?.toMillis?.() ?? 0));

  function photoCell(ph: CPhoto, i: number, more = 0) {
    const voted = votedPhotos.has(ph.id);
    if (more) return `<button type="button" class="photo-cell photo-more" data-see="photos" aria-label="Ver las ${more} fotos más">
      <img src="${safeUrl(ph.url)}" alt="" loading="lazy"><span>+${more}</span></button>`;
    return `<div class="photo-cell">
      <a href="${safeUrl(ph.url)}" data-lb="ph" data-i="${i}"><img src="${safeUrl(ph.url)}" alt="Foto de ${esc(ph.userName || 'un visitante')}" loading="lazy"></a>
      ${i === 0 && num(ph.votes) > 0 ? '<span class="photo-badge">Portada</span>' : ''}
      <button type="button" class="vote-btn${voted ? ' is-voted' : ''}" data-vote="${esc(ph.id)}" aria-pressed="${voted}" aria-label="${voted ? 'Ya votaste por esta foto' : 'Votar por esta foto'}, ${num(ph.votes)} votos">
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.5-9.3C1.2 8.4 3.3 5 6.8 5c2 0 3.5 1.1 5.2 3 1.7-1.9 3.2-3 5.2-3 3.5 0 5.6 3.4 4.3 6.7C19.5 16.4 12 21 12 21z"></path></svg>
        ${num(ph.votes)}
      </button>
    </div>`;
  }
  // En la ficha: hasta 6; si hay más, la sexta muestra cuántas faltan y abre la galería.
  function photoGridPreview(p: Place, list: CPhoto[]) {
    const extra = list.length - PREVIEW_PHOTOS;
    const cells = extra > 0
      ? [...list.slice(0, PREVIEW_PHOTOS - 1).map((ph, i) => photoCell(ph, i)), photoCell(list[PREVIEW_PHOTOS - 1], PREVIEW_PHOTOS - 1, extra + 1)]
      : list.map((ph, i) => photoCell(ph, i));
    return `<div class="photo-grid">${cells.join('')}</div>
      ${extra > 0 ? `<button type="button" class="link-btn" data-see="photos">Ver las ${list.length} fotos</button>` : ''}`;
  }
  function reviewItem(rv: Review) {
    const rp = (rv.photos || []).map((u) => safeUrl(u)).filter(Boolean).slice(0, 4);
    return `<div class="review">
      <div class="review-head">
        ${rv.userId ? `<a class="review-who is-link" href="${profileHref(rv.userId)}" title="Ver el perfil de ${esc(rv.userName || 'Visitante')}">` : '<span class="review-who">'}${safeUrl(rv.userPhoto) ? `<img class="review-avatar" src="${safeUrl(rv.userPhoto)}" alt="" referrerpolicy="no-referrer">` : `<span class="review-avatar" aria-hidden="true">${esc((rv.userName || 'V').charAt(0).toUpperCase())}</span>`}<strong>${esc(rv.userName || 'Visitante')}</strong>${rv.userId ? '</a>' : '</span>'}
        <span class="star" aria-label="${num(rv.rating)} de 5">${starsTxt(num(rv.rating))}</span>
      </div>
      <p class="review-date">${rv.verified ? `<span class="verified">${icoCheck} Visita verificada</span>${rv.visitDate ? ' · ' : ''}` : ''}${rv.visitDate ? `Fue el ${esc(fmtDate(rv.visitDate))}` : ''}</p>
      ${rv.comment ? `<p class="review-text">${esc(rv.comment)}</p>` : ''}
      ${rv.id && rv.userId !== currentUser?.uid ? `<button type="button" class="report-link" data-report="review" data-target="${esc(rv.id)}" data-place="${esc(rv.placeId)}">${reportedIds.has(`review_${rv.id}`) ? 'Reportada' : 'Reportar'}</button>` : ''}
      ${rp.length ? `<div class="review-photos" data-lb-group data-uid="${esc(rv.userId || '')}" data-uname="${esc(rv.userName || 'Visitante')}" data-upic="${esc(safeUrl(rv.userPhoto || ''))}">${rp.map((u, k) => `<a href="${u}" data-lb="grp" data-i="${k}" data-cap="Foto de ${esc(rv.userName || 'un visitante')}"><img src="${u}" alt="Foto de ${esc(rv.userName || 'un visitante')}" loading="lazy"></a>`).join('')}</div>` : ''}
    </div>`;
  }
  // Promedio grande y cuántas reseñas hay de cada estrella.
  function ratingSummary(list: Review[]) {
    const avg = list.reduce((a, r) => a + num(r.rating), 0) / list.length;
    const count = (n: number) => list.filter((r) => Math.round(num(r.rating)) === n).length;
    return `<div class="rating-summary">
      <div class="rs-avg"><strong>${avg.toFixed(1)}</strong><span class="star" aria-hidden="true">${starsTxt(avg)}</span><span class="rs-count">${list.length} ${list.length === 1 ? 'reseña' : 'reseñas'}</span></div>
      <ul class="rs-bars" aria-label="Reseñas por estrellas">${[5, 4, 3, 2, 1].map((n) => {
        const c = count(n);
        return `<li><span class="rs-n">${n}</span><span class="rs-bar"><span style="width:${list.length ? Math.round((c / list.length) * 100) : 0}%"></span></span><span class="rs-c">${c}</span></li>`;
      }).join('')}</ul>
    </div>`;
  }
  const SORTS: [typeof reviewSort, string][] = [['recent', 'Más recientes'], ['best', 'Mejor calificadas'], ['worst', 'Más bajas'], ['photos', 'Con fotos'], ['verified', 'Verificadas']];
  function sortedReviews(list: Review[]) {
    const ms2 = (r: Review) => r.createdAt?.toMillis?.() ?? 0;
    if (reviewSort === 'best') return [...list].sort((a, b) => num(b.rating) - num(a.rating) || ms2(b) - ms2(a));
    if (reviewSort === 'worst') return [...list].sort((a, b) => num(a.rating) - num(b.rating) || ms2(b) - ms2(a));
    if (reviewSort === 'photos') return list.filter((r) => (r.photos || []).length);
    if (reviewSort === 'verified') return list.filter((r) => r.verified);
    return list;
  }
  // Vista completa dentro del mismo panel, con "Volver" a la ficha.
  function renderDetailAll(p: Place) {
    const back = `<button type="button" class="back-btn" id="subBack">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
        Volver a ${esc(p.name)}</button>`;
    if (detailSub === 'photos') {
      const list = photosByPlace[p.id] || [];
      $('detailView').innerHTML = `${back}
        <div class="sub-head"><h2 class="detail-title sub-title" tabindex="-1" id="detailTitle">Fotos de ${esc(p.name)}</h2>
          <button type="button" class="btn btn-outline btn-sm" data-addphoto="${esc(p.id)}">Subir foto</button></div>
        <p class="section-help">${list.length} ${list.length === 1 ? 'foto' : 'fotos'}. Votá por tu favorita: la más votada queda de portada.</p>
        <input type="file" id="placePhotoInput" accept="image/*" class="sr-only" aria-label="Elegir foto para subir">
        <p id="photoStatus" class="field-help" aria-live="polite"></p>
        <div class="photo-grid">${list.map((ph, i) => photoCell(ph, i)).join('')}</div>`;
    } else {
      const all = reviewsOf(p.id);
      const shown = sortedReviews(all);
      $('detailView').innerHTML = `${back}
        <div class="sub-head"><h2 class="detail-title sub-title" tabindex="-1" id="detailTitle">Reseñas de ${esc(p.name)}</h2>
          <button type="button" class="btn btn-outline btn-sm" data-review="${esc(p.id)}">Escribir reseña</button></div>
        ${all.length ? ratingSummary(all) : ''}
        <div class="sort-chips" role="group" aria-label="Ordenar reseñas">${SORTS.map(([k, l]) => `<button type="button" class="sort-chip" data-sort="${k}" aria-pressed="${reviewSort === k}">${l}</button>`).join('')}</div>
        ${shown.length ? shown.map(reviewItem).join('') : '<p class="empty">No hay reseñas con ese filtro.</p>'}`;
      $('detailView').querySelectorAll('[data-sort]').forEach((b: HTMLElement) => b.addEventListener('click', () => { reviewSort = b.dataset.sort as any; renderDetail(p); }));
    }
    $('listView').hidden = true;
    $('detailView').hidden = false;
    $('subBack').addEventListener('click', () => { detailSub = null; renderDetail(p); $('panelBody').scrollTop = 0; });
    $('detailView').querySelectorAll('[data-review]').forEach((b: HTMLElement) => b.addEventListener('click', () => openReview(b.dataset.review!)));
    $('detailView').querySelectorAll('[data-vote]').forEach((b: HTMLElement) => b.addEventListener('click', () => votePhoto(b.dataset.vote!)));
    $('detailView').querySelectorAll('[data-addphoto]').forEach((b) => b.addEventListener('click', async () => {
      if (!(await readyToPost())) return;
      $('placePhotoInput').click();
    }));
    $('placePhotoInput')?.addEventListener('change', (e: Event) => uploadPlacePhoto(p, e.target as HTMLInputElement));
  }

  function renderDetail(p: Place) {
    if (detailSub) { renderDetailAll(p); return; }
    const photos = (p.photos || []).map((u) => safeUrl(u)).filter(Boolean);
    const cover = coverOf(p);
    const community = photosByPlace[p.id] || [];
    const r = ratingOf(p.id);
    const reviews = reviewsOf(p.id);
    const near = allPlaces
      .filter((x) => x.id !== p.id)
      .map((x) => ({ x, d: distanceKm([p.lat, p.lng], [x.lat, x.lng]) }))
      .sort((a, b) => a.d - b.d)
      .slice(0, 3);
    const directions = `https://www.google.com/maps/dir/?api=1&destination=${num(p.lat)},${num(p.lng)}`;

    $('detailView').innerHTML = `
      ${detailFromList ? `<button type="button" class="back-btn" id="backBtn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
        Volver a la lista
      </button>` : ''}
      ${cover.url ? `<figure class="cover"><img class="detail-photo" src="${cover.url}" alt="Foto de ${esc(p.name)}" data-lb-cover role="button" tabindex="0" style="cursor:zoom-in">${cover.photo ? `<figcaption class="cover-credit">Portada de ${cover.photo.userId ? `<a href="${profileHref(cover.photo.userId)}">${esc(cover.photo.userName || 'un visitante')}</a>` : esc(cover.photo.userName || 'un visitante')} · ${num(cover.photo.votes)} ${num(cover.photo.votes) === 1 ? 'voto' : 'votos'}</figcaption>` : ''}</figure>` : `<div class="detail-photo photo-empty" aria-hidden="true">${catIcon(p.category, 40)}</div>`}
      <h2 class="detail-title" tabindex="-1" id="detailTitle">${esc(p.name)}</h2>
      <p class="detail-kicker">${esc(CATEGORY_NAMES[p.category] || 'Lugar')}${placeMeta(p) ? ` · ${esc(placeMeta(p))}` : ''}</p>
      ${r
        ? `<p class="rating-line">${starSvg}<span><strong>${r.avg.toFixed(1)}</strong> de 5, ${r.count} ${r.count === 1 ? 'reseña' : 'reseñas'}</span></p>`
        : '<p class="rating-line is-empty">Sin reseñas todavía</p>'}
      <div class="detail-actions">
        <a class="btn btn-primary" href="${directions}" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l18-8-8 18-2-8z"></path></svg>
          Cómo llegar</a>
        <button type="button" class="btn btn-outline" data-review="${esc(p.id)}">Escribir reseña</button>
        <button type="button" class="btn btn-outline btn-icon" data-share="${esc(p.id)}" aria-label="Compartir ${esc(p.name)}" title="Compartir">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="2.5"></circle><circle cx="6" cy="12" r="2.5"></circle><circle cx="18" cy="19" r="2.5"></circle><path d="M8.2 10.8l7.6-4.4M8.2 13.2l7.6 4.4"></path></svg>
        </button>
      </div>
      <p id="shareStatus" class="share-status" role="status"></p>
      ${p.description ? `<p class="detail-desc">${esc(p.description)}</p>` : ''}
      <ul class="detail-facts">
        ${specific(p.schedule) ? `<li>${icoClock}<span>${esc(p.schedule!)}</span></li>` : ''}
        ${specific(p.price) ? `<li>${icoTicket}<span>${esc(priceText(p.price!.trim()))}</span></li>` : ''}
        ${/^https?:\/\//i.test(p.website || '') && safeUrl(p.website) ? `<li>${icoLink}<a href="${safeUrl(p.website)}" target="_blank" rel="noopener" style="color:var(--link)">Sitio web</a></li>` : ''}
      </ul>
      ${p.recommendations?.length ? `<div class="tags">${p.recommendations.map((t) => `<span class="tag">${esc(t)}</span>`).join('')}</div>` : ''}

      <div class="section-head">
        <h3 class="section-title">Fotos de quienes fueron</h3>
        ${community.length ? `<button type="button" class="btn btn-outline btn-sm" data-addphoto="${esc(p.id)}">Subir foto</button>` : ''}
      </div>
      ${community.length ? '<p class="section-help">Votá por tu favorita: la más votada queda de portada.</p>' : ''}
      <input type="file" id="placePhotoInput" accept="image/*" class="sr-only" aria-label="Elegir foto para subir">
      <p id="photoStatus" class="field-help" aria-live="polite"></p>
      ${community.length ? photoGridPreview(p, community) : `<div class="empty-card">
        <p>Nadie ha subido fotos de aquí todavía.</p>
        <button type="button" class="btn btn-primary btn-sm" data-addphoto="${esc(p.id)}">Subí la primera</button>
      </div>`}
      ${photos.length > 1 ? `<div class="gallery" data-lb-group>${photos.slice(1, 7).map((u, k) => `<a href="${u}" data-lb="grp" data-i="${k}"><img src="${u}" alt="" loading="lazy"></a>`).join('')}</div>` : ''}

      ${(() => {
        const nb = nearbyBusinesses(p);
        return nb.length ? `<h3 class="section-title">Para comer y dormir cerca</h3>
          <ul class="biz-list">${nb.map(({ b, d }) => `<li><button type="button" class="biz-row" data-biz="${esc(b.id)}">
            ${safeUrl(b.coverUrl || b.photos?.[0]) ? `<img class="place-thumb" src="${safeUrl(b.coverUrl || b.photos?.[0])}" alt="" loading="lazy">` : `<span class="place-thumb biz-thumb" aria-hidden="true">${bizIcon(b.category, 22)}</span>`}
            <span style="min-width:0">
              <span class="biz-name">${esc(b.name)}${isFeatured(b) ? ' <span class="tag-featured">Destacado</span>' : ''}</span>
              <span class="place-meta">${esc(BIZ_NAMES[b.category] || 'Negocio')} · a ${fmtKm(d)}</span>
              ${b.promoToday ? `<span class="biz-promo">Hoy: ${esc(b.promoToday.replace(/^\s*hoy\s*[:,-]?\s*/i, ''))}</span>` : ''}
            </span>
          </button></li>`).join('')}</ul>` : '';
      })()}

      <h3 class="section-title">Reseñas</h3>
      ${reviews.length ? `${reviews.length >= 3 ? ratingSummary(reviews) : ''}
        ${reviews.slice(0, 3).map(reviewItem).join('')}
        ${reviews.length > 3 ? `<button type="button" class="btn btn-outline see-all" data-see="reviews">Ver las ${reviews.length} reseñas</button>` : ''}` : `<div class="empty-card">
        <p>Contá cómo te fue y ayudale a quien va por primera vez.</p>
        <button type="button" class="btn btn-primary btn-sm" data-review="${esc(p.id)}">Escribí la primera reseña</button>
      </div>`}

      ${near.length ? `<h3 class="section-title">Cerca de aquí</h3><ul class="near-list">${near.map(({ x, d }) => { const ph = coverOf(x).url; return `<li><button type="button" class="near-row" data-id="${esc(x.id)}">
          ${ph ? `<img class="place-thumb" src="${ph}" alt="" loading="lazy">` : `<span class="place-thumb thumb-icon" aria-hidden="true">${catIcon(x.category)}</span>`}
          <span class="near-text"><span class="near-name">${esc(x.name)}</span><span class="place-meta">${esc(CATEGORY_NAMES[x.category] || 'Lugar')}</span></span>
          <span class="near-km">${fmtKm(d)}</span>
        </button></li>`; }).join('')}</ul>` : ''}
    `;
    $('listView').hidden = true;
    $('detailView').hidden = false;
    $('panelBody').scrollTop = 0;
    $('backBtn')?.addEventListener('click', () => { closeDetail(true); });
    $('detailView').querySelectorAll('[data-review]').forEach((b: HTMLElement) => b.addEventListener('click', () => openReview(b.dataset.review!)));
    $('detailView').querySelectorAll('[data-biz]').forEach((b: HTMLElement) => b.addEventListener('click', () => selectBusiness(b.dataset.biz!, p.id)));
    $('detailView').querySelectorAll('[data-vote]').forEach((b: HTMLElement) => b.addEventListener('click', () => votePhoto(b.dataset.vote!)));
    $('detailView').querySelectorAll('[data-addphoto], [data-first-photo]').forEach((b) => b.addEventListener('click', async () => {
      if (!(await readyToPost())) return;
      $('placePhotoInput').click();
    }));
    $('placePhotoInput')?.addEventListener('change', (e: Event) => uploadPlacePhoto(p, e.target as HTMLInputElement));
    $('detailView').querySelectorAll('.near-row').forEach((b: HTMLElement) => b.addEventListener('click', () => selectPlace(b.dataset.id!)));
    $('detailView').querySelectorAll('[data-see]').forEach((b: HTMLElement) => b.addEventListener('click', () => {
      detailSub = b.dataset.see as any; reviewSort = 'recent'; renderDetail(p);
      $('panelBody').scrollTop = 0; ($('detailTitle') as HTMLElement)?.focus({ preventScroll: true });
    }));
    if (!isMobile()) ($('detailTitle') as HTMLElement).focus({ preventScroll: true });
  }

  // ---------- Cuenta (Google) ----------
  let currentUser: any = null;
  const personSvg = $('accountAvatar').innerHTML;

  async function login() {
    try {
      await signInWithPopup(auth, googleProvider);
      return true;
    } catch (err: any) {
      if (err?.code !== 'auth/popup-closed-by-user' && err?.code !== 'auth/cancelled-popup-request') console.error(err);
      return false;
    }
  }

  // ---------- Aceptar privacidad (una vez por versión de la política) ----------
  // La ley pide consentimiento expreso, también para guardar datos fuera de El Salvador.
  // Queda en users/{uid}.privacy con la versión y la fecha.
  let consentFor = '';
  async function ensureConsent(): Promise<boolean> {
    if (!currentUser) return false;
    if (consentFor === currentUser.uid) return true;
    try {
      const snap = await getDoc(doc(db, 'users', currentUser.uid));
      if (snap.exists() && snap.data()?.privacy?.version === LEGAL.updated) { consentFor = currentUser.uid; return true; }
    } catch { /* si no se puede leer, se pregunta */ }
    const dlg = $('consentDialog') as HTMLDialogElement;
    ($('consentForm') as HTMLFormElement).reset();
    $('consentError').hidden = true;
    dlg.showModal();
    return new Promise<boolean>((resolve) => {
      const done = (ok: boolean) => { cleanup(); if (dlg.open) dlg.close(); resolve(ok); };
      const onSubmit = async (e: Event) => {
        e.preventDefault();
        const boxes = [...dlg.querySelectorAll('[data-consent]')] as HTMLInputElement[];
        const missing = boxes.find((b) => !b.checked);
        if (missing) { $('consentError').textContent = 'Para publicar tenés que marcar las tres casillas.'; $('consentError').hidden = false; missing.focus(); return; }
        ($('consentOk') as HTMLButtonElement).disabled = true;
        try {
          await setDoc(doc(db, 'users', currentUser.uid), {
            privacy: { version: LEGAL.updated, acceptedAt: serverTimestamp(), transfers: true, ageOk: true },
          }, { merge: true });
          consentFor = currentUser.uid;
          done(true);
        } catch (err) {
          console.error(err);
          $('consentError').textContent = 'No se pudo guardar. Revisá tu conexión y probá otra vez.'; $('consentError').hidden = false;
        } finally { ($('consentOk') as HTMLButtonElement).disabled = false; }
      };
      const onCancel = () => done(false);
      const onClose = () => { cleanup(); resolve(consentFor === currentUser?.uid); };
      const cleanup = () => {
        $('consentForm').removeEventListener('submit', onSubmit);
        $('consentCancel').removeEventListener('click', onCancel);
        $('consentClose').removeEventListener('click', onCancel);
        dlg.removeEventListener('close', onClose);
      };
      $('consentForm').addEventListener('submit', onSubmit);
      $('consentCancel').addEventListener('click', onCancel);
      $('consentClose').addEventListener('click', onCancel);
      dlg.addEventListener('close', onClose);
      dlg.querySelectorAll('[data-consent]').forEach((b) => b.addEventListener('change', () => { $('consentError').hidden = true; }));
    });
  }
  // Para votar, reportar, pedir cupones o subir fotos: cuenta y aceptación.
  const readyToPost = async () => (!!currentUser || await login()) && await ensureConsent();

  function setAccountMenu(open: boolean) {
    $('accountMenu').hidden = !open;
    $('accountBtn').setAttribute('aria-expanded', String(open));
  }
  $('accountBtn').addEventListener('click', async () => {
    if (!currentUser) { await login(); return; }
    setAccountMenu($('accountMenu').hidden);
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.account')) setAccountMenu(false);
  });
  $('logoutBtn').addEventListener('click', async () => { setAccountMenu(false); await signOut(auth); });

  onAuthStateChanged(auth, async (user) => {
    currentUser = user;
    const photo = safeUrl(user?.photoURL || '');
    $('accountAvatar').innerHTML = user && photo ? `<img src="${photo}" alt="" referrerpolicy="no-referrer">` : personSvg;
    $('accountLabel').textContent = user ? (user.displayName || 'Mi cuenta').split(' ')[0] : 'Entrar';
    $('accountBtn').setAttribute('aria-label', user ? `Cuenta de ${user.displayName || 'usuario'}` : 'Entrar con Google');
    $('accountName').textContent = user ? (user.displayName || user.email || '') : '';
    $('adminLink').hidden = true;
    votedPhotos = new Set();
    if (user) {
      try { $('adminLink').hidden = !(await getDoc(doc(db, 'admins', user.uid))).exists(); } catch { /* no es admin */ }
      try {
        myRedemptions = new Set();
        const rs = await getDocs(query(collection(db, 'couponRedemptions'), where('userId', '==', user.uid)));
        rs.docs.forEach((d) => myRedemptions.add(d.data().couponId));
      } catch { /* sin canjes */ }
      try {
        const vs = await getDocs(query(collection(db, 'photoVotes'), where('userId', '==', user.uid)));
        vs.docs.forEach((d) => votedPhotos.add(d.data().photoId));
      } catch { /* sin votos */ }
    }
    if (selectedId) { const sp = allPlaces.find((x) => x.id === selectedId); if (sp) renderDetail(sp); }
    if (selectedBizId) { const sb = allBusinesses.find((x) => x.id === selectedBizId); if (sb) renderBusinessDetail(sb); }
    if (dialog.open && reviewPlace) showReviewStep();
  });

  // ---------- Reseña ----------
  const dialog = $('reviewDialog') as HTMLDialogElement;
  let reviewPlace: Place | null = null;
  let reviewRating = 0;
  let reviewPhotos: string[] = [];
  let uploadingPhotos = 0;
  let reviewVerified = false;

  function showReviewStep(step?: 'done') {
    const logged = !!currentUser;
    $('reviewLogin').hidden = logged || step === 'done';
    $('reviewForm').hidden = !logged || step === 'done';
    $('reviewDone').hidden = step !== 'done';
    if (logged) {
      const nm = currentUser.displayName || 'Visitante';
      $('reviewAs').textContent = nm;
      const pic = currentUser.photoURL ? safeUrl(currentUser.photoURL) : '';
      $('reviewAsAvatar').innerHTML = pic ? `<img src="${pic}" alt="" referrerpolicy="no-referrer">` : esc(nm.charAt(0).toUpperCase());
    }
  }

  function resetReviewForm() {
    reviewRating = 0; reviewPhotos = []; reviewVerified = false;
    document.querySelectorAll('.star-pick').forEach((b) => { b.classList.remove('is-on'); b.setAttribute('aria-pressed', 'false'); });
    setStarLabel(0);
    ($('reviewComment') as HTMLTextAreaElement).value = '';
    $('commentCount').textContent = 'Mínimo 10 letras · 0 de 1000';
    document.querySelectorAll('#reviewForm [aria-invalid]').forEach((x) => x.removeAttribute('aria-invalid'));
    ($('reviewDate') as HTMLInputElement).value = new Date().toLocaleDateString('en-CA');
    visitPicker.close();
    $('verifyStatus').textContent = 'Opcional. Si estás en el lugar, tu reseña lleva la marca de visita verificada. No guardamos tu ubicación.';
    $('verifyStatus').classList.remove('is-ok');
    $('verifyBtn').classList.remove('is-ok'); $('verifyBtn').disabled = false; $('verifyText').textContent = 'Verificar mi visita';
    $('reviewError').hidden = true;
    $('reviewLoginError').hidden = true;
    renderReviewPhotos();
  }

  function openReview(placeId: string) {
    const p = allPlaces.find((x) => x.id === placeId);
    if (!p) return;
    reviewPlace = p;
    $('reviewTitle').textContent = `¿Qué tal ${p.name}?`;
    resetReviewForm();
    showReviewStep();
    dialog.showModal();
    ($('reviewTitle') as HTMLElement).setAttribute('tabindex', '-1');
    ($('reviewTitle') as HTMLElement).focus({ preventScroll: true });
  }
  function closeReview() { dialog.close(); }
  $('reviewClose').addEventListener('click', closeReview);
  $('reviewDoneBtn').addEventListener('click', closeReview);
  dialog.addEventListener('click', (e) => { if (e.target === dialog) closeReview(); });

  $('reviewGoogle').addEventListener('click', async () => {
    const ok = await login();
    if (!ok && !currentUser) {
      $('reviewLoginError').textContent = 'No se pudo entrar. Si el navegador bloqueó la ventana de Google, permitila e intentá de nuevo.';
      $('reviewLoginError').hidden = false;
    }
  });

  // Cada estrella dice qué significa; al pasar el cursor se ve antes de elegir.
  const STAR_WORDS = ['Tocá una estrella', 'Malo', 'Regular', 'Bien', 'Muy bueno', '¡Buenísimo!'];
  function setStarLabel(n: number, preview = false) {
    $('starLabel').textContent = STAR_WORDS[n];
    $('starLabel').classList.toggle('is-set', !preview && n > 0);
  }
  document.querySelectorAll('.star-pick').forEach((btn) => {
    const n = Number((btn as HTMLElement).dataset.rating);
    btn.addEventListener('mouseenter', () => {
      $('starsGroup').classList.add('is-preview');
      document.querySelectorAll('.star-pick').forEach((b) => b.classList.toggle('is-hint', Number((b as HTMLElement).dataset.rating) <= n));
      setStarLabel(n, true);
    });
  });
  $('starsGroup').addEventListener('mouseleave', () => {
    $('starsGroup').classList.remove('is-preview');
    setStarLabel(reviewRating);
  });
  document.querySelectorAll('.star-pick').forEach((btn) => {
    btn.addEventListener('click', () => {
      reviewRating = Number((btn as HTMLElement).dataset.rating);
      document.querySelectorAll('.star-pick').forEach((b) => {
        const on = Number((b as HTMLElement).dataset.rating) <= reviewRating;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-pressed', String(Number((b as HTMLElement).dataset.rating) === reviewRating));
      });
      $('starsGroup').classList.remove('is-preview');
      setStarLabel(reviewRating);
    });
  });

  $('verifyBtn').addEventListener('click', () => {
    if (!reviewPlace) return;
    if (!navigator.geolocation) { $('verifyStatus').textContent = 'Tu navegador no permite ver tu ubicación.'; return; }
    $('verifyText').textContent = 'Buscando…';
    $('verifyStatus').textContent = '';
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        const d = distanceKm([pos.coords.latitude, pos.coords.longitude], [reviewPlace!.lat, reviewPlace!.lng]);
        reviewVerified = d <= 0.5;
        $('verifyStatus').textContent = reviewVerified ? '' : `Estás a ${fmtKm(d)} del lugar. Podés publicar igual, sin la marca de visita verificada.`;
        $('verifyText').textContent = reviewVerified ? 'Visita verificada' : 'Probar de nuevo';
        $('verifyBtn').classList.toggle('is-ok', reviewVerified);
        $('verifyBtn').disabled = reviewVerified;
      },
      () => { $('verifyText').textContent = 'Probar de nuevo'; $('verifyStatus').textContent = 'No se pudo ver tu ubicación. Revisá el permiso del navegador.'; },
      { enableHighAccuracy: true, timeout: 15000, maximumAge: 60000 }
    );
  });

  // Al corregir un campo se quita su error.
  const clearFieldError = (e: Event) => {
    (e.target as HTMLElement).removeAttribute('aria-invalid');
    if (!$('reviewError').hidden && !uploadingPhotos) $('reviewError').hidden = true;
  };
  $('reviewComment').addEventListener('input', (e: Event) => {
    clearFieldError(e);
    const n = ($('reviewComment') as HTMLTextAreaElement).value.trim().length;
    $('commentCount').textContent = n < 10 ? `Mínimo 10 letras · ${n} de 1000` : `${n} de 1000`;
  });
  // ---------- Fecha de la visita: selector propio, sin días futuros ----------
  const visitPicker = datePicker($('reviewDate') as HTMLInputElement, {
    min: '2000-01-01', max: 'today', placement: 'top', title: 'Elegí el día de tu visita',
    quick: [{ label: 'Hoy', days: 0 }, { label: 'Ayer', days: -1 }, { label: 'Hace una semana', days: -7 }],
    onChange: () => { if ($('reviewError').textContent.includes('fecha')) $('reviewError').hidden = true; },
  });
  document.querySelectorAll('.star-pick').forEach((b) => b.addEventListener('click', () => { if ($('reviewError').textContent.includes('estrellas')) $('reviewError').hidden = true; }));

  function renderReviewPhotos() {
    $('reviewPhotos').innerHTML =
      reviewPhotos.map((u, i) => `<div class="photo-pick"><img src="${safeUrl(u)}" alt="Foto ${i + 1}"><button type="button" data-remove="${i}" aria-label="Quitar foto ${i + 1}">×</button></div>`).join('') +
      Array.from({ length: uploadingPhotos }, () => '<div class="photo-pick is-loading">Subiendo…</div>').join('');
    const used = reviewPhotos.length + uploadingPhotos;
    $('photoAdd').hidden = used >= 4;
    $('photoAdd').classList.toggle('is-compact', used > 0);
    $('dzTitle').textContent = used ? 'Agregar otra foto' : 'Agregá fotos de tu visita';
    $('dzSub').textContent = used ? `Te ${4 - used === 1 ? 'queda 1' : `quedan ${4 - used}`}` : 'Arrastralas aquí o tocá para elegir · hasta 4';
  }
  $('reviewPhotos').addEventListener('click', (e: Event) => {
    const b = (e.target as HTMLElement).closest('[data-remove]') as HTMLElement | null;
    if (b) { reviewPhotos.splice(Number(b.dataset.remove), 1); renderReviewPhotos(); }
  });
  $('reviewPhotoInput').addEventListener('change', (e: Event) => {
    const input = e.target as HTMLInputElement;
    const picked = Array.from(input.files || []);
    input.value = '';
    addReviewPhotos(picked);
  });
  // Arrastrar y soltar fotos sobre la zona.
  const dz = $('photoAdd') as HTMLElement;
  ['dragenter', 'dragover'].forEach((t) => dz.addEventListener(t, (e: DragEvent) => { e.preventDefault(); dz.classList.add('is-over'); }));
  ['dragleave', 'dragend'].forEach((t) => dz.addEventListener(t, () => dz.classList.remove('is-over')));
  dz.addEventListener('drop', (e: DragEvent) => {
    e.preventDefault(); dz.classList.remove('is-over');
    addReviewPhotos(Array.from(e.dataTransfer?.files || []).filter((f) => f.type.startsWith('image/')));
  });
  async function addReviewPhotos(picked: File[]) {
    if (!(await ensureConsent())) return;
    const room = Math.max(0, 4 - reviewPhotos.length - uploadingPhotos);
    const files = picked.slice(0, room);
    $('reviewError').hidden = true;
    if (picked.length > room) {
      $('reviewError').textContent = room
        ? `Podés subir hasta 4 fotos. Se van a subir solo ${room} de las ${picked.length} que elegiste.`
        : 'Ya tenés 4 fotos. Quitá una para subir otra.';
      $('reviewError').hidden = false;
    }
    for (const f of files) {
      uploadingPhotos++; renderReviewPhotos();
      try {
        reviewPhotos.push(await uploadImage(f, 'reviews', currentUser.uid));
      } catch (err: any) {
        $('reviewError').textContent = err?.message || 'No se pudo subir la foto.';
        $('reviewError').hidden = false;
      } finally {
        uploadingPhotos--; renderReviewPhotos();
      }
    }
  }

  $('reviewForm').addEventListener('submit', async (e: Event) => {
    e.preventDefault();
    // Muestra el error y lleva el foco al campo que hay que corregir.
    const err = (msg: string, field?: string) => {
      $('reviewError').textContent = msg; $('reviewError').hidden = false;
      if (field) { const f = $(field) as HTMLElement; f.setAttribute('aria-invalid', 'true'); f.focus(); }
      else $('reviewError').scrollIntoView({ block: 'nearest' });
    };
    $('reviewError').hidden = true;
    document.querySelectorAll('#reviewForm [aria-invalid]').forEach((x) => x.removeAttribute('aria-invalid'));
    if (!currentUser || !reviewPlace) return;
    if (!(await ensureConsent())) return;
    if (!reviewRating) { err('Elegí de 1 a 5 estrellas.'); (document.querySelector('.star-pick') as HTMLElement)?.focus(); return; }
    const comment = ($('reviewComment') as HTMLTextAreaElement).value.trim();
    if (comment.length < 10) return err(`Contá un poquito más: faltan ${10 - comment.length} letras.`, 'reviewComment');
    const visit = ($('reviewDate') as HTMLInputElement).value;
    const today = new Date().toLocaleDateString('en-CA');
    if (visit && visit > today) return err('La fecha de tu visita no puede ser después de hoy.', 'reviewDateBtn');
    if (visit && visit < '2000-01-01') return err('Revisá la fecha de tu visita.', 'reviewDateBtn');
    if (uploadingPhotos > 0) return err('Esperá a que terminen de subir las fotos.');
    const submit = $('reviewSubmit') as HTMLButtonElement;
    submit.disabled = true; submit.textContent = 'Publicando…';
    try {
      const data: Review & Record<string, any> = {
        placeId: reviewPlace.id,
        placeName: reviewPlace.name,
        placeLat: reviewPlace.lat,
        placeLng: reviewPlace.lng,
        userId: currentUser.uid,
        // Las reseñas son públicas: se guarda el nombre y la foto de perfil, nunca el correo.
        userName: currentUser.displayName || 'Visitante',
        userPhoto: currentUser.photoURL || '',
        rating: reviewRating,
        comment,
        photos: reviewPhotos,
        visitDate: visit || '',
        verified: reviewVerified,
        useful: 0, fun: 0, like: 0,
        createdAt: serverTimestamp(),
      };
      const newRef = await addDoc(collection(db, 'reviews'), data);
      // Las fotos de la reseña también entran a la galería y se pueden votar.
      for (const u of reviewPhotos) { try { await addCommunityPhoto(reviewPlace, u); } catch (e3) { console.error(e3); } }
      (reviewsByPlace[reviewPlace.id] ||= []).push({ ...data, id: newRef.id, createdAt: { toMillis: () => Date.now() } });
      renderList();
      if (selectedId === reviewPlace.id) renderDetail(reviewPlace);
      showReviewStep('done');
    } catch (e2) {
      console.error('No se pudo publicar la reseña:', e2);
      err('No se pudo publicar la reseña. Revisá tu conexión e intentá de nuevo.');
    } finally {
      submit.disabled = false; submit.textContent = 'Publicar reseña';
    }
  });

  // Negocios del lugar o a menos de 3 km; primero los destacados, luego el más cercano.
  function nearbyBusinesses(p: Place) {
    return allBusinesses
      .map((b) => ({ b, d: distanceKm([p.lat, p.lng], [b.lat, b.lng]) }))
      .filter(({ b, d }) => b.placeId === p.id || d <= 3)
      .sort((x, y) => Number(isFeatured(y.b)) - Number(isFeatured(x.b)) || x.d - y.d)
      .slice(0, 6);
  }

  async function bumpBiz(id: string, field: 'viewCount' | 'clickCount') {
    try { await updateDoc(doc(db, 'businesses', id), { [field]: increment(1) }); } catch { /* no es grave */ }
  }

  function selectBusiness(id: string, fromPlaceId?: string) {
    const b = allBusinesses.find((x) => x.id === id);
    if (!b) return;
    if (fromPlaceId !== undefined) bizFromPlace = fromPlaceId;
    else if (!selectedId) bizFromPlace = null;
    else bizFromPlace = selectedId;
    selectedBizId = id;
    selectedId = null;
    renderMarkers(); renderBizMarkers(); updateBizLayer();
    renderBusinessDetail(b);
    if (isMobile()) setSheet('half'); else setPanelOpen(true);
    flyToPlace(b as any, 16);
    bumpBiz(id, 'viewCount');
    history.replaceState(null, '', `#b-${encodeURIComponent(id)}`);
    hideHint();
    updateClearBtn();
  }

  function waLink(b: Business) {
    const digits = String(b.whatsapp || '').replace(/\D/g, '');
    if (!digits) return '';
    const full = digits.length === 8 ? `503${digits}` : digits;
    return `https://wa.me/${full}?text=${encodeURIComponent(`Hola, los vi en Goz. Quería consultar sobre ${b.name}.`)}`;
  }

  function renderBusinessDetail(b: Business) {
    const from = bizFromPlace ? allPlaces.find((x) => x.id === bizFromPlace) : null;
    const photos = [b.coverUrl, ...(b.photos || [])].map((u) => safeUrl(u)).filter(Boolean).filter((u, i, a) => a.indexOf(u) === i);
    const wa = waLink(b);
    const phone = String(b.phone || '').replace(/[^\d+]/g, '');
    const directions = `https://www.google.com/maps/dir/?api=1&destination=${num(b.lat)},${num(b.lng)}`;
    $('detailView').innerHTML = `
      ${from ? `<button type="button" class="back-btn" id="backBtn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
        Volver a ${esc(from.name)}
      </button>` : ''}
      ${photos[0] ? `<img class="detail-photo" src="${photos[0]}" alt="Foto de ${esc(b.name)}">` : `<div class="detail-photo biz-thumb biz-cover-empty" aria-hidden="true">${bizIcon(b.category, 48)}</div>`}
      <h2 class="detail-title" tabindex="-1" id="detailTitle">${esc(b.name)}</h2>
      <p class="detail-kicker">${esc(BIZ_NAMES[b.category] || 'Negocio')}${b.placeName ? ` · cerca de ${esc(b.placeName)}` : ''}${isFeatured(b) ? ' <span class="tag-featured">Destacado</span>' : ''}</p>
      ${b.promoToday ? `<p class="promo-banner"><strong>Promo de hoy:</strong> ${esc(b.promoToday.replace(/^\s*hoy\s*[:,-]?\s*/i, ''))}</p>` : ''}
      <div class="detail-actions">
        ${wa ? `<a class="btn btn-primary" id="waBtn" href="${wa}" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2zm0 18a8 8 0 01-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1112 20zm4.4-6c-.2-.1-1.4-.7-1.7-.8s-.4-.1-.5.1-.6.8-.8.9-.3.2-.5 0a6.5 6.5 0 01-3.2-2.8c-.2-.4.2-.4.7-1.3a.4.4 0 000-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 00-.6.3 2.6 2.6 0 00-.8 1.9 4.5 4.5 0 00.9 2.4 10.3 10.3 0 004 3.5c1.5.6 2 .7 2.8.6a2.4 2.4 0 001.6-1.1 2 2 0 00.1-1.1c0-.1-.2-.2-.4-.3z"></path></svg>
          WhatsApp</a>` : ''}
        <a class="btn ${wa ? 'btn-outline' : 'btn-primary'}" href="${directions}" target="_blank" rel="noopener">Cómo llegar</a>
      </div>
      ${b.description ? `<p class="detail-desc">${esc(b.description)}</p>` : ''}
      <ul class="detail-facts">
        ${b.schedule ? `<li>${icoClock}<span>${esc(b.schedule)}</span></li>` : ''}
        ${b.address ? `<li>${icoPin}<span>${esc(b.address)}</span></li>` : ''}
        ${phone ? `<li>${icoPhone}<a href="tel:${esc(phone)}" style="color:var(--link)">${esc(b.phone || '')}</a></li>` : ''}
        ${safeUrl(b.menu) ? `<li>${icoLink}<a href="${safeUrl(b.menu)}" target="_blank" rel="noopener" style="color:var(--link)">Ver el menú</a></li>` : ''}
      </ul>
      ${(couponsByBiz[b.id] || []).filter(couponOk).length ? `<h3 class="section-title">Cupones</h3>
        <ul class="coupons">${(couponsByBiz[b.id] || []).filter(couponOk).map((c) => {
          const mine = myRedemptions.has(c.id);
          return `<li class="coupon">
            <div class="coupon-main">
              ${c.discount ? `<span class="coupon-off">${esc(c.discount)}</span>` : ''}
              <p class="coupon-title">${esc(c.title)}</p>
              ${c.description ? `<p class="coupon-desc">${esc(c.description)}</p>` : ''}
              ${c.validUntil ? `<p class="coupon-desc">Válido hasta el ${esc(fmtDate(String(c.validUntil).slice(0, 10)))}</p>` : ''}
            </div>
            ${mine
              ? `<p class="coupon-code">Tu código: <strong>${esc(c.code || '')}</strong><span>Mostralo al pagar en el negocio.</span></p>`
              : `<button type="button" class="btn btn-primary btn-sm" data-coupon="${esc(c.id)}">Obtener cupón</button>`}
          </li>`;
        }).join('')}</ul><p id="couponStatus" class="field-help" aria-live="polite"></p>` : ''}
      ${photos.length > 1 ? `<div class="gallery" data-lb-group>${photos.slice(1, 7).map((u, k) => `<a href="${u}" data-lb="grp" data-i="${k}"><img src="${u}" alt="" loading="lazy"></a>`).join('')}</div>` : ''}
    `;
    $('listView').hidden = true;
    $('detailView').hidden = false;
    $('panelBody').scrollTop = 0;
    $('backBtn')?.addEventListener('click', () => { if (from) selectPlace(from.id, { count: false }); });
    $('detailView').querySelectorAll('[data-coupon]').forEach((btn: HTMLButtonElement) => btn.addEventListener('click', () => redeemCoupon(b, btn.dataset.coupon!, btn)));
    $('waBtn')?.addEventListener('click', () => bumpBiz(b.id, 'clickCount'));
    if (!isMobile()) ($('detailTitle') as HTMLElement).focus({ preventScroll: true });
  }

  // Un cupón por persona: el canje es couponRedemptions/{cupón}_{usuario} y va junto con el +1.
  async function redeemCoupon(b: Business, couponId: string, btn: HTMLButtonElement) {
    if (!(await readyToPost())) return;
    if (myRedemptions.has(couponId)) { renderBusinessDetail(b); return; }
    btn.disabled = true; btn.textContent = 'Un momento…';
    try {
      const batch = writeBatch(db);
      batch.set(doc(db, 'couponRedemptions', `${couponId}_${currentUser.uid}`), { couponId, businessId: b.id, userId: currentUser.uid, redeemedAt: new Date().toISOString() });
      batch.update(doc(db, 'coupons', couponId), { usedCount: increment(1) });
      await batch.commit();
      myRedemptions.add(couponId);
      const c = (couponsByBiz[b.id] || []).find((x) => x.id === couponId); if (c) c.usedCount = num(c.usedCount) + 1;
      renderBusinessDetail(b);
    } catch (err) {
      console.error('No se pudo obtener el cupón:', err);
      btn.disabled = false; btn.textContent = 'Obtener cupón';
      if ($('couponStatus')) $('couponStatus').textContent = 'No se pudo obtener el cupón. Puede que ya se hayan acabado o que ya lo tengás.';
    }
  }

  // ---------- Compartir un lugar ----------
  // Comparte la página propia del lugar (/lugar/id), que se ve con foto en WhatsApp y redes.
  // Si el lugar es nuevo y su página todavía no existe, comparte el enlace del mapa.
  $('detailView').addEventListener('click', async (e: Event) => {
    const b = (e.target as HTMLElement).closest('[data-share]') as HTMLElement | null;
    if (!b) return;
    const id = b.dataset.share!;
    const p = allPlaces.find((x) => x.id === id);
    let url = `${location.origin}/lugar/${encodeURIComponent(id)}`;
    try { const r = await fetch(url, { method: 'HEAD' }); if (!r.ok) url = `${location.origin}/#${encodeURIComponent(id)}`; } catch { url = `${location.origin}/#${encodeURIComponent(id)}`; }
    try {
      if (navigator.share) { await navigator.share({ title: p?.name || 'Goz', text: `${p?.name || 'Este lugar'} en Goz`, url }); return; }
      await navigator.clipboard.writeText(url);
      if ($('shareStatus')) $('shareStatus').textContent = 'Enlace copiado. Pegalo donde querás compartirlo.';
    } catch { /* la persona canceló */ }
  });

  // ---------- Reportar reseñas y fotos ----------
  // Lo que ya reportó esta persona en esta visita (el documento no se puede leer después).
  const reportedIds = new Set<string>();
  let reportTarget: { type: 'review' | 'photo'; id: string; placeId: string } | null = null;
  async function openReport(type: 'review' | 'photo', id: string, placeId: string) {
    if (!(await readyToPost())) return;
    reportTarget = { type, id, placeId };
    const done = reportedIds.has(`${type}_${id}`);
    $('reportTitle').textContent = type === 'review' ? '¿Qué pasa con esta reseña?' : '¿Qué pasa con esta foto?';
    ($('reportForm') as HTMLFormElement).reset();
    $('reportError').hidden = true;
    document.querySelector('.rp-options')!.classList.remove('is-invalid');
    $('reportForm').hidden = done; $('reportDone').hidden = !done;
    ($('reportSubmit') as HTMLButtonElement).disabled = false;
    ($('reportDialog') as HTMLDialogElement).showModal();
  }
  const closeReport = () => ($('reportDialog') as HTMLDialogElement).close();
  $('reportClose').addEventListener('click', closeReport);
  $('reportCancel').addEventListener('click', closeReport);
  $('reportOk').addEventListener('click', closeReport);
  $('reportDialog').addEventListener('click', (e: Event) => { if (e.target === $('reportDialog')) closeReport(); });
  document.querySelectorAll('.rp-options input').forEach((x) => x.addEventListener('change', () => {
    $('reportError').hidden = true; document.querySelector('.rp-options')!.classList.remove('is-invalid');
  }));
  $('reportForm').addEventListener('submit', async (e: Event) => {
    e.preventDefault();
    if (!reportTarget || !currentUser) return;
    const reason = (document.querySelector('.rp-options input:checked') as HTMLInputElement | null)?.value;
    if (!reason) {
      $('reportError').textContent = 'Elegí qué pasa para poder revisarlo.'; $('reportError').hidden = false;
      document.querySelector('.rp-options')!.classList.add('is-invalid');
      (document.querySelector('.rp-options input') as HTMLElement).focus();
      return;
    }
    const btn = $('reportSubmit') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Enviando…';
    const { type, id, placeId } = reportTarget;
    try {
      await setDoc(doc(db, 'reports', `${type}_${id}_${currentUser.uid}`), {
        type, targetId: id, placeId, reason, note: ($('reportNote') as HTMLTextAreaElement).value.trim().slice(0, 300),
        userId: currentUser.uid, userName: currentUser.displayName || 'Visitante', status: 'open', createdAt: serverTimestamp(),
      });
      markReported(type, id);
    } catch (err) {
      // Si ya lo había reportado antes, la regla no deja repetir: igual se da por hecho.
      console.error('No se pudo enviar el reporte:', err);
      if ((err as any)?.code === 'permission-denied') markReported(type, id);
      else { $('reportError').textContent = 'No se pudo enviar. Revisá tu conexión y probá otra vez.'; $('reportError').hidden = false; }
    } finally { btn.disabled = false; btn.textContent = 'Enviar reporte'; }
  });
  function markReported(type: string, id: string) {
    reportedIds.add(`${type}_${id}`);
    $('reportForm').hidden = true; $('reportDone').hidden = false;
    ($('reportOk') as HTMLElement).focus();
    if (lb.open) lbShow(lbIndex);
    document.querySelectorAll(`[data-report="${type}"][data-target="${CSS.escape(id)}"]`).forEach((b) => { b.textContent = 'Reportada'; });
  }
  $('detailView').addEventListener('click', (e: Event) => {
    const b = (e.target as HTMLElement).closest('[data-report]') as HTMLElement | null;
    if (b) openReport(b.dataset.report as 'review' | 'photo', b.dataset.target!, b.dataset.place || '');
  });

  // ---------- Fotos y votos ----------
  // Un voto por persona: el documento photoVotes/{foto}_{usuario} y el +1 van juntos,
  // y las reglas de Firestore no dejan sumar sin ese documento.
  async function votePhoto(photoId: string) {
    if (!(await readyToPost())) return;
    if (votedPhotos.has(photoId)) return;
    const ph = Object.values(photosByPlace).flat().find((x) => x.id === photoId);
    if (!ph) return;
    try {
      const batch = writeBatch(db);
      batch.set(doc(db, 'photoVotes', `${photoId}_${currentUser.uid}`), { photoId, placeId: ph.placeId, userId: currentUser.uid, createdAt: serverTimestamp() });
      batch.update(doc(db, 'photos', photoId), { votes: increment(1) });
      await batch.commit();
      votedPhotos.add(photoId);
      ph.votes = num(ph.votes) + 1;
      sortPhotos(photosByPlace[ph.placeId]);
      renderList();
      const sp = allPlaces.find((x) => x.id === ph.placeId);
      if (sp && selectedId === sp.id) renderDetail(sp);
    } catch (err) {
      console.error('No se pudo votar:', err);
      votedPhotos.add(photoId);
      const sp = allPlaces.find((x) => x.id === ph.placeId);
      if (sp && selectedId === sp.id) { renderDetail(sp); $('photoStatus').textContent = 'No se pudo contar tu voto. Puede que ya hayás votado por esta foto.'; }
    }
  }

  async function addCommunityPhoto(p: Place, url: string) {
    const data = {
      placeId: p.id, placeName: p.name, url, caption: '',
      userId: currentUser.uid, userName: currentUser.displayName || 'Visitante', userPhoto: currentUser.photoURL || '',
      votes: 0, useful: 0, fun: 0, like: 0, rating: 0, createdAt: serverTimestamp(),
    };
    const ref = await addDoc(collection(db, 'photos'), data);
    (photosByPlace[p.id] ||= []).push({ ...data, id: ref.id, createdAt: { toMillis: () => Date.now() } } as CPhoto);
    sortPhotos(photosByPlace[p.id]);
  }

  async function uploadPlacePhoto(p: Place, input: HTMLInputElement) {
    const file = input.files?.[0];
    input.value = '';
    if (!file || !currentUser) return;
    $('photoStatus').textContent = 'Subiendo tu foto…';
    try {
      await addCommunityPhoto(p, await uploadImage(file, 'reviews', currentUser.uid));
      renderDetail(p);
      $('photoStatus').textContent = 'Listo: tu foto ya está en la galería.';
    } catch (err: any) {
      $('photoStatus').textContent = err?.message || 'No se pudo subir la foto.';
    }
  }

  // ---------- Filtros ----------
  $('searchInput').addEventListener('input', (e: Event) => {
    currentQuery = (e.target as HTMLInputElement).value;
    if (currentQuery.trim().length >= 2) loadAllPlaces();
    if (selectedId || selectedBizId) closeDetail(true);
    applyFilters();
    if (currentQuery) openList();
  });

  document.querySelectorAll('.chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      currentCategory = (btn as HTMLElement).dataset.category || 'all';
      if (currentCategory !== 'all') loadCategory(currentCategory);
      document.querySelectorAll('.chip').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      if (selectedId || selectedBizId) closeDetail(true);
      applyFilters();
      openList();
    });
  });

  // ---------- Cerca de mí ----------
  function locate() {
    if (!navigator.geolocation) {
      $('resultCount').textContent = 'Tu navegador no permite ver tu ubicación.';
      openList();
      return;
    }
    $('resultCount').textContent = 'Buscando tu ubicación…';
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        userPos = [pos.coords.latitude, pos.coords.longitude];
        if (meMarker) meMarker.remove();
        meMarker = L.marker(userPos, { icon: L.divIcon({ className: 'pin-wrap', html: '<div class="me-dot"></div>', iconSize: [18, 18], iconAnchor: [9, 9] }), interactive: false, zIndexOffset: 2000 }).addTo(map);
        if (selectedId || selectedBizId) closeDetail(true);
        applyFilters();
        map.flyTo(userPos, 11, { duration: 0.8 });
        openList();
      },
      () => {
        $('resultCount').textContent = 'No se pudo obtener tu ubicación. Revisá el permiso de ubicación del navegador.';
        openList();
      },
      { enableHighAccuracy: false, timeout: 10000, maximumAge: 300000 }
    );
  }
  $('locateBtn')?.addEventListener('click', locate);

  const SV_BOUNDS: [[number, number], [number, number]] = [[13.15, -90.13], [14.45, -87.68]];

  // ---------- Carga por zona, como un mapa de calles ----------
  // Lejos (todo el país) se piden solo los lugares más visitados. Al acercarse, se piden los de la
  // franja que se está viendo (por latitud, en franjas de 0.2°) y cada franja se pide una sola vez.
  // Las reseñas, fotos, negocios y cupones se piden solo para lo que ya está cargado.
  const loadedBands = new Set<number>();
  const loadedExtras = new Set<string>();
  const loadedBizBands = new Set<number>();
  let loadedAll = false;
  const asPlace = (d: any) => ({ id: d.id, ...d.data(), lat: Number(d.data().lat), lng: Number(d.data().lng) } as Place);
  const chunks = <T,>(a: T[], n = 30) => Array.from({ length: Math.ceil(a.length / n) }, (_, i) => a.slice(i * n, i * n + n));

  function addPlaces(list: Place[]) {
    const fresh: string[] = [];
    const byId = new Map(allPlaces.map((x) => [x.id, x]));
    list.forEach((x) => { if (!byId.has(x.id)) fresh.push(x.id); byId.set(x.id, x); });
    allPlaces = [...byId.values()].sort((a, b) => num(b.visitCount) - num(a.visitCount));
    return fresh;
  }
  // Reseñas y fotos de los lugares recién cargados (de 30 en 30, que es lo que permite Firestore).
  async function loadExtras(ids: string[]) {
    const todo = ids.filter((x) => !loadedExtras.has(x));
    if (!todo.length) return;
    todo.forEach((x) => loadedExtras.add(x));
    const res = await Promise.all(chunks(todo).flatMap((c) => [
      getDocs(query(collection(db, 'reviews'), where('placeId', 'in', c))).catch(() => null),
      getDocs(query(collection(db, 'photos'), where('placeId', 'in', c))).catch(() => null),
    ]));
    res.forEach((snap, i) => snap?.docs.forEach((d) => {
      if (i % 2 === 0) {
        const r = { id: d.id, ...d.data() } as Review;
        const list = (reviewsByPlace[r.placeId] ||= []);
        if (!list.some((x) => x.id === r.id)) list.push(r);
      } else {
        const ph = { id: d.id, ...d.data() } as CPhoto;
        if (!ph.placeId || !ph.url) return;
        const list = (photosByPlace[ph.placeId] ||= []);
        if (!list.some((x) => x.id === ph.id)) list.push(ph);
      }
    }));
    todo.forEach((x) => photosByPlace[x] && sortPhotos(photosByPlace[x]));
  }
  // Negocios aprobados de las franjas a la vista, y sus cupones.
  async function loadBusinesses(bands: number[]) {
    const todo = bands.filter((k) => !loadedBizBands.has(k));
    if (!todo.length) return;
    todo.forEach((k) => loadedBizBands.add(k));
    const snaps = await Promise.all(todo.map((k) => getDocs(query(collection(db, 'businesses'), where('lat', '>=', k * BAND), where('lat', '<', (k + 1) * BAND))).catch(() => null)));
    const fresh: Business[] = [];
    snaps.forEach((snap) => snap?.docs.forEach((d) => {
      const b = { id: d.id, ...d.data() } as Business;
      if (b.status === 'pending' || b.status === 'rejected' || allBusinesses.some((x) => x.id === b.id)) return;
      fresh.push({ ...b, lat: Number(b.lat), lng: Number(b.lng) });
    }));
    if (!fresh.length) return;
    allBusinesses = [...allBusinesses, ...fresh];
    renderBizMarkers(); updateBizLayer();
    const cs = await Promise.all(chunks(fresh.map((b) => b.id)).map((c) => getDocs(query(collection(db, 'coupons'), where('businessId', 'in', c))).catch(() => null)));
    cs.forEach((snap) => snap?.docs.forEach((d) => { const c = { id: d.id, ...d.data() } as Coupon; (couponsByBiz[c.businessId] ||= []).push(c); }));
    if (selectedBizId) { const sb = allBusinesses.find((x) => x.id === selectedBizId); if (sb) renderBusinessDetail(sb); }
  }
  const bandsFor = (south: number, north: number) => {
    const out: number[] = [];
    for (let k = Math.floor(south / BAND); k <= Math.floor(north / BAND); k++) out.push(k);
    return out;
  };
  // Después de cargar algo nuevo: lista, puntos y la ficha abierta se actualizan sin mover el mapa.
  function refreshAfterLoad() {
    applyFilters();
    if (selectedId) { const sp = allPlaces.find((x) => x.id === selectedId); if (sp) renderDetail(sp); }
  }
  async function loadZone() {
    const b = map.getBounds().pad(0.25);
    const bands = bandsFor(b.getSouth(), b.getNorth());
    if (map.getZoom() >= BIZ_MIN_ZOOM - 1) loadBusinesses(bands);
    if (loadedAll) return;
    if (map.getZoom() < ZONE_ZOOM) { loadTop(); return; }
    const todo = bands.filter((k) => !loadedBands.has(k));
    if (!todo.length) return;
    todo.forEach((k) => loadedBands.add(k));
    try {
      const snaps = await Promise.all(todo.map((k) => getDocs(query(collection(db, 'places'), where('lat', '>=', k * BAND), where('lat', '<', (k + 1) * BAND)))));
      const fresh = addPlaces(snaps.flatMap((sn) => sn.docs.map(asPlace)));
      if (fresh.length) { refreshAfterLoad(); await loadExtras(fresh); refreshAfterLoad(); }
    } catch (err) {
      console.error('No se pudo cargar la zona:', err); todo.forEach((k) => loadedBands.delete(k));
      if (!allPlaces.length) { $('resultCount').textContent = ''; $('peekTitle').textContent = 'No se pudieron cargar los lugares'; $('errorState').hidden = false; }
    }
  }
  let zoneTimer: any;
  map.on('moveend', () => { clearTimeout(zoneTimer); zoneTimer = setTimeout(() => { loadZone(); if (!currentQuery) renderList(); }, 250); });
  // Buscar por nombre necesita todos: se piden una sola vez, solo si alguien busca.
  async function loadAllPlaces() {
    if (loadedAll) return;
    loadedAll = true;
    try {
      const snap = await getDocs(collection(db, 'places'));
      const fresh = addPlaces(snap.docs.map(asPlace));
      refreshAfterLoad();
      if (fresh.length) { await loadExtras(fresh); refreshAfterLoad(); }
    } catch (err) { console.error(err); loadedAll = false; }
  }
  // Al elegir una categoría se piden todos los de esa categoría (una vez por categoría).
  const loadedCats = new Set<string>();
  async function loadCategory(cat: string) {
    if (loadedAll || loadedCats.has(cat)) return;
    loadedCats.add(cat);
    try {
      const snap = await getDocs(query(collection(db, 'places'), where('category', '==', cat)));
      const fresh = addPlaces(snap.docs.map(asPlace));
      if (fresh.length) { refreshAfterLoad(); await loadExtras(fresh); refreshAfterLoad(); }
    } catch (err) { console.error(err); loadedCats.delete(cat); }
  }
  // Un lugar que llega por enlace (#id) y todavía no está cargado.
  async function ensurePlace(id: string) {
    if (allPlaces.some((p) => p.id === id)) return true;
    try {
      const d = await getDoc(doc(db, 'places', id));
      if (!d.exists()) return false;
      addPlaces([asPlace(d)]);
      await loadExtras([id]);
      applyFilters();
      return true;
    } catch { return false; }
  }

  // Lejos (todo el país) se ven solo los más visitados; se piden una vez y solo si alguien se aleja.
  let topLoaded = false;
  async function loadTop() {
    if (topLoaded || loadedAll) return;
    topLoaded = true;
    try {
      const snap = await getDocs(query(collection(db, 'places'), orderBy('visitCount', 'desc'), limit(TOP_LIMIT)));
      const fresh = addPlaces(snap.docs.map(asPlace));
      if (fresh.length) { refreshAfterLoad(); await loadExtras(fresh); refreshAfterLoad(); }
    } catch (err) { console.error(err); topLoaded = false; }
  }

  // Vista inicial: cerca de la persona si ya dio permiso de ubicación; si no, San Salvador y alrededores.
  // Así al abrir solo se pide esa zona, no todo el país.
  const START: [number, number] = [13.70, -89.20];
  const START_ZOOM = 11;
  async function startView() {
    try {
      const perm = await (navigator as any).permissions?.query({ name: 'geolocation' });
      if (perm?.state === 'granted') {
        const pos = await new Promise<GeolocationPosition>((ok, ko) => navigator.geolocation.getCurrentPosition(ok, ko, { timeout: 4000, maximumAge: 600000 }));
        const here: [number, number] = [pos.coords.latitude, pos.coords.longitude];
        if (L.latLngBounds(SV_BOUNDS).contains(here)) { map.setView(here, 12); return; }
      }
    } catch { /* sin permiso o sin señal: se usa la vista de siempre */ }
    map.setView(START, isMobile() ? START_ZOOM - 0.5 : START_ZOOM);
  }

  async function load() {
    try {
      // Abrir lugar o negocio cuando cambia el enlace (#id o #b-id) sin recargar.
      window.addEventListener('hashchange', async () => {
        const h = decodeURIComponent(location.hash.slice(1));
        if (h.startsWith('b-')) { if (h.slice(2) !== selectedBizId) selectBusiness(h.slice(2)); }
        else if (h && h !== selectedId && await ensurePlace(h)) selectPlace(h, { count: false });
      });
      const fromHash = decodeURIComponent(location.hash.slice(1));
      let opened = false;
      if (fromHash.startsWith('b-')) {
        // Negocio por enlace: se pide directo y se abre.
        const d = await getDoc(doc(db, 'businesses', fromHash.slice(2))).catch(() => null);
        if (d?.exists()) {
          const b = { id: d.id, ...d.data() } as Business;
          if (b.status !== 'pending' && b.status !== 'rejected') { allBusinesses.push({ ...b, lat: Number(b.lat), lng: Number(b.lng) }); renderBizMarkers(); selectBusiness(b.id); opened = true; }
        }
      } else if (fromHash && await ensurePlace(fromHash)) {
        selectPlace(fromHash, { count: false });
        opened = true;
      }
      if (!opened) await startView();
      await loadZone();
      applyFilters();
      $('placesList').removeAttribute('aria-busy');
      hideMapLoading();
    } catch (err) {
      console.error('Error cargando lugares:', err);
      $('placesList').innerHTML = ''; $('placesList').removeAttribute('aria-busy');
      hideMapLoading();
      $('resultCount').textContent = '';
      $('peekTitle').textContent = 'No se pudieron cargar los lugares';
      $('errorState').hidden = false;
      openList();
    }
  }

  function hideMapLoading() {
    const el = $('mapLoading');
    el.classList.add('is-done');
    setTimeout(() => el.remove(), 400);
  }
  if (isMobile()) { $('searchInput').placeholder = 'Buscar en El Salvador'; setSheet('peek'); }
  window.addEventListener('resize', () => {
    map.invalidateSize();
    if (isMobile()) setSheet(sheet);
  });
  load();
</script>
