---
import Layout from '../layouts/Layout.astro';
import GozMark from '../components/GozMark.astro';
import GozLoader from '../components/GozLoader.astro';

const categories = [
  { id: 'all', label: 'Todo' },
  { id: 'montaña', label: 'Volcanes' },
  { id: 'playa', label: 'Playas' },
  { id: 'lago', label: 'Lagos' },
  { id: 'mirador', label: 'Miradores' },
  { id: 'pueblo', label: 'Pueblos' },
  { id: 'histórico', label: 'Historia' },
  { id: 'cultura', label: 'Cultura' },
  { id: 'río', label: 'Ríos' },
  { id: 'aventura', label: 'Aventura' },
  { id: 'gastronomía', label: 'Comida' },
];
---

<Layout title="Goz · El Salvador, un país chiquito, pero no te lo acabás.">
  <h1 class="sr-only">Goz: El Salvador, un país chiquito, pero no te lo acabás.</h1>

  <!-- El mapa ocupa toda la pantalla; todo lo demás flota encima. -->
  <main id="map" role="region" aria-label="Mapa de lugares turísticos"></main>
  <div id="mapLoading" class="map-loading"><GozLoader id="mapLoader" text="Buscando lugares…" size={58} /></div>

  <div class="searchbox" role="search">
    <a href="/" class="search-mark" aria-label="Goz, inicio"><GozMark size={18} simple id="search" /></a>
    <label for="searchInput" class="sr-only">Buscar lugar</label>
    <input type="search" id="searchInput" placeholder="Buscar volcanes, playas, pueblos…" autocomplete="off" />
    <button type="button" id="clearBtn" class="search-btn" aria-label="Cerrar" hidden>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
    <span id="searchIcon" class="search-btn search-go" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
    </span>
  </div>

  <!-- Cuenta: entrar con Google o ver el menú de la cuenta. -->
  <div class="account">
    <button type="button" id="accountBtn" class="account-btn" aria-haspopup="menu" aria-expanded="false">
      <span id="accountAvatar" class="account-avatar" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"></path></svg>
      </span>
      <span id="accountLabel" class="account-label">Entrar</span>
    </button>
    <div id="accountMenu" class="account-menu" role="menu" hidden>
      <p id="accountName" class="account-name"></p>
      <a href="/perfil" role="menuitem" class="account-item">Mi perfil e insignias</a>
      <a id="adminLink" href="/admin" role="menuitem" class="account-item" hidden>Panel de administrador</a>
      <button type="button" id="logoutBtn" role="menuitem" class="account-item">Salir</button>
      <p class="account-legal"><a href="/privacidad">Privacidad</a> · <a href="/terminos">Términos</a></p>
    </div>
  </div>

  <nav class="chips" aria-label="Categorías">
    {categories.map((c) => (
      <button type="button" class="chip" data-category={c.id} aria-pressed={c.id === 'all' ? 'true' : 'false'}>{c.label}</button>
    ))}
  </nav>


  <button type="button" id="listBtn" class="list-btn only-desktop">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"></path></svg>
    <span id="listBtnLabel">Ver lista</span>
  </button>

  <p id="hint" class="hint only-desktop">Tocá un punto para ver el lugar</p>

  <div class="map-controls">
    <button type="button" id="locateBtn" class="map-btn" aria-label="Lugares cerca de mí">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path></svg>
    </button>
    <div class="zoom only-desktop">
      <button type="button" id="zoomIn" class="map-btn" aria-label="Acercar">+</button>
      <button type="button" id="zoomOut" class="map-btn" aria-label="Alejar">−</button>
    </div>
  </div>

  <!-- Computadora: panel a la izquierda que solo aparece al abrir la lista o un lugar.
       Celular: hoja inferior con tres alturas (asomada, mitad, completa). -->
  <aside id="panel" class="panel" aria-label="Lugares" data-sheet="peek">
    <div id="sheetHead" class="sheet-head only-mobile">
      <button type="button" id="sheetToggle" class="sheet-toggle" aria-controls="panelBody" aria-expanded="false">
        <span class="grip" aria-hidden="true"></span>
        <span class="sr-only" id="sheetToggleLabel">Ver la lista</span>
      </button>
      <div class="peek" id="peek">
        <p class="peek-title" id="peekTitle">Cargando lugares…</p>
        <p class="peek-sub">Deslizá hacia arriba para ver la lista</p>
      </div>
    </div>
    <div id="panelBody" class="panel-body">
      <section id="listView">
        <div class="list-head">
          <div>
            <h2 class="list-title">Lugares para conocer</h2>
            <p id="resultCount" class="muted small" aria-live="polite">Cargando lugares…</p>
          </div>
          <button type="button" id="closeList" class="icon-btn only-desktop" aria-label="Cerrar lista">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
          </button>
        </div>
        <p id="emptyState" class="empty" hidden>Ningún lugar coincide. Probá con otra palabra o tocá “Todo”.</p>
        <p id="errorState" class="empty" hidden>No se pudieron cargar los lugares. Revisá tu conexión y recargá la página.</p>
        <ul id="placesList" class="place-list" aria-busy="true">
          {[0, 1, 2, 3, 4, 5].map((i) => (
            <li class="sk-row" aria-hidden="true"><span class="sk sk-thumb"></span><span class="sk-lines"><span class="sk" style={`width:${[70, 55, 80, 60, 75, 50][i]}%`}></span><span class="sk sk-sub"></span></span></li>
          ))}
        </ul>
        <p class="list-legal"><a href="/privacidad">Privacidad</a> · <a href="/terminos">Términos</a></p>
      </section>
      <section id="detailView" hidden aria-live="polite"></section>
    </div>
  </aside>

  <!-- Reseña: se escribe sin salir del mapa. Para publicar hay que entrar con Google. -->
  <dialog id="reviewDialog" class="review-dialog" aria-labelledby="reviewTitle">
    <span class="rv-grab" aria-hidden="true"></span>
    <div class="rv-head">
      <h2 id="reviewTitle" class="review-title">Tu reseña</h2>
      <button type="button" id="reviewClose" class="icon-btn" aria-label="Cerrar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>

    <section id="reviewLogin" class="review-body" hidden>
      <p class="review-lead">¿Y vos, ya fuiste? Entrá con tu cuenta de Google para contar tu visita y subir fotos.</p>
      <button type="button" id="reviewGoogle" class="btn btn-google">
        <svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.6-.4-3.9z"></path><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"></path><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"></path><path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z"></path></svg>
        Entrar con Google
      </button>
      <p id="reviewLoginError" class="form-error" hidden></p>
      <p class="legal-note">Al publicar aceptás los <a href="/terminos" target="_blank" rel="noopener">Términos</a> y la <a href="/privacidad" target="_blank" rel="noopener">Política de privacidad</a>.</p>
    </section>

    <form id="reviewForm" class="review-body" novalidate hidden>
      <fieldset class="stars-field">
        <legend class="sr-only">Tu calificación</legend>
        <div class="stars" id="starsGroup">
          {[1, 2, 3, 4, 5].map((n) => (
            <button type="button" class="star-pick" data-rating={n} aria-pressed="false" aria-label={`${n} de 5`}>
              <svg width="40" height="40" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.8l2.8 5.7 6.3.9-4.6 4.4 1.1 6.3L12 17.1l-5.6 3 1.1-6.3-4.6-4.4 6.3-.9z"></path></svg>
            </button>
          ))}
          <span id="starLabel" class="star-label" aria-live="polite">Tocá una estrella</span>
        </div>
      </fieldset>

      <div class="field">
        <label for="reviewComment" class="field-label">Contá tu visita</label>
        <textarea id="reviewComment" rows="4" maxlength="1000" aria-describedby="commentCount" placeholder="Qué hiciste, cuándo conviene ir, qué llevar…"></textarea>
        <p id="commentCount" class="field-help field-count">Mínimo 10 letras · 0 de 1000</p>
      </div>

      <div class="field">
        <span class="field-label" id="photosLabel">Fotos <span class="field-opt">(opcional)</span></span>
        <div class="rv-photos" role="group" aria-labelledby="photosLabel">
          <div id="reviewPhotos" class="photo-picks"></div>
          <label class="dropzone" id="photoAdd">
            <span class="dz-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h3l2-3h6l2 3h3v11H4z"></path><circle cx="12" cy="13" r="3.5"></circle></svg></span>
            <span class="dz-text"><strong id="dzTitle">Agregá fotos de tu visita</strong><span id="dzSub">Arrastralas aquí o tocá para elegir</span></span>
            <input type="file" id="reviewPhotoInput" accept="image/*" multiple class="sr-only" />
          </label>
        </div>
      </div>

      <div class="rv-details">
        <div class="field rv-date">
          <label for="reviewDate" class="field-label">¿Cuándo fuiste?</label>
          <input type="date" id="reviewDate" />
        </div>
        <div class="field rv-verify">
          <span class="field-label">¿Estás ahí ahorita?</span>
          <button type="button" id="verifyBtn" class="verify-chip" aria-describedby="verifyStatus">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0114 0c0 4.8-7 11-7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
            <span id="verifyText">Verificar mi visita</span>
          </button>
        </div>
      </div>
      <p id="verifyStatus" class="field-help rv-verify-help" aria-live="polite"></p>

      <div class="review-actions">
        <p id="reviewError" class="form-error" role="alert" hidden></p>
        <button type="submit" id="reviewSubmit" class="btn btn-primary">Publicar reseña</button>
        <p class="rv-as"><span id="reviewAsAvatar" class="rv-as-avatar" aria-hidden="true"></span>Se publica como <strong id="reviewAs"></strong></p>
      </div>
    </form>

    <section id="reviewDone" class="review-body" hidden>
      <p class="review-lead"><strong>¡Gracias!</strong> Tu reseña ya está publicada.</p>
      <button type="button" id="reviewDoneBtn" class="btn btn-primary">Listo</button>
    </section>
  </dialog>

  <!-- Visor de fotos: se pasan con flechas, teclado o deslizando. -->
  <dialog id="lightbox" class="lightbox" aria-label="Fotos">
    <div class="lb-top">
      <span id="lbCount" class="lb-count" aria-live="polite"></span>
      <span class="lb-actions">
      <button type="button" id="lbReport" class="lb-btn lb-report" hidden aria-label="Reportar esta foto" title="Reportar esta foto">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 21V4M5 4h11l-2 4 2 4H5"></path></svg>
      </button>
      <button type="button" id="lbClose" class="lb-btn" aria-label="Cerrar">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
      </span>
    </div>
    <div class="lb-stage" id="lbStage">
      <button type="button" id="lbPrev" class="lb-btn lb-nav lb-prev" aria-label="Foto anterior">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
      </button>
      <img id="lbImg" class="lb-img" alt="">
      <button type="button" id="lbNext" class="lb-btn lb-nav lb-next" aria-label="Foto siguiente">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"></path></svg>
      </button>
    </div>
    <div class="lb-foot">
      <a id="lbWho" class="lb-who" hidden>
        <span id="lbAvatar" class="lb-avatar" aria-hidden="true"></span>
        <span class="lb-who-txt"><small>Foto de</small><strong id="lbName"></strong></span>
      </a>
      <p id="lbCap" class="lb-cap"></p>
      <button type="button" id="lbVote" class="lb-vote" hidden aria-pressed="false">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.5-9.3C1.2 8.4 3.3 5 6.8 5c2 0 3.5 1.1 5.2 3 1.7-1.9 3.2-3 5.2-3 3.5 0 5.6 3.4 4.3 6.7C19.5 16.4 12 21 12 21z"></path></svg>
        <span id="lbVoteTxt"></span>
      </button>
    </div>
  </dialog>

  <!-- Antes de publicar por primera vez: aceptar privacidad, términos y transferencia de datos. -->
  <dialog id="consentDialog" class="report-dialog" aria-labelledby="consentTitle">
    <form id="consentForm" method="dialog" novalidate>
      <div class="rp-head">
        <h2 id="consentTitle" class="rp-title">Antes de publicar</h2>
        <button type="button" id="consentClose" class="icon-btn" aria-label="Cerrar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
        </button>
      </div>
      <p class="rp-lead">Tu nombre, tu foto de Google y lo que publiqués se van a ver en Goz. Tu correo no. Lo pedimos una sola vez.</p>
      <div class="consent-list">
        <label class="consent-item"><input type="checkbox" data-consent><span>Leí y acepto la <a href="/privacidad" target="_blank" rel="noopener">Política de privacidad</a> y los <a href="/terminos" target="_blank" rel="noopener">Términos de uso</a>.</span></label>
        <label class="consent-item"><input type="checkbox" data-consent><span>Acepto que mis datos se guarden en servidores fuera de El Salvador (Google, Cloudinary y Render, en Estados Unidos).</span></label>
        <label class="consent-item"><input type="checkbox" data-consent><span>Tengo 18 años o más, o tengo permiso de mi mamá, papá o encargado.</span></label>
      </div>
      <p id="consentError" class="form-error" role="alert" hidden></p>
      <div class="rp-actions">
        <button type="button" id="consentCancel" class="rp-btn rp-btn-ghost">Ahora no</button>
        <button type="submit" id="consentOk" class="rp-btn rp-btn-primary">Aceptar y seguir</button>
      </div>
    </form>
  </dialog>

  <!-- Reportar una reseña o una foto: le llega al admin. -->
  <dialog id="reportDialog" class="report-dialog" aria-labelledby="reportTitle">
    <form id="reportForm" method="dialog" novalidate>
      <div class="rp-head">
        <h2 id="reportTitle" class="rp-title">¿Qué pasa con esta reseña?</h2>
        <button type="button" id="reportClose" class="icon-btn" aria-label="Cerrar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
        </button>
      </div>
      <p class="rp-lead">Lo revisamos y, si no cumple, lo quitamos. Quien la publicó no sabe que fuiste vos.</p>
      <fieldset class="rp-options">
        <legend class="sr-only">Motivo</legend>
        <label><input type="radio" name="reason" value="falsa"><span>Es falsa o no pasó así</span></label>
        <label><input type="radio" name="reason" value="ofensiva"><span>Tiene insultos o es ofensiva</span></label>
        <label><input type="radio" name="reason" value="otro-lugar"><span>No es de este lugar</span></label>
        <label><input type="radio" name="reason" value="spam"><span>Es publicidad o spam</span></label>
        <label><input type="radio" name="reason" value="datos"><span>Muestra datos personales de alguien</span></label>
        <label><input type="radio" name="reason" value="otra"><span>Otra cosa</span></label>
      </fieldset>
      <label for="reportNote" class="field-label">Contanos más <span class="field-opt">(opcional)</span></label>
      <textarea id="reportNote" rows="2" maxlength="300" placeholder="Lo que nos ayude a revisarlo"></textarea>
      <p id="reportError" class="form-error" role="alert" hidden></p>
      <div class="rp-actions">
        <button type="button" id="reportCancel" class="rp-btn rp-btn-ghost">Cancelar</button>
        <button type="submit" id="reportSubmit" class="rp-btn rp-btn-primary">Enviar reporte</button>
      </div>
    </form>
    <div id="reportDone" class="rp-done" hidden>
      <h2 class="rp-title">Gracias por avisar</h2>
      <p class="rp-lead">Ya nos llegó. Lo revisamos en estos días.</p>
      <div class="rp-actions"><button type="button" id="reportOk" class="rp-btn rp-btn-primary">Listo</button></div>
    </div>
  </dialog>
</Layout>

<style is:global>
  .sr-only { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  #map { position: fixed; inset: 0; z-index: 0; }

  /* ---------- Buscador flotante ---------- */
  .searchbox { position: fixed; z-index: 1100; top: 16px; left: 16px; width: 376px; height: 52px; box-sizing: border-box; display: flex; align-items: center; gap: 8px; padding: 0 8px; background: var(--surface); border-radius: 26px; box-shadow: 0 2px 10px rgba(20,48,47,0.2); transition: background .2s, box-shadow .2s; }
  .searchbox:focus-within { box-shadow: 0 0 0 3px var(--turquesa), 0 2px 10px rgba(20,48,47,0.2); }
  body.panel-open .searchbox { background: var(--neblina); box-shadow: none; }
  .search-mark { width: 36px; height: 36px; border-radius: 18px; background: var(--plumaje); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .searchbox input { flex: 1; min-width: 0; border: 0; background: transparent; font-size: 16px; font-weight: 600; color: var(--ink); outline: none; }
  .searchbox input::placeholder { color: var(--muted); font-weight: 600; }
  .searchbox input::-webkit-search-cancel-button { display: none; }
  .search-btn { width: 40px; height: 40px; border-radius: 20px; border: 0; background: transparent; color: var(--muted); display: flex; align-items: center; justify-content: center; flex-shrink: 0; cursor: pointer; }
  .search-go { background: var(--turquesa); color: #FFFFFF; cursor: default; }
  .search-btn[hidden] { display: none; }

  /* ---------- Categorías ---------- */
  .chips { position: fixed; z-index: 1000; top: 22px; left: 408px; right: 140px; display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding: 4px 24px 4px 4px; margin: -4px; -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent); mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent); }
  .chips::-webkit-scrollbar { display: none; }
  .chip { flex-shrink: 0; height: 40px; padding: 0 16px; border-radius: 20px; border: 0; background: var(--surface); color: var(--ink); font-size: 14px; font-weight: 700; cursor: pointer; box-shadow: 0 1px 6px rgba(20,48,47,0.2); white-space: nowrap; }
  .chip:hover { background: var(--neblina); }
  .chip[aria-pressed="true"] { background: var(--rama); color: #FFFFFF; }
  /* ---------- Cuenta ---------- */
  .account { position: fixed; z-index: 1100; top: 22px; right: 16px; }
  .account-btn { height: 40px; padding: 0 14px 0 4px; border: 0; border-radius: 20px; background: var(--surface); color: var(--ink); display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 800; cursor: pointer; box-shadow: 0 1px 6px rgba(20,48,47,0.2); }
  .account-avatar { width: 32px; height: 32px; border-radius: 16px; background: var(--neblina); color: var(--turquesa); display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0; }
  .account-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .account-menu { position: absolute; right: 0; top: 48px; min-width: 220px; padding: 8px; border-radius: 16px; background: var(--surface); box-shadow: 0 8px 24px rgba(20,48,47,0.22); display: flex; flex-direction: column; }
  .account-menu[hidden] { display: none; }
  .account-name { margin: 4px 8px 8px; font-size: 14px; font-weight: 800; color: var(--ink); }
  .account-item { display: flex; align-items: center; height: 44px; padding: 0 10px; border: 0; border-radius: 10px; background: transparent; color: var(--ink); font-size: 15px; font-weight: 700; text-decoration: none; text-align: left; cursor: pointer; }
  .account-item:hover { background: var(--neblina); }
  .account-item[hidden] { display: none; }

  /* ---------- Reseña ---------- */
  /* El reset de Tailwind quita el margin:auto del <dialog>: se devuelve para que quede centrado. */
  .review-dialog { margin: auto; width: min(540px, calc(100vw - 32px)); max-height: min(760px, calc(100vh - 48px)); padding: 0; border: 0; border-radius: 24px; background: var(--surface); color: var(--ink); box-shadow: 0 24px 70px rgba(20,48,47,0.32); overflow: auto; overscroll-behavior: contain; }
  .review-dialog[open] { animation: rv-in .18s ease-out; }
  @keyframes rv-in { from { opacity: 0; transform: translateY(8px) scale(.985); } }
  @media (prefers-reduced-motion: reduce) { .review-dialog[open] { animation: none; } }
  .rv-grab { display: none; }
  .rv-head { position: sticky; top: 0; z-index: 3; display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 20px 20px 8px 24px; background: var(--surface); }
  .review-dialog::backdrop { background: rgba(20,48,47,0.45); }
  .review-title:focus { outline: none; }
  /* El botón de publicar queda siempre a la vista, aunque el formulario sea largo. */
  .review-actions { position: sticky; bottom: 0; z-index: 2; margin: 4px -24px -24px; padding: 14px 24px 18px; background: var(--surface); border-top: 1px solid var(--line); }
  .review-title { margin: 6px 0 0; font-family: var(--font-display); font-weight: 800; font-size: 26px; line-height: 1.12; text-wrap: balance; }
  .review-body { display: flex; flex-direction: column; gap: 20px; padding: 4px 24px 24px; }
  .review-body[hidden] { display: none; }
  .review-lead { margin: 0; font-size: 16px; line-height: 1.5; color: var(--ink-2); }
  .btn-google { background: var(--surface); color: var(--ink); border: 2px solid var(--line); align-self: flex-start; }
  .btn-sm { height: 40px; padding: 0 16px; font-size: 14px; }
  .stars-field { border: 0; margin: 0; padding: 0; }
  .field-label { display: block; margin: 0 0 6px; padding: 0; font-size: 14px; font-weight: 800; color: var(--ink); }
  /* Las estrellas son lo principal: grandes, con una palabra que dice qué significa cada una. */
  .stars { display: flex; align-items: center; gap: 2px; flex-wrap: wrap; }
  .star-pick { width: 48px; height: 48px; padding: 0; border: 0; border-radius: 14px; background: transparent; cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .star-pick svg { fill: #E4ECEA; stroke: #C6D6D3; stroke-width: 1; transition: fill .12s, stroke .12s, transform .12s; }
  .star-pick.is-on svg, .stars.is-preview .star-pick.is-hint svg { fill: var(--plumaje); stroke: #C9971E; }
  .stars.is-preview .star-pick:not(.is-hint) svg { fill: #E4ECEA; stroke: #C6D6D3; }
  .star-pick:hover svg { transform: scale(1.08); }
  .star-pick:focus-visible { outline: 3px solid var(--turquesa); outline-offset: 1px; }
  .star-label { margin-left: 10px; font-family: var(--font-display); font-weight: 800; font-size: 18px; color: var(--muted); }
  .star-label.is-set { color: var(--rama); }
  @media (prefers-reduced-motion: reduce) { .star-pick svg { transition: none; } .star-pick:hover svg { transform: none; } }
  .field { display: flex; flex-direction: column; min-width: 0; }
  .field-row { display: flex; flex-wrap: wrap; gap: 16px; }
  .field-row .field { flex: 1 1 180px; }
  .field textarea, .field input[type="date"] { width: 100%; box-sizing: border-box; border: 1.5px solid var(--border); border-radius: 14px; padding: 12px 14px; font: inherit; font-size: 16px; color: var(--ink); background: var(--surface); }
  .field textarea:focus, .field input[type="date"]:focus { outline: none; border-color: var(--turquesa); box-shadow: 0 0 0 3px rgba(14,124,123,0.18); }
  .field-opt { font-weight: 600; color: var(--muted); }
  .rv-details { display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-end; }
  .rv-date { flex: 1 1 250px; }
  .rv-verify { flex: 1 1 190px; }
  .rv-verify-help { margin: -12px 0 0; }
  .rv-verify-help:empty { display: none; }
  .verify-chip { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 48px; padding: 0 16px; border-radius: 14px; border: 1.5px dashed #9CC3C0; background: #F1F8F7; color: var(--turquesa); font: inherit; font-size: 15px; font-weight: 800; cursor: pointer; }
  .verify-chip:hover { border-style: solid; }
  .verify-chip.is-ok { border: 1.5px solid var(--turquesa); background: var(--turquesa); color: #FFFFFF; cursor: default; }
  .verify-chip:focus-visible { outline: 3px solid var(--turquesa); outline-offset: 2px; }
  .field textarea { resize: vertical; line-height: 1.5; }
  .field-help { margin: 6px 0 0; font-size: 13px; color: var(--muted); }
  .field-help.is-ok { color: var(--turquesa); font-weight: 800; }
  .field-count { margin: 4px 0 0; text-align: right; }
  #reviewForm [aria-invalid="true"] { border-color: #C2581F; box-shadow: 0 0 0 3px rgba(194,88,31,0.18); }
  .form-error { margin: 0; padding: 10px 12px; border-radius: 10px; background: #F6D9C8; color: #6E2E0C; font-size: 14px; font-weight: 700; }
  .form-error[hidden] { display: none; }
  .rv-photos { display: flex; flex-direction: column; gap: 10px; }
  .photo-picks { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .photo-picks:empty { display: none; }
  .photo-pick { position: relative; aspect-ratio: 1; }
  .photo-pick img { width: 100%; height: 100%; object-fit: cover; border-radius: 14px; display: block; }
  .photo-pick button { position: absolute; top: -8px; right: -8px; width: 28px; height: 28px; border-radius: 14px; border: 2px solid #FFFFFF; background: var(--rama); color: #FFFFFF; font-size: 14px; line-height: 1; cursor: pointer; }
  .photo-pick.is-loading { background: var(--photo); border-radius: 14px; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; font-size: 12px; color: var(--muted); }
  /* Zona para soltar fotos: ocupa todo el ancho; se achica cuando ya hay fotos. */
  .rv-as { margin: 2px 0 0; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--muted); }
  .rv-as strong { color: var(--ink); }
  .rv-as-avatar { width: 22px; height: 22px; border-radius: 11px; overflow: hidden; flex-shrink: 0; background: var(--plumaje); color: var(--rama); font-size: 11px; font-weight: 800; display: flex; align-items: center; justify-content: center; }
  .rv-as-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .review-actions { display: flex; flex-direction: column; gap: 4px; align-items: flex-start; }
  .review-actions .btn { align-self: stretch; }
  .review-actions .form-error { align-self: stretch; margin-bottom: 6px; }
  .verified { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 800; color: var(--turquesa); }
  .review-avatar { width: 28px; height: 28px; border-radius: 14px; object-fit: cover; background: #FDF1D3; color: #6B4E0A; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 800; }
  .review-who { display: flex; align-items: center; gap: 8px; min-width: 0; }
  a.review-who { color: inherit; text-decoration: none; border-radius: 20px; margin: -4px; padding: 4px 10px 4px 4px; }
  a.review-who:hover strong { text-decoration: underline; text-underline-offset: 3px; color: var(--primary); }
  a.review-who:focus-visible { outline: 3px solid var(--primary); outline-offset: 1px; }
  .cover-credit a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .cover-credit a:hover { color: var(--plumaje); }

  /* ---------- Botones sobre el mapa ---------- */
  .list-btn { position: fixed; z-index: 1000; left: 16px; bottom: 24px; height: 48px; padding: 0 20px 0 16px; border: 0; border-radius: 24px; background: var(--rama); color: #FFFFFF; display: flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 800; cursor: pointer; box-shadow: 0 4px 14px rgba(20,48,47,0.3); }
  .list-btn svg { color: var(--plumaje); }
  body.panel-open .list-btn, body.panel-open .hint { display: none !important; }
  .hint { position: fixed; z-index: 900; left: 50%; bottom: 28px; transform: translateX(-50%); margin: 0; height: 40px; padding: 0 18px; border-radius: 20px; background: rgba(255,255,255,0.94); display: flex; align-items: center; font-size: 14px; font-weight: 700; color: var(--muted); box-shadow: 0 1px 6px rgba(20,48,47,0.16); pointer-events: none; transition: opacity .3s; }
  .hint.is-gone { opacity: 0; }
  .map-controls { position: fixed; z-index: 1000; right: 16px; bottom: 24px; display: flex; flex-direction: column; gap: 10px; align-items: center; }
  .zoom { display: flex; flex-direction: column; border-radius: 24px; overflow: hidden; box-shadow: 0 2px 8px rgba(20,48,47,0.22); }
  .zoom .map-btn { box-shadow: none; border-radius: 0; }
  .zoom .map-btn + .map-btn { border-top: 1px solid var(--line); }
  .map-btn { width: 48px; height: 48px; border-radius: 24px; border: 0; background: var(--surface); color: var(--turquesa); font-size: 22px; font-weight: 700; line-height: 1; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 0 2px 8px rgba(20,48,47,0.22); }
  .zoom .map-btn { color: var(--ink); }

  /* ---------- Panel (computadora) ---------- */
  .panel { position: fixed; z-index: 1050; top: 0; left: 0; bottom: 0; width: 408px; display: flex; flex-direction: column; background: var(--surface); box-shadow: 2px 0 16px rgba(20,48,47,0.16); transform: translateX(-105%); transition: transform .25s ease; }
  body.panel-open .panel { transform: none; }
  .panel-body { flex: 1; min-height: 0; overflow-y: auto; padding: 84px 20px 32px; overscroll-behavior: contain; }
  body.panel-open .chips { left: 424px; }
  @media (min-width: 768px) {
    /* Franja fija arriba del panel: el buscador flota encima y el contenido no pasa por debajo. */
    .panel::before { content: ""; flex: 0 0 84px; }
    .panel-body { padding-top: 0; }
  }

  .list-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 4px; }
  .list-title { margin: 4px 0 0; font-family: var(--font-display); font-weight: 800; font-size: 24px; line-height: 1.1; color: var(--ink); }
  .icon-btn { width: 44px; height: 44px; border-radius: 22px; border: 0; background: var(--neblina); color: var(--muted); display: inline-flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; }
  .muted { color: var(--muted); }
  .small { font-size: 14px; margin: 4px 0 8px; }
  .empty { margin: 16px 0; font-size: 15px; line-height: 1.5; color: var(--ink-2); }

  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 46px; padding: 0 20px; border-radius: 23px; font-size: 15px; font-weight: 800; text-decoration: none; cursor: pointer; border: 2px solid transparent; white-space: nowrap; box-sizing: border-box; }
  .btn-primary { background: var(--primary); color: var(--on-primary); }
  .btn-outline { background: transparent; color: var(--link); border-color: var(--link); }

  .place-list { list-style: none; margin: 0; padding: 0; }
  .sk-row { display: flex; align-items: center; gap: 12px; padding: 8px 0; }
