<script>
  import { collection, getDocs, getDoc, addDoc, doc, updateDoc, increment, serverTimestamp, query, where, writeBatch } from 'firebase/firestore';
  import { signInWithPopup, signOut, onAuthStateChanged } from 'firebase/auth';
