  .coupon-code span { font-size: 12px; color: var(--muted); }
  .promo-banner { margin: 12px 0 0; padding: 10px 12px; border-radius: 12px; background: #FDF1D3; color: var(--rama); font-size: 14px; }
  .cover { margin: 0; position: relative; }
  .cover-credit { position: absolute; left: 10px; bottom: 10px; padding: 4px 10px; border-radius: 12px; background: rgba(20,48,47,0.78); color: #FFFFFF; font-size: 12px; font-weight: 800; }
  .section-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 28px; }
