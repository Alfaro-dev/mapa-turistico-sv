  #reportError { margin-top: 10px; }
  .photo-cell a, .review-photos a, .gallery a { cursor: zoom-in; }
  .photo-more { padding: 0; border: 0; background: none; cursor: pointer; position: relative; border-radius: 10px; overflow: hidden; }
