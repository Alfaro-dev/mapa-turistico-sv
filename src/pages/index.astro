  .biz-pin { width: 26px; height: 26px; box-sizing: border-box; border-radius: 9px; background: var(--surface); color: var(--canela); border: 2px solid var(--canela); display: flex; align-items: center; justify-content: center; box-shadow: 0 1px 4px rgba(0,0,0,0.3); }
