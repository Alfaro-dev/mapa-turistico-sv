  .biz-promo { font-size: 13px; font-weight: 700; color: #8A3A10; }
  .tag-featured { display: inline-block; vertical-align: middle; margin-left: 4px; padding: 2px 8px; border-radius: 10px; background: var(--plumaje); color: var(--rama); font-size: 11px; font-weight: 800; }
  .coupons { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .coupon { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; padding: 14px; border-radius: 14px; border: 2px dashed var(--canela); background: #FFF8F2; }
  .coupon-main { flex: 1 1 200px; min-width: 0; }
