---
import Layout from '../layouts/Layout.astro';
import GozMark from '../components/GozMark.astro';

const categories = [
  { id: 'all', label: 'Todo' },
  { id: 'montaña', label: 'Volcanes' },
  { id: 'playa', label: 'Playas' },
  { id: 'lago', label: 'Lagos' },
  { id: 'histórico', label: 'Historia' },
  { id: 'cultura', label: 'Cultura' },
  { id: 'río', label: 'Ríos' },
  { id: 'aventura', label: 'Aventura' },
  { id: 'gastronomía', label: 'Comida' },
];
---

<Layout title="Goz · El Salvador, un país chiquito, pero no te lo acabás.">
  <h1 class="sr-only">Goz: El Salvador, un país chiquito, pero no te lo acabás.</h1>

  <!-- El mapa ocupa toda la pantalla; todo lo demás flota encima. -->
  <main id="map" role="region" aria-label="Mapa de lugares turísticos"></main>

  <div class="searchbox" role="search">
    <a href="/" class="search-mark" aria-label="Goz, inicio"><GozMark size={18} simple id="search" /></a>
    <label for="searchInput" class="sr-only">Buscar lugar</label>
    <input type="search" id="searchInput" placeholder="Buscar volcanes, playas, pueblos…" autocomplete="off" />
    <button type="button" id="clearBtn" class="search-btn" aria-label="Cerrar" hidden>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
    <span id="searchIcon" class="search-btn search-go" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
    </span>
  </div>

  <nav class="chips" aria-label="Categorías">
    {categories.map((c) => (
      <button type="button" class="chip" data-category={c.id} aria-pressed={c.id === 'all' ? 'true' : 'false'}>{c.label}</button>
    ))}
  </nav>

  <a href="/admin" class="login-pill only-desktop">Iniciar sesión</a>

  <button type="button" id="listBtn" class="list-btn only-desktop">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"></path></svg>
    <span id="listBtnLabel">Ver lista</span>
  </button>

  <p id="hint" class="hint only-desktop">Tocá un punto para ver el lugar</p>

  <div class="map-controls">
    <button type="button" id="locateBtn" class="map-btn" aria-label="Lugares cerca de mí">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path></svg>
    </button>
    <div class="zoom only-desktop">
      <button type="button" id="zoomIn" class="map-btn" aria-label="Acercar">+</button>
      <button type="button" id="zoomOut" class="map-btn" aria-label="Alejar">−</button>
    </div>
  </div>

  <!-- Computadora: panel a la izquierda que solo aparece al abrir la lista o un lugar.
       Celular: hoja inferior con tres alturas (asomada, mitad, completa). -->
  <aside id="panel" class="panel" aria-label="Lugares" data-sheet="peek">
    <div id="sheetHead" class="sheet-head only-mobile">
      <button type="button" id="sheetToggle" class="sheet-toggle" aria-controls="panelBody" aria-expanded="false">
        <span class="grip" aria-hidden="true"></span>
        <span class="sr-only" id="sheetToggleLabel">Ver la lista</span>
      </button>
      <div class="peek" id="peek">
        <p class="peek-title" id="peekTitle">Cargando lugares…</p>
        <p class="peek-sub">Deslizá hacia arriba para ver la lista</p>
      </div>
    </div>
    <div id="panelBody" class="panel-body">
      <section id="listView">
        <div class="list-head">
          <div>
            <h2 class="list-title">Lugares para conocer</h2>
            <p id="resultCount" class="muted small" aria-live="polite">Cargando lugares…</p>
          </div>
          <button type="button" id="closeList" class="icon-btn only-desktop" aria-label="Cerrar lista">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
          </button>
        </div>
        <p id="emptyState" class="empty" hidden>Ningún lugar coincide. Probá con otra palabra o elegí “Todo”.</p>
        <p id="errorState" class="empty" hidden>No se pudieron cargar los lugares. Revisá tu conexión y recargá la página.</p>
        <ul id="placesList" class="place-list"></ul>
      </section>
      <section id="detailView" hidden aria-live="polite"></section>
    </div>
  </aside>
</Layout>

<style is:global>
  .sr-only { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  #map { position: fixed; inset: 0; z-index: 0; }

  /* ---------- Buscador flotante ---------- */
  .searchbox { position: fixed; z-index: 1100; top: 16px; left: 16px; width: 376px; height: 52px; box-sizing: border-box; display: flex; align-items: center; gap: 8px; padding: 0 8px; background: var(--surface); border-radius: 26px; box-shadow: 0 2px 10px rgba(20,48,47,0.2); transition: background .2s, box-shadow .2s; }
  .searchbox:focus-within { box-shadow: 0 0 0 3px var(--turquesa), 0 2px 10px rgba(20,48,47,0.2); }
  body.panel-open .searchbox { background: var(--neblina); box-shadow: none; }
  .search-mark { width: 36px; height: 36px; border-radius: 18px; background: var(--plumaje); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .searchbox input { flex: 1; min-width: 0; border: 0; background: transparent; font-size: 16px; font-weight: 600; color: var(--ink); outline: none; }
  .searchbox input::placeholder { color: var(--muted); font-weight: 600; }
  .searchbox input::-webkit-search-cancel-button { display: none; }
  .search-btn { width: 40px; height: 40px; border-radius: 20px; border: 0; background: transparent; color: var(--muted); display: flex; align-items: center; justify-content: center; flex-shrink: 0; cursor: pointer; }
  .search-go { background: var(--turquesa); color: #FFFFFF; cursor: default; }
  .search-btn[hidden] { display: none; }

  /* ---------- Categorías ---------- */
  .chips { position: fixed; z-index: 1000; top: 22px; left: 408px; right: 150px; display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding: 4px 24px 4px 4px; margin: -4px; -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent); mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent); }
  .chips::-webkit-scrollbar { display: none; }
  .chip { flex-shrink: 0; height: 40px; padding: 0 16px; border-radius: 20px; border: 0; background: var(--surface); color: var(--ink); font-size: 14px; font-weight: 700; cursor: pointer; box-shadow: 0 1px 6px rgba(20,48,47,0.2); white-space: nowrap; }
  .chip:hover { background: var(--neblina); }
  .chip[aria-pressed="true"] { background: var(--rama); color: #FFFFFF; }
  .login-pill { position: fixed; z-index: 1000; top: 22px; right: 16px; height: 40px; padding: 0 16px; border-radius: 20px; background: var(--surface); color: var(--ink); font-size: 14px; font-weight: 700; text-decoration: none; display: flex; align-items: center; box-shadow: 0 1px 6px rgba(20,48,47,0.2); }

  /* ---------- Botones sobre el mapa ---------- */
  .list-btn { position: fixed; z-index: 1000; left: 16px; bottom: 24px; height: 48px; padding: 0 20px 0 16px; border: 0; border-radius: 24px; background: var(--rama); color: #FFFFFF; display: flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 800; cursor: pointer; box-shadow: 0 4px 14px rgba(20,48,47,0.3); }
  .list-btn svg { color: var(--plumaje); }
  body.panel-open .list-btn, body.panel-open .hint { display: none !important; }
  .hint { position: fixed; z-index: 900; left: 50%; bottom: 28px; transform: translateX(-50%); margin: 0; height: 40px; padding: 0 18px; border-radius: 20px; background: rgba(255,255,255,0.94); display: flex; align-items: center; font-size: 14px; font-weight: 700; color: var(--muted); box-shadow: 0 1px 6px rgba(20,48,47,0.16); pointer-events: none; transition: opacity .3s; }
  .hint.is-gone { opacity: 0; }
  .map-controls { position: fixed; z-index: 1000; right: 16px; bottom: 24px; display: flex; flex-direction: column; gap: 10px; align-items: center; }
  .zoom { display: flex; flex-direction: column; border-radius: 24px; overflow: hidden; box-shadow: 0 2px 8px rgba(20,48,47,0.22); }
  .zoom .map-btn { box-shadow: none; border-radius: 0; }
  .zoom .map-btn + .map-btn { border-top: 1px solid var(--line); }
  .map-btn { width: 48px; height: 48px; border-radius: 24px; border: 0; background: var(--surface); color: var(--turquesa); font-size: 22px; font-weight: 700; line-height: 1; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 0 2px 8px rgba(20,48,47,0.22); }
  .zoom .map-btn { color: var(--ink); }

  /* ---------- Panel (computadora) ---------- */
  .panel { position: fixed; z-index: 1050; top: 0; left: 0; bottom: 0; width: 408px; display: flex; flex-direction: column; background: var(--surface); box-shadow: 2px 0 16px rgba(20,48,47,0.16); transform: translateX(-105%); transition: transform .25s ease; }
  body.panel-open .panel { transform: none; }
  .panel-body { flex: 1; min-height: 0; overflow-y: auto; padding: 84px 20px 32px; overscroll-behavior: contain; }
  body.panel-open .chips { left: 424px; }

  .list-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 4px; }
  .list-title { margin: 4px 0 0; font-family: var(--font-display); font-weight: 800; font-size: 24px; line-height: 1.1; color: var(--ink); }
  .icon-btn { width: 44px; height: 44px; border-radius: 22px; border: 0; background: var(--neblina); color: var(--muted); display: inline-flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; }
  .muted { color: var(--muted); }
  .small { font-size: 14px; margin: 4px 0 8px; }
  .empty { margin: 16px 0; font-size: 15px; line-height: 1.5; color: var(--ink-2); }

  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 46px; padding: 0 20px; border-radius: 23px; font-size: 15px; font-weight: 800; text-decoration: none; cursor: pointer; border: 2px solid transparent; white-space: nowrap; box-sizing: border-box; }
  .btn-primary { background: var(--primary); color: var(--on-primary); }
  .btn-outline { background: transparent; color: var(--link); border-color: var(--link); }

  .place-list { list-style: none; margin: 0; padding: 0; }
  .place-row { width: 100%; display: flex; align-items: center; gap: 12px; padding: 8px; margin: 0 -8px; border: 0; background: transparent; color: var(--ink); text-align: left; cursor: pointer; border-radius: 12px; box-sizing: content-box; }
  .place-row:hover { background: var(--neblina); }
  .place-thumb { width: 56px; height: 56px; border-radius: 12px; object-fit: cover; flex-shrink: 0; background: var(--photo); }
  .place-name { margin: 0; font-size: 16px; font-weight: 800; line-height: 1.25; }
  .place-meta { margin: 2px 0 0; font-size: 14px; font-weight: 600; color: var(--muted); }
  .place-rating { margin-left: auto; font-size: 14px; color: var(--ink-2); white-space: nowrap; display: flex; align-items: center; gap: 4px; }

  .back-btn { display: inline-flex; align-items: center; gap: 6px; height: 40px; padding: 0 4px; margin: 0 0 8px -4px; border: 0; background: transparent; color: var(--link); font-size: 15px; font-weight: 700; cursor: pointer; }
  .detail-photo { width: 100%; height: 196px; border-radius: 16px; object-fit: cover; background: var(--photo); display: block; }
  .detail-title { margin: 16px 0 0; font-family: var(--font-display); font-weight: 800; font-size: 30px; line-height: 1.08; color: var(--ink); }
  .detail-kicker { margin: 4px 0 0; font-size: 14px; font-weight: 600; color: var(--muted); }
  .rating-line { margin: 8px 0 0; display: flex; align-items: center; gap: 6px; font-size: 15px; color: var(--ink-2); }
  .rating-line strong { color: var(--ink); }
  .rating-line.is-empty { color: var(--star); font-weight: 700; font-size: 14px; }
  .star { color: var(--star); }
  .detail-actions { display: flex; gap: 8px; margin: 16px 0 0; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
  .detail-actions .btn { flex: 1; }
  .detail-desc { margin: 16px 0 0; font-size: 15px; line-height: 1.6; color: var(--ink-2); }
  .detail-facts { margin: 12px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 8px; font-size: 15px; color: var(--ink-2); }
  .detail-facts li { display: flex; gap: 10px; align-items: center; }
  .detail-facts svg { color: var(--turquesa); flex-shrink: 0; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
  .tag { font-size: 13px; font-weight: 600; padding: 5px 10px; border-radius: 14px; background: var(--neblina); color: var(--ink-2); }
  .gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; margin-top: 14px; }
  .gallery img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px; display: block; }
  .section-title { margin: 28px 0 8px; font-family: var(--font-display); font-size: 20px; font-weight: 800; color: var(--ink); }
  .review { padding: 12px 0; border-top: 1px solid var(--line); }
  .review-head { display: flex; justify-content: space-between; gap: 8px; font-size: 15px; }
  .review-head strong { color: var(--ink); }
  .review-date { margin: 2px 0 0; font-size: 13px; color: var(--muted); }
  .review-text { margin: 6px 0 0; font-size: 15px; line-height: 1.55; color: var(--ink-2); }
  .review-photos { display: flex; gap: 6px; margin-top: 8px; }
  .review-photos img { width: 72px; height: 54px; object-fit: cover; border-radius: 6px; }
  .near-row { width: 100%; display: flex; justify-content: space-between; gap: 12px; padding: 12px 0; border: 0; border-top: 1px solid var(--line); background: transparent; color: var(--ink); font-size: 15px; cursor: pointer; text-align: left; }
  .near-row span:first-child { font-weight: 700; }
  .near-row span:last-child { color: var(--muted); white-space: nowrap; }

  /* Marcadores */
  .pin-wrap { background: none; border: 0; }
  .pin { width: 16px; height: 16px; border-radius: 50%; background: var(--pin); border: 3px solid var(--pin-ring); box-shadow: 0 1px 4px rgba(0,0,0,0.35); box-sizing: border-box; transition: transform .15s; }
  .pin-wrap:hover .pin { transform: scale(1.25); }
  .goz-pin { filter: drop-shadow(0 3px 3px rgba(20,48,47,0.35)); animation: goz-drop .45s cubic-bezier(.3,0,.4,1.4) both; }
  .goz-pin svg { display: block; }
  @keyframes goz-drop { from { transform: translateY(-26px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
  .me-dot { width: 18px; height: 18px; border-radius: 50%; background: #3B82F6; border: 3px solid #FFFFFF; box-shadow: 0 0 0 8px rgba(59,130,246,0.25); box-sizing: border-box; }
  .leaflet-tooltip.pin-label { background: var(--surface); color: var(--ink); border: 0; border-radius: 14px; padding: 4px 10px; font-weight: 700; font-size: 13px; box-shadow: 0 1px 6px rgba(20,48,47,0.25); }
  .leaflet-tooltip.pin-label::before { display: none; }
  .leaflet-control-attribution { margin-right: 76px !important; }

  .only-mobile { display: none !important; }

  /* ---------- Celular: hoja inferior por pasos ---------- */
  @media (max-width: 767px) {
    .only-mobile { display: flex !important; }
    .only-desktop { display: none !important; }
    .searchbox { top: calc(12px + env(safe-area-inset-top)); left: 12px; right: 12px; width: auto; }
    body.panel-open .searchbox { background: var(--surface); box-shadow: 0 2px 10px rgba(20,48,47,0.2); }
    .chips, body.panel-open .chips { top: calc(76px + env(safe-area-inset-top)); left: 0; right: 0; margin: 0; padding: 4px 12px; }
    .chip { height: 38px; }
    .panel[data-sheet="full"] ~ .chips, body.sheet-full .chips { display: none; }
    .map-controls { right: 12px; bottom: calc(var(--sheet-h, 116px) + 12px); transition: bottom .25s ease; }
    body.sheet-full .map-controls { display: none; }
    .leaflet-control-attribution { display: none; }

    .panel { top: auto; right: 0; width: auto; height: var(--sheet-h, 116px); transform: none; border-radius: 22px 22px 0 0; box-shadow: 0 -4px 18px rgba(20,48,47,0.16); transition: height .25s ease; padding-bottom: env(safe-area-inset-bottom); }
    .panel.is-dragging { transition: none; }
    .sheet-head { flex-direction: column; flex-shrink: 0; touch-action: none; cursor: grab; }
    .sheet-toggle { display: flex; justify-content: center; align-items: center; width: 100%; height: 24px; padding: 0; border: 0; background: transparent; cursor: grab; }
    .grip { width: 40px; height: 5px; border-radius: 3px; background: #B9CCC9; }
    .peek { flex-direction: column; padding: 4px 20px 12px; }
    .peek p { margin: 0; }
    .peek-title { font-family: var(--font-display); font-weight: 800; font-size: 20px; line-height: 1.2; color: var(--ink); }
    .peek-sub { font-size: 14px; font-weight: 600; color: var(--muted); }
    .panel:not([data-sheet="peek"]) .peek { display: none; }
    .panel[data-sheet="peek"] .panel-body { display: none; }
    .panel-body { padding: 4px 20px 24px; }
    .list-title { font-size: 20px; }
    .detail-photo { height: 160px; }
    .detail-title { font-size: 26px; margin-top: 12px; }
    .back-btn { margin-top: -4px; }
  }
</style>

<script>
  import { collection, getDocs, doc, updateDoc, increment } from 'firebase/firestore';
  import { db } from '../lib/firebase';
  import { esc, safeUrl, num } from '../lib/escape';
  import { GOZ_PIN_SVG } from '../lib/gozPin';

  declare const L: any;

  interface Place {
    id: string; name: string; category: string; lat: number; lng: number;
    description?: string; municipality?: string; department?: string;
    schedule?: string; price?: string; website?: string;
    photos?: string[]; recommendations?: string[]; visitCount?: number;
  }
  interface Review { placeId: string; userName?: string; rating: number; comment?: string; photos?: string[]; visitDate?: string; createdAt?: any; }

  const CATEGORY_NAMES: Record<string, string> = {
    playa: 'Playa', montaña: 'Volcán o montaña', histórico: 'Sitio histórico', gastronomía: 'Comida',
    cultura: 'Cultura', aventura: 'Aventura', río: 'Río', lago: 'Lago', other: 'Lugar',
  };

  const $ = (id: string) => document.getElementById(id) as any;
  const isMobile = () => window.matchMedia('(max-width: 767px)').matches;
  const normalize = (s: unknown) => String(s ?? '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

  let allPlaces: Place[] = [];
  let filtered: Place[] = [];
  let reviewsByPlace: Record<string, Review[]> = {};
  let currentCategory = 'all';
  let currentQuery = '';
  let selectedId: string | null = null;
  let userPos: [number, number] | null = null;
  let detailFromList = false;

  // ---------- Mapa ----------
  const map = L.map('map', { zoomControl: false, attributionControl: true }).setView([13.75, -88.9], 9);
  // Teselas de OpenStreetMap (gratis, sin clave).
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
  }).addTo(map);

  const markerLayer = L.layerGroup().addTo(map);
  let markers: Record<string, any> = {};
  let meMarker: any = null;

  // Los lugares son puntos turquesa; el elegido es Goz, el torogoz-pin, que cae sobre el punto.
  const pinIcon = (selected: boolean) => selected
    ? L.divIcon({ className: 'pin-wrap', html: `<div class="goz-pin">${GOZ_PIN_SVG}</div>`, iconSize: [44, 61], iconAnchor: [22, 40] })
    : L.divIcon({ className: 'pin-wrap', html: '<div class="pin"></div>', iconSize: [16, 16], iconAnchor: [8, 8] });

  function renderMarkers() {
    markerLayer.clearLayers();
    markers = {};
    filtered.forEach((p) => {
      if (!Number.isFinite(p.lat) || !Number.isFinite(p.lng)) return;
      const sel = p.id === selectedId;
      const m = L.marker([p.lat, p.lng], { icon: pinIcon(sel), keyboard: true, title: p.name, alt: p.name, zIndexOffset: sel ? 1000 : 0 });
      m.bindTooltip(esc(p.name), { direction: 'top', offset: [0, sel ? -38 : -9], className: 'pin-label', permanent: sel });
      m.on('click', () => { detailFromList = false; selectPlace(p.id); });
      m.addTo(markerLayer);
      markers[p.id] = m;
    });
  }

  $('zoomIn')?.addEventListener('click', () => map.zoomIn());
  $('zoomOut')?.addEventListener('click', () => map.zoomOut());

  // ---------- Panel de computadora ----------
  const panel = $('panel');
  function setPanelOpen(open: boolean) {
    document.body.classList.toggle('panel-open', open);
    updateClearBtn();
  }

  // ---------- Hoja del celular: asomada, mitad o completa ----------
  type Sheet = 'peek' | 'half' | 'full';
  const PEEK = 116;
  const sheetHeights = () => {
    const h = window.innerHeight;
    return { peek: PEEK, half: Math.round(h * 0.5), full: h - 72 };
  };
  let sheet: Sheet = 'peek';
  function setSheet(s: Sheet) {
    sheet = s;
    panel.dataset.sheet = s;
    const px = sheetHeights()[s];
    document.documentElement.style.setProperty('--sheet-h', `${px}px`);
    document.body.classList.toggle('sheet-full', s === 'full');
    document.body.classList.toggle('panel-open', s !== 'peek');
    $('sheetToggle').setAttribute('aria-expanded', String(s !== 'peek'));
    $('sheetToggleLabel').textContent = s === 'peek' ? 'Ver la lista' : 'Bajar la lista';
    updateClearBtn();
  }

  // Arrastrar la hoja con el dedo y soltarla en la altura más cercana.
  (() => {
    const head = $('sheetHead');
    let startY = 0, startH = 0, moved = false, dragging = false;
    head.addEventListener('pointerdown', (e: PointerEvent) => {
      if (!isMobile()) return;
      dragging = true; moved = false;
      startY = e.clientY; startH = panel.getBoundingClientRect().height;
      panel.classList.add('is-dragging');
      head.setPointerCapture(e.pointerId);
    });
    head.addEventListener('pointermove', (e: PointerEvent) => {
      if (!dragging) return;
      const dy = startY - e.clientY;
      if (Math.abs(dy) > 6) moved = true;
      const hs = sheetHeights();
      const h = Math.max(hs.peek, Math.min(hs.full, startH + dy));
      document.documentElement.style.setProperty('--sheet-h', `${h}px`);
    });
    const end = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      panel.classList.remove('is-dragging');
      if (!moved) {
        setSheet(sheet === 'peek' ? 'half' : 'peek');
        return;
      }
      const h = panel.getBoundingClientRect().height;
      const hs = sheetHeights();
      const velocityUp = startY - e.clientY;
      const order: Sheet[] = ['peek', 'half', 'full'];
      let best: Sheet = order.reduce((a, b) => (Math.abs(hs[b] - h) < Math.abs(hs[a] - h) ? b : a), 'peek' as Sheet);
      if (best === sheet && Math.abs(velocityUp) > 40) {
        const i = order.indexOf(sheet) + (velocityUp > 0 ? 1 : -1);
        best = order[Math.max(0, Math.min(2, i))];
      }
      setSheet(best);
    };
    head.addEventListener('pointerup', end);
    head.addEventListener('pointercancel', end);
    $('sheetToggle').addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setSheet(sheet === 'peek' ? 'half' : 'peek'); }
    });
  })();

  function openList() {
    if (selectedId) closeDetail(true);
    if (isMobile()) setSheet(sheet === 'peek' ? 'half' : sheet);
    else setPanelOpen(true);
    hideHint();
  }
  function closeAll() {
    if (selectedId) closeDetail(true);
    if (isMobile()) setSheet('peek');
    else setPanelOpen(false);
  }
  $('listBtn')?.addEventListener('click', openList);
  $('closeList')?.addEventListener('click', closeAll);

  function updateClearBtn() {
    const show = !!currentQuery || !!selectedId || (!isMobile() && document.body.classList.contains('panel-open'));
    $('clearBtn').hidden = !show;
    $('searchIcon').hidden = show;
  }
  $('clearBtn').addEventListener('click', () => {
    if (currentQuery) {
      currentQuery = '';
      $('searchInput').value = '';
      applyFilters();
    }
    closeAll();
  });

  function hideHint() { $('hint')?.classList.add('is-gone'); }

  // ---------- Utilidades ----------
  function distanceKm(a: [number, number], b: [number, number]) {
    const R = 6371, toRad = (d: number) => (d * Math.PI) / 180;
    const dLat = toRad(b[0] - a[0]), dLng = toRad(b[1] - a[1]);
    const h = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(a[0])) * Math.cos(toRad(b[0])) * Math.sin(dLng / 2) ** 2;
    return 2 * R * Math.asin(Math.sqrt(h));
  }
  const fmtKm = (km: number) => (km < 10 ? `${km.toFixed(1)} km` : `${Math.round(km)} km`);
  const placeMeta = (p: Place) => [p.municipality, p.department].filter(Boolean).filter((v, i, a) => a.indexOf(v) === i).join(', ');

  function ratingOf(id: string) {
    const list = reviewsByPlace[id] || [];
    if (!list.length) return null;
    return { avg: list.reduce((s, r) => s + num(r.rating), 0) / list.length, count: list.length };
  }
  const starSvg = '<svg class="star" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3l2.7 5.6 6.2.9-4.5 4.4 1 6.1L12 17.1 6.6 20l1-6.1L3.1 9.5l6.2-.9z"></path></svg>';

  // ---------- Lista ----------
  function applyFilters() {
    const q = normalize(currentQuery.trim());
    filtered = allPlaces.filter((p) => {
      if (currentCategory !== 'all' && p.category !== currentCategory) return false;
      if (!q) return true;
      return [p.name, p.department, p.municipality, CATEGORY_NAMES[p.category], p.category].some((v) => normalize(v).includes(q));
    });
    if (userPos) {
      filtered.sort((a, b) => distanceKm(userPos!, [a.lat, a.lng]) - distanceKm(userPos!, [b.lat, b.lng]));
    }
    renderList();
    renderMarkers();
    updateClearBtn();
  }

  function renderList() {
    const n = filtered.length;
    const lugares = `${n} ${n === 1 ? 'lugar' : 'lugares'}`;
    $('resultCount').textContent = userPos
      ? `Lo más chulo de aquí, cerquita: ${lugares}, del más cercano al más lejano`
      : `${lugares} en el mapa`;
    $('peekTitle').textContent = userPos ? `${lugares} cerca de vos` : `${lugares} para conocer`;
    $('listBtnLabel').textContent = `Ver lista · ${lugares}`;
    $('emptyState').hidden = n > 0;
    $('placesList').innerHTML = filtered.map((p) => {
      const photo = safeUrl(p.photos?.[0]);
      const r = ratingOf(p.id);
      const extra = userPos ? fmtKm(distanceKm(userPos, [p.lat, p.lng])) : (r ? `${starSvg}${r.avg.toFixed(1)}` : '');
      return `<li><button type="button" class="place-row" data-id="${esc(p.id)}">
        ${photo ? `<img class="place-thumb" src="${photo}" alt="" loading="lazy">` : '<span class="place-thumb" aria-hidden="true"></span>'}
        <span style="min-width:0">
          <p class="place-name">${esc(p.name)}</p>
          <p class="place-meta">${esc(CATEGORY_NAMES[p.category] || 'Lugar')}${placeMeta(p) ? ` · ${esc(placeMeta(p))}` : ''}</p>
        </span>
        ${extra ? `<span class="place-rating">${extra}</span>` : ''}
      </button></li>`;
    }).join('');
  }

  $('placesList').addEventListener('click', (e: Event) => {
    const row = (e.target as HTMLElement).closest('.place-row') as HTMLElement | null;
    if (row?.dataset.id) { detailFromList = true; selectPlace(row.dataset.id); }
  });

  // ---------- Ficha ----------
  // Centra el lugar en la parte del mapa que queda libre (a la derecha del panel o arriba de la hoja).
  function flyToPlace(p: Place) {
    const zoom = Math.max(map.getZoom(), 12);
    let pt = map.project(L.latLng(p.lat, p.lng), zoom);
    if (isMobile()) {
      const h = window.innerHeight;
      const top = 130, bottom = h - sheetHeights().half;
      pt = pt.add([0, h / 2 - (top + bottom) / 2]);
    } else {
      pt = pt.subtract([204, 0]);
    }
    map.flyTo(map.unproject(pt, zoom), zoom, { duration: 0.8 });
  }

  async function bumpVisit(id: string) {
    try { await updateDoc(doc(db, 'places', id), { visitCount: increment(1) }); } catch { /* sin conexión o sin permiso: no es grave */ }
  }

  function selectPlace(id: string, opts: { fly?: boolean; count?: boolean } = {}) {
    const p = allPlaces.find((x) => x.id === id);
    if (!p) return;
    selectedId = id;
    renderMarkers();
    renderDetail(p);
    if (isMobile()) setSheet('half');
    else setPanelOpen(true);
    if (opts.fly !== false) flyToPlace(p);
    if (opts.count !== false) bumpVisit(id);
    history.replaceState(null, '', `#${encodeURIComponent(id)}`);
    hideHint();
    updateClearBtn();
  }

  // keepPanel: deja el panel como está (lo usa quien cierra o abre todo después).
  function closeDetail(keepPanel = false) {
    selectedId = null;
    $('detailView').hidden = true;
    $('listView').hidden = false;
    history.replaceState(null, '', location.pathname);
    renderMarkers();
    $('panelBody').scrollTop = 0;
    if (!keepPanel && !detailFromList) {
      if (isMobile()) setSheet('peek'); else setPanelOpen(false);
    }
    updateClearBtn();
  }

  const icoClock = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>';
  const icoTicket = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8a2 2 0 002-2h14a2 2 0 002 2v2a2 2 0 000 4v2a2 2 0 00-2 2H5a2 2 0 00-2-2v-2a2 2 0 000-4z"></path></svg>';
  const icoLink = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M10 14a5 5 0 007 0l3-3a5 5 0 00-7-7l-1 1M14 10a5 5 0 00-7 0l-3 3a5 5 0 007 7l1-1"></path></svg>';

  function renderDetail(p: Place) {
    const photos = (p.photos || []).map((u) => safeUrl(u)).filter(Boolean);
    const r = ratingOf(p.id);
    const reviews = [...(reviewsByPlace[p.id] || [])].sort((a, b) => (b.createdAt?.toMillis?.() ?? 0) - (a.createdAt?.toMillis?.() ?? 0));
    const near = allPlaces
      .filter((x) => x.id !== p.id)
      .map((x) => ({ x, d: distanceKm([p.lat, p.lng], [x.lat, x.lng]) }))
      .sort((a, b) => a.d - b.d)
      .slice(0, 3);
    const stars = (n: number) => '★'.repeat(Math.max(0, Math.min(5, Math.round(n)))) + '☆'.repeat(5 - Math.max(0, Math.min(5, Math.round(n))));
    const directions = `https://www.google.com/maps/dir/?api=1&destination=${num(p.lat)},${num(p.lng)}`;

    $('detailView').innerHTML = `
      ${detailFromList ? `<button type="button" class="back-btn" id="backBtn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
        Volver a la lista
      </button>` : ''}
      ${photos[0] ? `<img class="detail-photo" src="${photos[0]}" alt="Foto de ${esc(p.name)}">` : '<div class="detail-photo" aria-hidden="true"></div>'}
      <h2 class="detail-title" tabindex="-1" id="detailTitle">${esc(p.name)}</h2>
      <p class="detail-kicker">${esc(CATEGORY_NAMES[p.category] || 'Lugar')}${placeMeta(p) ? ` · ${esc(placeMeta(p))}` : ''}</p>
      ${r
        ? `<p class="rating-line">${starSvg}<span><strong>${r.avg.toFixed(1)}</strong> de 5, ${r.count} ${r.count === 1 ? 'reseña' : 'reseñas'}</span></p>`
        : '<p class="rating-line is-empty">¿Y vos, ya fuiste? Nadie ha contado su visita todavía.</p>'}
      <div class="detail-actions">
        <a class="btn btn-primary" href="${directions}" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l18-8-8 18-2-8z"></path></svg>
          Cómo llegar</a>
        <a class="btn btn-outline" href="/admin?lugar=${encodeURIComponent(p.id)}">Escribir reseña</a>
      </div>
      ${p.description ? `<p class="detail-desc">${esc(p.description)}</p>` : ''}
      <ul class="detail-facts">
        ${p.schedule ? `<li>${icoClock}<span>${esc(p.schedule)}</span></li>` : ''}
        ${p.price ? `<li>${icoTicket}<span>Entrada: ${esc(p.price)}</span></li>` : ''}
        ${safeUrl(p.website) ? `<li>${icoLink}<a href="${safeUrl(p.website)}" target="_blank" rel="noopener" style="color:var(--link)">Sitio web</a></li>` : ''}
      </ul>
      ${p.recommendations?.length ? `<div class="tags">${p.recommendations.map((t) => `<span class="tag">${esc(t)}</span>`).join('')}</div>` : ''}
      ${photos.length > 1 ? `<div class="gallery">${photos.slice(1, 7).map((u) => `<a href="${u}" target="_blank" rel="noopener"><img src="${u}" alt="" loading="lazy"></a>`).join('')}</div>` : ''}

      <h3 class="section-title">Reseñas</h3>
      ${reviews.length ? reviews.map((rv) => {
        const rp = (rv.photos || []).map((u) => safeUrl(u)).filter(Boolean).slice(0, 4);
        return `<div class="review">
          <div class="review-head"><strong>${esc(rv.userName || 'Visitante')}</strong><span class="star" aria-label="${num(rv.rating)} de 5">${stars(num(rv.rating))}</span></div>
          ${rv.visitDate ? `<p class="review-date">Visitó el ${esc(rv.visitDate)}</p>` : ''}
          ${rv.comment ? `<p class="review-text">${esc(rv.comment)}</p>` : ''}
          ${rp.length ? `<div class="review-photos">${rp.map((u) => `<a href="${u}" target="_blank" rel="noopener"><img src="${u}" alt="" loading="lazy"></a>`).join('')}</div>` : ''}
        </div>`;
      }).join('') : `<p class="empty" style="margin-top:4px">Todavía no hay reseñas de este lugar.</p><a class="btn btn-outline" href="/admin?lugar=${encodeURIComponent(p.id)}">Escribir la primera reseña</a>`}

      ${near.length ? `<h3 class="section-title">Cerca de aquí</h3>${near.map(({ x, d }) => `<button type="button" class="near-row" data-id="${esc(x.id)}"><span>${esc(x.name)}</span><span>${fmtKm(d)}</span></button>`).join('')}` : ''}
    `;
    $('listView').hidden = true;
    $('detailView').hidden = false;
    $('panelBody').scrollTop = 0;
    $('backBtn')?.addEventListener('click', () => { closeDetail(true); });
    $('detailView').querySelectorAll('.near-row').forEach((b: HTMLElement) => b.addEventListener('click', () => selectPlace(b.dataset.id!)));
    if (!isMobile()) ($('detailTitle') as HTMLElement).focus({ preventScroll: true });
  }

  // ---------- Filtros ----------
  $('searchInput').addEventListener('input', (e: Event) => {
    currentQuery = (e.target as HTMLInputElement).value;
    if (selectedId) closeDetail(true);
    applyFilters();
    if (currentQuery) openList();
  });

  document.querySelectorAll('.chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      currentCategory = (btn as HTMLElement).dataset.category || 'all';
      document.querySelectorAll('.chip').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      if (selectedId) closeDetail(true);
      applyFilters();
      openList();
    });
  });

  // ---------- Cerca de mí ----------
  function locate() {
    if (!navigator.geolocation) {
      $('resultCount').textContent = 'Tu navegador no permite ver tu ubicación.';
      openList();
      return;
    }
    $('resultCount').textContent = 'Buscando tu ubicación…';
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        userPos = [pos.coords.latitude, pos.coords.longitude];
        if (meMarker) meMarker.remove();
        meMarker = L.marker(userPos, { icon: L.divIcon({ className: 'pin-wrap', html: '<div class="me-dot"></div>', iconSize: [18, 18], iconAnchor: [9, 9] }), interactive: false, zIndexOffset: 2000 }).addTo(map);
        if (selectedId) closeDetail(true);
        applyFilters();
        map.flyTo(userPos, 11, { duration: 0.8 });
        openList();
      },
      () => {
        $('resultCount').textContent = 'No se pudo obtener tu ubicación. Revisá el permiso de ubicación del navegador.';
        openList();
      },
      { enableHighAccuracy: false, timeout: 10000, maximumAge: 300000 }
    );
  }
  $('locateBtn')?.addEventListener('click', locate);

  // Encuadra todo el país dejando libre lo que tapan el buscador, las categorías y la hoja.
  function fitAll() {
    const pts = allPlaces.filter((p) => Number.isFinite(p.lat) && Number.isFinite(p.lng)).map((p) => [p.lat, p.lng]);
    if (!pts.length) return;
    const mobile = isMobile();
    map.fitBounds(L.latLngBounds(pts), {
      paddingTopLeft: [mobile ? 20 : 40, mobile ? 130 : 90],
      paddingBottomRight: [mobile ? 20 : 90, mobile ? PEEK + 24 : 90],
    });
  }

  // ---------- Carga ----------
  async function load() {
    try {
      const [placesSnap, reviewsSnap] = await Promise.all([
        getDocs(collection(db, 'places')),
        getDocs(collection(db, 'reviews')).catch(() => null),
      ]);
      if (placesSnap.empty) throw new Error('Sin lugares');
      allPlaces = placesSnap.docs
        .map((d) => ({ id: d.id, ...d.data() } as Place))
        .map((p) => ({ ...p, lat: Number(p.lat), lng: Number(p.lng) }))
        .sort((a, b) => num(b.visitCount) - num(a.visitCount));
      reviewsByPlace = {};
      reviewsSnap?.docs.forEach((d) => {
        const r = d.data() as Review;
        (reviewsByPlace[r.placeId] ||= []).push(r);
      });
      applyFilters();
      const fromHash = decodeURIComponent(location.hash.slice(1));
      if (fromHash && allPlaces.some((p) => p.id === fromHash)) {
        selectPlace(fromHash, { count: false });
      } else {
        fitAll();
      }
    } catch (err) {
      console.error('Error cargando lugares:', err);
      $('resultCount').textContent = '';
      $('peekTitle').textContent = 'No se pudieron cargar los lugares';
      $('errorState').hidden = false;
      openList();
    }
  }

  if (isMobile()) { $('searchInput').placeholder = 'Buscar en El Salvador'; setSheet('peek'); }
  window.addEventListener('resize', () => {
    map.invalidateSize();
    if (isMobile()) setSheet(sheet);
  });
  load();
</script>
