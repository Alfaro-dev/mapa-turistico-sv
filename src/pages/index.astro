  .detail-title { margin: 16px 0 0; font-family: var(--font-display); font-weight: 800; font-size: 30px; line-height: 1.08; color: var(--ink); }
  .detail-title:focus { outline: none; }
  .detail-kicker { margin: 4px 0 0; font-size: 14px; font-weight: 600; color: var(--muted); }
  .rating-line { margin: 8px 0 0; display: flex; align-items: center; gap: 6px; font-size: 15px; color: var(--ink-2); }
