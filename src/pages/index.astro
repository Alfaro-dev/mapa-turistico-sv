  .sk-lines { flex: 1; display: flex; flex-direction: column; gap: 8px; }
  .sk-lines .sk { height: 14px; }
  .sk-lines .sk-sub { width: 40%; height: 11px; }
  .map-loading { position: fixed; inset: 0; z-index: 900; display: flex; align-items: center; justify-content: center; pointer-events: none; transition: opacity .35s ease; }
  .map-loading .goz-loader { background: var(--surface); border-radius: 28px; padding: 22px 30px 18px; box-shadow: 0 10px 30px rgba(20,48,47,0.16); }
  .map-loading.is-done { opacity: 0; }
  .map-loading.is-error .goz-loader { display: none; }
  @media (max-width: 767px) { .map-loading { bottom: 120px; } }
  .place-row { width: 100%; display: flex; align-items: center; gap: 12px; padding: 8px; margin: 0 -8px; border: 0; background: transparent; color: var(--ink); text-align: left; cursor: pointer; border-radius: 12px; box-sizing: content-box; }
  .place-row:hover { background: var(--neblina); }
