---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Importar Lugares">
  <div class="min-h-screen bg-gray-100 flex items-center justify-center">
    <div class="bg-white rounded-2xl shadow-xl p-8 max-w-md w-full mx-4 text-center">
      <h1 class="text-2xl font-bold text-gray-800 mb-4">📥 Importar Lugares</h1>
      <p class="text-gray-600 mb-6">Sube los 50 lugares turísticos a Firebase</p>
      
      <div id="status" class="mb-6 text-left text-sm font-mono bg-gray-100 p-4 rounded-lg h-48 overflow-y-auto"></div>
      
      <button id="importBtn" class="w-full py-3 bg-emerald-500 hover:bg-emerald-600 text-white rounded-xl font-bold transition">
        🚀 Importar Lugares
      </button>
      
      <a href="/" class="block mt-4 text-gray-500 hover:text-emerald-600">
        ← Volver al mapa
      </a>
    </div>
  </div>
</Layout>

