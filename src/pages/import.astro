  const statusEl = document.getElementById('status');
  const btnEl = document.getElementById('importBtn');
  
  btnEl.addEventListener('click', async () => {
    btnEl.disabled = true;
    btnEl.textContent = 'Importando...';
    
    statusEl.innerHTML = '';
    
    try {
      // Check if places already exist
      const snapshot = await getDocs(collection(db, 'places'));
      
      if (!snapshot.empty) {
        statusEl.innerHTML += `⚠️ Ya hay ${snapshot.size} lugares en Firebase.\n`;
        statusEl.innerHTML += '¿Quieres eliminar los existentes y volver a importar?\n\n';
        btnEl.disabled = false;
        btnEl.textContent = 'Ya existen datos';
        return;
      }
      
      // Import all places
      for (let i = 0; i < places.length; i++) {
        const place = places[i];
        
        await addDoc(collection(db, 'places'), {
          ...place,
          visitCount: Math.floor(Math.random() * 50) + 5,
          createdAt: serverTimestamp()
        });
        
        statusEl.innerHTML += `✓ ${i + 1}/${places.length}: ${place.name}\n`;
        
        // Scroll to bottom
        statusEl.scrollTop = statusEl.scrollHeight;
        
        // Small delay
        await new Promise(r => setTimeout(r, 50));
      }
      
      statusEl.innerHTML += '\n✅ ¡Importación completada!';
      btnEl.textContent = '✓ Importación completa';
      
    } catch (err) {
      console.error(err);
      statusEl.innerHTML += `\n❌ Error: ${err.message}`;
      btnEl.disabled = false;
      btnEl.textContent = 'Reintentar';
    }
  });
</script>
