---
// Página propia de cada lugar: la encuentra Google y se ve bien al compartirla por WhatsApp o redes.
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { loadPlaces, catIcon, CATEGORY_NAMES, CATEGORY_PLURAL, SITE, placeUrl, shareImage, specific, priceText, distanceKm, type SitePlace } from '../../lib/siteData';

export async function getStaticPaths() {
  const places = await loadPlaces();
  return places.map((place) => ({ params: { id: place.id }, props: { place, all: places } }));
}
interface Props { place: SitePlace; all: SitePlace[] }
const { place: p, all } = Astro.props;

const cat = CATEGORY_NAMES[p.category] || 'Lugar';
const where = [p.municipality, p.department].filter(Boolean).filter((v, i, a) => a.indexOf(v) === i).join(', ');
const short = (p.description || `${cat} en ${where || 'El Salvador'}.`).replace(/\s+/g, ' ').trim();
const metaDesc = `${short.length > 150 ? short.slice(0, 147).replace(/\s+\S*$/, '') + '…' : short} Cómo llegar, horario y reseñas en Goz.`;
const title = `${p.name}${where ? ` en ${p.municipality || p.department}` : ''} · Goz`;
const img = p.cover ? shareImage(p.cover) : '';
const near = all.filter((x) => x.id !== p.id).map((x) => ({ x, km: distanceKm([p.lat, p.lng], [x.lat, x.lng]) }))
  .sort((a, b) => a.km - b.km).slice(0, 4);
const fmtKm = (km: number) => (km < 10 ? `${km.toFixed(1)} km` : `${Math.round(km)} km`);
const stars = (n: number) => '★'.repeat(Math.round(n)) + '☆'.repeat(5 - Math.round(n));
const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
const fmtDate = (iso: string) => { const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(iso || ''); return m ? `${Number(m[3])} de ${MESES[Number(m[2]) - 1]} de ${m[1]}` : ''; };
const directions = `https://www.google.com/maps/dir/?api=1&destination=${p.lat},${p.lng}`;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'TouristAttraction', name: p.name, description: short,
  url: `${SITE}${placeUrl(p.id)}`, ...(img ? { image: img } : {}),
  geo: { '@type': 'GeoCoordinates', latitude: p.lat, longitude: p.lng },
  address: { '@type': 'PostalAddress', addressLocality: p.municipality || undefined, addressRegion: p.department || undefined, addressCountry: 'SV' },
  ...(p.reviewCount > 0 && p.rating > 0 ? { aggregateRating: { '@type': 'AggregateRating', ratingValue: p.rating.toFixed(1), reviewCount: p.reviewCount, bestRating: 5, worstRating: 1 } } : {}),
};
---
<Layout title={title} description={metaDesc} image={img} canonical={placeUrl(p.id)} type="place">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}></script>
  <SiteHeader id={`lp-${p.id}`} />
  <main class="lp">
    <nav class="lp-crumbs" aria-label="Estás en">
      <a href="/lugares">Lugares</a><span aria-hidden="true">›</span>
      <a href={`/lugares#${p.category}`}>{CATEGORY_PLURAL[p.category] || 'Lugares'}</a><span aria-hidden="true">›</span>
      <span aria-current="page">{p.name}</span>
    </nav>

    <article class="lp-main">
      {p.cover
        ? <figure class="lp-cover"><img src={p.cover.includes('res.cloudinary.com/') ? p.cover.replace('/upload/', '/upload/c_fill,g_auto,w_1400,h_700,q_auto,f_auto/') : p.cover} alt={`Foto de ${p.name}`} width="1400" height="700" fetchpriority="high" /></figure>
        : <div class="lp-cover-empty" aria-hidden="true" set:html={catIcon(p.category, 44)}></div>}

      <header class="lp-head">
        <p class="lp-cat">{cat}{where && ` · ${where}`}</p>
        <h1 class="lp-h1">{p.name}</h1>
        {p.reviewCount > 0 && p.rating > 0
          ? <p class="lp-rating"><span class="lp-stars" aria-hidden="true">{stars(p.rating)}</span> <strong>{p.rating.toFixed(1)}</strong> de 5 · {p.reviewCount} {p.reviewCount === 1 ? 'reseña' : 'reseñas'}</p>
          : <p class="lp-rating lp-muted">Todavía sin reseñas. ¿Y vos, ya fuiste?</p>}
        <div class="lp-actions">
          <a class="lp-btn lp-btn-primary" href={`/#${encodeURIComponent(p.id)}`}>Ver en el mapa</a>
          <a class="lp-btn" href={directions} target="_blank" rel="noopener">Cómo llegar</a>
          <button type="button" class="lp-btn" id="shareBtn" data-title={p.name}>Compartir</button>
        </div>
        <p id="shareMsg" class="lp-muted lp-share-msg" role="status"></p>
      </header>

      {(specific(p.schedule) || specific(p.price) || p.website) && (
        <dl class="lp-facts">
          {specific(p.schedule) && <div><dt>Horario</dt><dd>{p.schedule}</dd></div>}
          {specific(p.price) && <div><dt>Entrada</dt><dd>{priceText(p.price).replace(/^Entrada /, '').replace(/^./, (c) => c.toUpperCase())}</dd></div>}
          {p.website && <div><dt>Sitio web</dt><dd><a href={p.website} target="_blank" rel="noopener nofollow">{p.website.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a></dd></div>}
        </dl>
      )}

      {p.description && <section class="lp-sec"><h2 class="lp-h2">Cómo es</h2><p class="lp-text">{p.description}</p></section>}

      {p.recommendations.length > 0 && (
        <section class="lp-sec"><h2 class="lp-h2">Qué hacer</h2>
          <ul class="lp-chips">{p.recommendations.map((r) => <li>{r}</li>)}</ul>
        </section>
      )}

      <section class="lp-sec">
        <h2 class="lp-h2">Lo que dicen quienes ya fueron</h2>
        {p.reviews.length
          ? <ul class="lp-reviews">{p.reviews.map((r) => (
              <li class="lp-review">
                <p class="lp-review-head"><strong>{r.userName}</strong> <span class="lp-stars" aria-label={`${r.rating} de 5`}>{stars(r.rating)}</span></p>
                <p class="lp-review-meta">{r.verified && <span class="lp-verified">Visita verificada</span>}{r.verified && r.visitDate && ' · '}{r.visitDate && `Fue el ${fmtDate(r.visitDate)}`}</p>
                <p class="lp-text">{r.comment}</p>
              </li>))}</ul>
          : <p class="lp-muted">Nadie ha contado su visita todavía.</p>}
        <a class="lp-btn lp-btn-outline" href={`/#${encodeURIComponent(p.id)}`}>{p.reviewCount > p.reviews.length ? `Ver las ${p.reviewCount} reseñas y escribir la tuya` : 'Escribir una reseña'}</a>
      </section>

      {near.length > 0 && (
        <section class="lp-sec">
          <h2 class="lp-h2">Cerca de aquí</h2>
          <ul class="lp-near">{near.map(({ x, km }) => (
            <li><a href={placeUrl(x.id)} class="lp-near-card">
              {x.cover ? <img src={x.cover.includes('res.cloudinary.com/') ? x.cover.replace('/upload/', '/upload/c_fill,g_auto,w_320,h_220,q_auto,f_auto/') : x.cover} alt="" loading="lazy" width="320" height="220" /> : <span class="lp-near-empty" aria-hidden="true" set:html={catIcon(x.category, 30)}></span>}
              <span class="lp-near-name">{x.name}</span>
              <span class="lp-near-meta">{CATEGORY_NAMES[x.category] || 'Lugar'} · a {fmtKm(km)}</span>
            </a></li>))}</ul>
        </section>
      )}
    </article>
  </main>
  <footer class="lp-foot">
    <p>Goz · El Salvador, un país chiquito, pero no te lo acabás.</p>
    <p><a href="/lugares">Todos los lugares</a> · <a href="/privacidad">Privacidad</a> · <a href="/terminos">Términos</a></p>
  </footer>
</Layout>

<style is:global>
  html, body { height: auto; min-height: 100%; background: var(--neblina); }
  .lp { max-width: 880px; margin: 0 auto; padding: 16px max(16px, env(safe-area-inset-left)) 56px; color: var(--ink-2); }
  .lp-crumbs { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; font-size: 14px; color: var(--muted); margin-bottom: 14px; }
  .lp-crumbs a { color: var(--turquesa); font-weight: 700; text-decoration: none; }
  .lp-crumbs a:hover { text-decoration: underline; }
  .lp-main { background: var(--surface); border-radius: 24px; overflow: hidden; }
  .lp-cover { margin: 0; aspect-ratio: 2 / 1; background: var(--photo); }
  .lp-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lp-cover-empty { height: 120px; display: flex; align-items: center; justify-content: center; background: #E3EFEE; color: var(--turquesa); }
  .lp-head, .lp-facts, .lp-sec { padding: 0 28px; }
  .lp-head { padding-top: 24px; display: flex; flex-direction: column; gap: 8px; }
  .lp-cat { margin: 0; font-size: 15px; font-weight: 700; color: var(--muted); }
  .lp-h1 { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: 40px; line-height: 1.08; color: var(--ink); text-wrap: balance; }
  .lp-rating { margin: 0; font-size: 15px; }
  .lp-rating strong { color: var(--ink); font-size: 17px; }
  .lp-stars { color: var(--canela); letter-spacing: 1px; }
  .lp-muted { color: var(--muted); }
  .lp-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .lp-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 22px; border-radius: 24px; border: 1.5px solid var(--line); background: var(--surface); color: var(--ink); font: inherit; font-size: 15px; font-weight: 800; text-decoration: none; cursor: pointer; }
  .lp-btn:hover { border-color: var(--turquesa); }
  .lp-btn:focus-visible { outline: 3px solid var(--turquesa); outline-offset: 2px; }
  .lp-btn-primary { background: var(--primary); border-color: var(--primary); color: #FFFFFF; }
  .lp-btn-primary:hover { background: var(--turquesa); }
  .lp-btn-outline { align-self: flex-start; margin-top: 8px; border-color: var(--turquesa); color: var(--turquesa); }
  .lp-share-msg { margin: 0; font-size: 14px; min-height: 1em; }
  .lp-share-msg:empty { display: none; }
  .lp-facts { margin: 22px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
  .lp-facts div { background: var(--neblina); border-radius: 14px; padding: 12px 14px; min-width: 0; }
  .lp-facts dt { font-size: 13px; font-weight: 800; color: var(--muted); }
  .lp-facts dd { margin: 2px 0 0; font-size: 15px; color: var(--ink); overflow-wrap: anywhere; }
  .lp-facts a { color: var(--turquesa); font-weight: 700; }
  .lp-sec { margin-top: 28px; display: flex; flex-direction: column; gap: 10px; }
  .lp-sec:last-child { padding-bottom: 28px; }
  .lp-h2 { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: 24px; color: var(--ink); }
  .lp-text { margin: 0; font-size: 16px; line-height: 1.65; max-width: 68ch; }
  .lp-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .lp-chips li { padding: 6px 14px; border-radius: 16px; background: #FCEFCB; color: var(--rama); font-weight: 700; font-size: 14px; }
  .lp-reviews { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .lp-review { padding: 14px 0; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 4px; }
  .lp-review:first-child { border-top: 0; padding-top: 4px; }
  .lp-review-head { margin: 0; display: flex; justify-content: space-between; gap: 10px; color: var(--ink); }
  .lp-review-meta { margin: 0; font-size: 13px; color: var(--muted); }
  .lp-review-meta:empty { display: none; }
  .lp-verified { color: var(--turquesa); font-weight: 800; }
  .lp-near { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; }
  .lp-near-card { display: flex; flex-direction: column; gap: 4px; color: var(--ink); text-decoration: none; }
  .lp-near-card img, .lp-near-empty { width: 100%; aspect-ratio: 16 / 11; object-fit: cover; border-radius: 14px; background: var(--photo); display: block; }
  .lp-near-empty { display: flex; align-items: center; justify-content: center; background: #E3EFEE; color: var(--turquesa); }
  .lp-near-name { font-weight: 800; line-height: 1.3; }
  .lp-near-card:hover .lp-near-name { color: var(--turquesa); text-decoration: underline; }
  .lp-near-meta { font-size: 13px; color: var(--muted); }
  .lp-foot { max-width: 880px; margin: 0 auto; padding: 0 max(16px, env(safe-area-inset-left)) 40px; font-size: 14px; color: var(--muted); }
  .lp-foot p { margin: 4px 0; }
  .lp-foot a { color: var(--turquesa); font-weight: 700; }
  @media (max-width: 640px) {
    .lp-head, .lp-facts, .lp-sec { padding-left: 18px; padding-right: 18px; }
    .lp-h1 { font-size: 30px; }
    .lp-cover { aspect-ratio: 4 / 3; }
    .lp-btn { flex: 1 1 auto; }
    .lp-near { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  }
</style>

<script>
  // Compartir: el menú del teléfono si existe; si no, copia el enlace.
  const btn = document.getElementById('shareBtn') as HTMLButtonElement | null;
  const msg = document.getElementById('shareMsg');
  btn?.addEventListener('click', async () => {
    const url = location.href.split('#')[0];
    const title = btn.dataset.title || document.title;
    try {
      if (navigator.share) { await navigator.share({ title, text: `${title} en Goz`, url }); return; }
      await navigator.clipboard.writeText(url);
      if (msg) msg.textContent = 'Enlace copiado. Pegalo donde querás compartirlo.';
    } catch { /* la persona canceló */ }
  });
</script>
