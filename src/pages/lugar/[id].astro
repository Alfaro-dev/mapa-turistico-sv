---
// Página propia de cada lugar: Google la lee y se ve con foto al compartirla.
// El HTML se arma al publicar (para buscadores y vistas previas) y en el navegador se vuelve a leer en vivo.
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import PlaceDialogs from '../../components/PlaceDialogs.astro';
import { loadPlaces, SITE, placeUrl, shareImage, renderPlace, placeShort, placeTitle, type SitePlace } from '../../lib/siteData';
import '../../styles/place.css';

export async function getStaticPaths() {
  const places = await loadPlaces();
  return places.map((place) => ({ params: { id: place.id }, props: { place, all: places } }));
}
interface Props { place: SitePlace; all: SitePlace[] }
const { place: p, all } = Astro.props;

const short = placeShort(p);
const metaDesc = `${short.length > 150 ? short.slice(0, 147).replace(/\s+\S*$/, '') + '…' : short} Cómo llegar, horario y reseñas en Goz.`;
const img = p.cover ? shareImage(p.cover) : '';
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'TouristAttraction', name: p.name, description: short,
  url: `${SITE}${placeUrl(p.id)}`, ...(img ? { image: img } : {}),
  geo: { '@type': 'GeoCoordinates', latitude: p.lat, longitude: p.lng },
  address: { '@type': 'PostalAddress', addressLocality: p.municipality || undefined, addressRegion: p.department || undefined, addressCountry: 'SV' },
  ...(p.reviewCount > 0 && p.rating > 0 ? { aggregateRating: { '@type': 'AggregateRating', ratingValue: p.rating.toFixed(1), reviewCount: p.reviewCount, bestRating: 5, worstRating: 1 } } : {}),
};
---
<Layout title={placeTitle(p)} description={metaDesc} image={img} canonical={placeUrl(p.id)} type="place">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}></script>
  <SiteHeader id={`lp-${p.id}`} />
  <main class="lp" id="lp" data-id={p.id} data-name={p.name} data-lat={p.lat} data-lng={p.lng} set:html={renderPlace(p, all)}></main>
  <PlaceDialogs />
  <footer class="lp-foot">
    <p>Goz · El Salvador, un país chiquito, pero no te lo acabás.</p>
    <p><a href="/lugares">Todos los lugares</a> · <a href="/negocios">Tu negocio en Goz</a> · <a href="/privacidad">Privacidad</a> · <a href="/terminos">Términos</a></p>
  </footer>
</Layout>

<script>
  import { startPlacePage } from '../../lib/placePage';
  // Lo que se ve es lo de hoy: se vuelve a leer el lugar, sus reseñas y fotos al abrir la página.
  const root = document.getElementById('lp')!;
  startPlacePage(root, root.dataset.id!);
</script>
