---
import Layout from '../../layouts/Layout.astro';
import GozMark from '../../components/GozMark.astro';
import GozLoader from '../../components/GozLoader.astro';

const sections = [
  { id: 'resumen', label: 'Resumen' },
  { id: 'negocios', label: 'Negocios' },
  { id: 'resenas', label: 'Reseñas' },
  { id: 'fotos', label: 'Fotos' },
  { id: 'lugares', label: 'Lugares turísticos' },
  { id: 'temporada', label: 'Insignias de temporada' },
];
const categories = [
  ['playa', 'Playa'], ['montaña', 'Volcán o montaña'], ['lago', 'Lago o laguna'], ['mirador', 'Mirador'], ['pueblo', 'Pueblo'],
  ['histórico', 'Sitio histórico'], ['cultura', 'Cultura'], ['río', 'Río o cascada'], ['aventura', 'Aventura'], ['gastronomía', 'Comida'], ['other', 'Otro'],
];
---

<Layout title="Admin · Goz" noindex>
  <div class="ad">
    <nav class="ad-nav" aria-label="Secciones del panel">
      <div class="ad-brand">
        <span class="ad-mark"><GozMark size={17} simple id="admin" /></span>
        <span class="ad-word">goz</span>
        <span class="ad-chip">admin</span>
      </div>
      <div class="ad-links">
        {sections.map((s) => (
          <a href={`#${s.id}`} class="ad-link" data-section={s.id}>
            <span>{s.label}</span><span class="ad-count" id={`count-${s.id}`} hidden></span>
          </a>
        ))}
      </div>
      <div class="ad-nav-foot">
        <a href="/" class="ad-link ad-link-map">Ver el mapa público</a>
        <button type="button" id="logoutBtn" class="ad-link ad-logout" hidden>Salir</button>
      </div>
    </nav>

    <main class="ad-main" id="adMain">
      <!-- Sin sesión o sin permiso -->
      <section id="gate" class="ad-card ad-gate" hidden>
        <h1 class="ad-h1">Panel de administrador</h1>
        <p id="gateText" class="ad-lead">Entrá con la cuenta de Google de administrador de Goz.</p>
        <button type="button" id="loginBtn" class="ad-btn ad-btn-primary">Entrar con Google</button>
      </section>
      <GozLoader id="loading" text="Cargando el panel…" />

      <!-- Resumen -->
      <section id="sec-resumen" class="ad-sec" hidden>
        <div class="ad-head"><div><h1 class="ad-h1">Resumen</h1><p class="ad-muted" id="today"></p></div></div>
        <h2 class="ad-h2">Para hacer hoy</h2>
        <div class="ad-todo">
          <a href="#negocios" class="ad-todo-card" data-hot><span class="ad-num" id="tdBiz">0</span><span class="ad-todo-label">Negocios por aprobar</span><span class="ad-todo-go">Revisar</span></a>
          <a href="#resenas" class="ad-todo-card" data-hot><span class="ad-num" id="tdReviews">0</span><span class="ad-todo-label">Reseñas nuevas esta semana</span><span class="ad-todo-go">Revisar</span></a>
          <a href="#negocios" class="ad-todo-card" data-plans-link><span class="ad-num" id="tdPlans">0</span><span class="ad-todo-label">Planes por vencer</span><span class="ad-todo-go">Ver pagos</span></a>
          <a href="#resenas" id="tdReportsLink" class="ad-todo-card"><span class="ad-num" id="tdReports">0</span><span class="ad-todo-label">Reportes por revisar</span><span class="ad-todo-go">Revisar</span></a>
          <a href="#lugares" class="ad-todo-card"><span class="ad-num" id="tdPlaces">0</span><span class="ad-todo-label">Lugares por corregir</span><span class="ad-todo-go">Corregir</span></a>
        </div>
        <section id="delAccounts" class="ad-card" hidden aria-labelledby="hDelAcc">
          <h2 id="hDelAcc" class="ad-h2">Cuentas borradas por limpiar</h2>
          <p class="ad-muted">Estas personas borraron su cuenta. Sus reseñas y fotos ya no están en Goz, pero las imágenes siguen en Cloudinary. Entrá a Cloudinary, buscá la etiqueta y borralas; tenés hasta 30 días (lo dice la política de privacidad).</p>
          <ul id="delAccList" class="ad-rows"></ul>
        </section>
        <h2 class="ad-h2">En Goz hoy</h2>
        <dl class="ad-stats">
          <div><dt>Lugares turísticos</dt><dd id="stPlaces">0</dd></div>
          <div><dt>Negocios activos</dt><dd id="stBiz">0</dd><p class="ad-muted" id="stBizPlans"></p></div>
          <div><dt>Reseñas</dt><dd id="stReviews">0</dd></div>
          <div><dt>Fotos de turistas</dt><dd id="stPhotos">0</dd></div>
        </dl>
        <div class="ad-two">
          <section class="ad-card">
            <div class="ad-card-head"><h2 class="ad-h2">Últimas reseñas</h2><a href="#resenas">Ver todas</a></div>
            <ul id="sumReviews" class="ad-rows"></ul>
          </section>
          <section class="ad-card">
            <div class="ad-card-head"><h2 class="ad-h2">Esperando aprobación</h2><a href="#negocios">Ver todos</a></div>
            <ul id="sumBiz" class="ad-rows"></ul>
          </section>
        </div>
      </section>

      <!-- Negocios -->
      <section id="sec-negocios" class="ad-sec" hidden>
        <div class="ad-head"><h1 class="ad-h1">Negocios</h1></div>
        <div class="ad-filters" role="group" aria-label="Filtrar negocios">
          <button type="button" class="ad-filter" data-bizfilter="pending" aria-pressed="true">Por aprobar</button>
          <button type="button" class="ad-filter" data-bizfilter="active" aria-pressed="false">Activos</button>
          <button type="button" class="ad-filter" data-bizfilter="paid" aria-pressed="false">Planes pagados</button>
          <button type="button" class="ad-filter" data-bizfilter="rejected" aria-pressed="false">Rechazados</button>
        </div>
        <div class="ad-split">
          <div class="ad-card ad-list-wrap"><ul id="bizList" class="ad-list"></ul><nav class="ad-pager" data-pager="biz" aria-label="Páginas de negocios"></nav></div>
          <section id="bizDetail" class="ad-card ad-detail" aria-live="polite"><p class="ad-muted">Elegí un negocio de la lista.</p></section>
        </div>
      </section>

      <!-- Reseñas -->
      <section id="sec-resenas" class="ad-sec" hidden>
        <div class="ad-head"><h1 class="ad-h1">Reseñas</h1></div>
        <p class="ad-lead">Se publican al instante. Si una rompe las reglas (insultos, spam, datos personales, no es de ese lugar), borrala. Las borradas no se pierden: quedan en "Borradas" por si hubo un error.</p>
        <section class="ad-card ad-reports" aria-labelledby="hRepRev">
          <h2 id="hRepRev" class="ad-h2">Reportes por revisar</h2>
          <p class="ad-muted">Reseñas que los turistas marcaron. Si no rompe las reglas, dejala y el reporte se cierra.</p>
          <ul id="reportListReviews" class="ad-rows"></ul>
          <nav class="ad-pager" data-pager="repRev" aria-label="Páginas de reportes"></nav>
        </section>
        <section class="ad-card">
          <div class="ad-filters" role="group" aria-label="Ver reseñas">
            <button type="button" class="ad-filter" data-revfilter="live" aria-pressed="true">Publicadas</button>
            <button type="button" class="ad-filter" data-revfilter="removed" aria-pressed="false">Borradas</button>
          </div>
          <ul id="allReviews" class="ad-rows"></ul>
          <nav class="ad-pager" data-pager="reviews" aria-label="Páginas de reseñas"></nav>
        </section>
      </section>

      <!-- Fotos -->
      <section id="sec-fotos" class="ad-sec" hidden>
        <div class="ad-head"><h1 class="ad-h1">Fotos</h1></div>
        <p class="ad-lead">Las suben los turistas y la más votada es la portada del lugar. Borrá las que no son del lugar o muestran a alguien sin permiso. Tocá una foto para verla en grande.</p>
        <section class="ad-card ad-reports" aria-labelledby="hRepPh">
          <h2 id="hRepPh" class="ad-h2">Reportes por revisar</h2>
          <p class="ad-muted">Fotos que los turistas marcaron. Si no rompe las reglas, dejala y el reporte se cierra.</p>
          <ul id="reportListPhotos" class="ad-rows" data-gal-group></ul>
          <nav class="ad-pager" data-pager="repPh" aria-label="Páginas de reportes"></nav>
        </section>
        <section class="ad-card">
          <div class="ad-filters" role="group" aria-label="Ver fotos">
            <button type="button" class="ad-filter" data-phfilter="live" aria-pressed="true">Publicadas</button>
            <button type="button" class="ad-filter" data-phfilter="removed" aria-pressed="false">Borradas</button>
          </div>
          <ul id="allPhotos" class="ad-photos" data-gal-group></ul>
          <nav class="ad-pager" data-pager="photos" aria-label="Páginas de fotos"></nav>
        </section>
      </section>

      <!-- Lugares: lista -->
      <section id="sec-lugares" class="ad-sec" hidden>
        <div class="ad-head">
          <div><h1 class="ad-h1">Lugares turísticos</h1><p class="ad-muted" id="placesTotal"></p></div>
          <a href="#lugares/nuevo" class="ad-btn ad-btn-primary">Agregar lugar</a>
        </div>
        <div class="ad-filters" role="group" aria-label="Filtrar lugares">
          <button type="button" class="ad-filter" data-placefilter="all" aria-pressed="true">Todos</button>
          <button type="button" class="ad-filter" data-placefilter="problems" aria-pressed="false">Con problemas</button>
          <button type="button" class="ad-filter" data-placefilter="removed" aria-pressed="false">Borrados</button>
          <label class="ad-search"><span class="sr-only">Buscar lugar</span><input type="search" id="placeSearch" placeholder="Buscar lugar"></label>
        </div>
        <section class="ad-card">
          <ul id="placeList" class="ad-cards"></ul>
          <nav class="ad-pager" data-pager="places" aria-label="Páginas de lugares"></nav>
        </section>
      </section>

      <!-- Lugares: formulario en su propia pantalla -->
      <section id="sec-lugar" class="ad-sec ad-form-screen" data-parent="lugares" hidden>
        <a href="#lugares" class="ad-back">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
          Lugares turísticos
        </a>
        <div class="ad-head">
          <h1 id="placeFormTitle" class="ad-h1">Agregar lugar</h1>
          <a id="placeOnMap" class="ad-btn ad-btn-outline ad-btn-sm" href="/" target="_blank" rel="noopener" hidden>Ver en el mapa</a>
        </div>
        <ul id="placeIssues" class="ad-issues"></ul>
        <form id="placeForm" class="ad-form" novalidate>
          <section class="ad-card ad-form-card">
            <h2 class="ad-h2">Ubicación</h2>
            <p class="ad-muted">Tocá el mapa donde queda el lugar o arrastrá el punto.</p>
            <div id="pickerMap" class="ad-picker" role="region" aria-label="Mapa para marcar la ubicación"></div>
            <div class="ad-grid2">
              <div class="ad-field"><label for="pLat">Latitud</label><input id="pLat" type="number" step="0.00001" required></div>
              <div class="ad-field"><label for="pLng">Longitud</label><input id="pLng" type="number" step="0.00001" required></div>
            </div>
          </section>
          <section class="ad-card ad-form-card">
            <h2 class="ad-h2">Datos del lugar</h2>
            <div class="ad-grid2">
              <div class="ad-field"><label for="pName">Nombre</label><input id="pName" type="text" required></div>
              <div class="ad-field"><label for="pCategory">Categoría</label>
                <select id="pCategory" required>{categories.map(([v, l]) => <option value={v}>{l}</option>)}</select></div>
              <div class="ad-field"><label for="pMunicipality">Municipio</label><input id="pMunicipality" type="text"></div>
              <div class="ad-field"><label for="pDepartment">Departamento</label><input id="pDepartment" type="text"></div>
              <div class="ad-field"><label for="pSchedule">Horario <span class="ad-opt">(si tiene)</span></label><input id="pSchedule" type="text" placeholder="Martes a domingo, 9 a. m. a 4 p. m."></div>
              <div class="ad-field"><label for="pPrice">Entrada <span class="ad-opt">(si se paga)</span></label><input id="pPrice" type="text" placeholder="$3 o Gratis"></div>
              <div class="ad-field ad-span2"><label for="pWebsite">Sitio web <span class="ad-opt">(opcional)</span></label><input id="pWebsite" type="url" placeholder="https://"></div>
              <div class="ad-field ad-span2"><label for="pRecs">Qué hacer <span class="ad-opt">(separado por comas)</span></label><input id="pRecs" type="text" placeholder="Senderismo, Mirador, Fotografía"></div>
              <div class="ad-field ad-span2"><label for="pDesc">Descripción</label><textarea id="pDesc" rows="4"></textarea></div>
            </div>
          </section>
          <section class="ad-card ad-form-card">
            <h2 class="ad-h2">Fotos</h2>
            <p class="ad-muted">Al menos una. La portada del mapa la ganan las fotos de los turistas con votos.</p>
            <div id="pPhotos" class="ad-thumbs" data-gal-group></div>
            <label class="dropzone" id="pDrop">
              <span class="dz-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h3l2-3h6l2 3h3v11H4z"></path><circle cx="12" cy="13" r="3.5"></circle></svg></span>
              <span class="dz-text"><strong>Agregá fotos del lugar</strong><span>Arrastralas aquí o tocá para elegir</span></span>
              <input type="file" id="pPhotoInput" accept="image/*" multiple class="sr-only">
            </label>
          </section>
          <div class="ad-form-foot">
            <p id="placeStatus" class="ad-status" role="status"></p>
            <div class="ad-actions">
              <button type="submit" id="saveBtn" class="ad-btn ad-btn-primary">Guardar</button>
              <button type="submit" id="saveNextBtn" class="ad-btn ad-btn-outline" data-next="1">Guardar y seguir con el próximo</button>
              <button type="button" id="deletePlaceBtn" class="ad-btn ad-btn-danger" hidden>Quitar del mapa</button>
            </div>
          </div>
        </form>
      </section>

      <!-- Insignias de temporada: lista -->
      <section id="sec-temporada" class="ad-sec" hidden>
        <div class="ad-head">
          <h1 class="ad-h1">Insignias de temporada</h1>
          <a href="#temporada/nueva" class="ad-btn ad-btn-primary">Nueva insignia</a>
        </div>
        <p class="ad-lead">Se ganan con una reseña con visita verificada en ese lugar, entre esas fechas. Ejemplo: Cerro de las Pavas, el 13 de diciembre. Anunciala antes en TikTok e Instagram.</p>
        <div class="ad-filters" role="group" aria-label="Ver insignias">
          <button type="button" class="ad-filter" data-seasonfilter="active" aria-pressed="true">Activas</button>
          <button type="button" class="ad-filter" data-seasonfilter="next" aria-pressed="false">Próximas</button>
          <button type="button" class="ad-filter" data-seasonfilter="ended" aria-pressed="false">Terminaron</button>
          <button type="button" class="ad-filter" data-seasonfilter="removed" aria-pressed="false">Borradas</button>
        </div>
        <section class="ad-card">
          <ul id="seasonList" class="ad-rows"></ul>
          <nav class="ad-pager" data-pager="season" aria-label="Páginas de insignias"></nav>
        </section>
      </section>

      <!-- Insignias de temporada: formulario -->
      <section id="sec-insignia" class="ad-sec ad-form-screen" data-parent="temporada" hidden>
        <a href="#temporada" class="ad-back">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
          Insignias de temporada
        </a>
        <h1 id="seasonFormTitle" class="ad-h1">Nueva insignia</h1>
        <form id="seasonForm" class="ad-form" novalidate>
          <section class="ad-card ad-form-card">
            <div class="ad-field"><label for="sName">Nombre</label><input id="sName" type="text" placeholder="Cerro de las Pavas 2026" required></div>
            <div class="ad-field"><label for="sDesc">Qué hay que hacer</label><input id="sDesc" type="text" placeholder="Visita verificada el 13 de diciembre"></div>
            <div class="ad-field"><label for="sPlace">Lugar</label><select id="sPlace" required></select></div>
            <div class="ad-grid2">
              <div class="ad-field"><label for="sStart">Desde</label><input id="sStart" type="date" required></div>
              <div class="ad-field"><label for="sEnd">Hasta</label><input id="sEnd" type="date" required></div>
            </div>
          </section>
          <div class="ad-form-foot">
            <p id="seasonStatus" class="ad-status" role="status"></p>
            <div class="ad-actions">
              <button type="submit" id="seasonSubmit" class="ad-btn ad-btn-primary">Crear insignia</button>
              <a href="#temporada" class="ad-btn ad-btn-outline">Cancelar</a>
            </div>
          </div>
        </form>
      </section>
    </main>
  </div>
</Layout>

<style is:global>
  html, body { height: auto; min-height: 100%; background: var(--neblina); }
  .sr-only { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .ad { display: flex; flex-wrap: wrap; min-height: 100vh; color: var(--ink); }
  .ad-nav { flex: 0 0 248px; box-sizing: border-box; background: var(--surface); border-right: 1px solid var(--line); padding: 20px 14px; display: flex; flex-direction: column; gap: 6px; position: sticky; top: 0; height: 100vh; }
  .ad-brand { display: flex; align-items: center; gap: 10px; padding: 0 8px 16px; }
  .ad-mark { width: 36px; height: 36px; border-radius: 10px; background: var(--plumaje); display: flex; align-items: center; justify-content: center; }
  .ad-word { font-family: var(--font-display); font-weight: 800; font-size: 22px; line-height: 1; }
  .ad-chip { font-size: 12px; font-weight: 700; color: var(--muted); background: var(--neblina); padding: 3px 8px; border-radius: 10px; }
  .ad-links { display: flex; flex-direction: column; gap: 4px; }
  .ad-link { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 44px; padding: 0 12px; border-radius: 12px; color: var(--ink); text-decoration: none; font-size: 15px; font-weight: 700; border: 0; background: transparent; cursor: pointer; text-align: left; }
  .ad-link:hover { background: var(--neblina); }
  .ad-link.is-active { background: var(--rama); color: #FFFFFF; font-weight: 800; }
  .ad-count { min-width: 22px; height: 22px; padding: 0 6px; box-sizing: border-box; border-radius: 11px; background: var(--plumaje); color: var(--rama); font-size: 12px; font-weight: 800; display: flex; align-items: center; justify-content: center; }
  .ad-count[hidden] { display: none; }
  .ad-nav-foot { margin-top: auto; display: flex; flex-direction: column; gap: 4px; }
  .ad-link-map { color: var(--turquesa); font-weight: 800; }
  .ad-logout { color: var(--muted); }
  .ad-logout[hidden] { display: none; }
  .ad-main { flex: 999 1 560px; min-width: 0; box-sizing: border-box; padding: 28px 32px 56px; }
  .ad-sec { display: flex; flex-direction: column; gap: 18px; }
  .ad-sec[hidden], .ad-card[hidden] { display: none; }
  .ad-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
  .ad-h1 { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: 32px; line-height: 1.1; }
  .ad-h2 { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: 20px; }
  .ad-lead { margin: 0; font-size: 15px; line-height: 1.5; color: var(--ink-2); max-width: 70ch; }
  .ad-muted { margin: 2px 0 0; font-size: 13px; color: var(--muted); }
  .ad-card { background: var(--surface); border-radius: 16px; padding: 20px; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .ad-card-head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  .ad-card-head a { font-size: 14px; font-weight: 800; color: var(--turquesa); text-decoration: none; }
  .ad-gate { align-items: flex-start; gap: 14px; max-width: 560px; }
  .ad-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 0 18px; border-radius: 22px; border: 2px solid transparent; font: inherit; font-size: 15px; font-weight: 800; cursor: pointer; text-decoration: none; white-space: nowrap; box-sizing: border-box; }
  .ad-btn-primary { background: var(--primary); color: #FFFFFF; }
  .ad-btn-outline { background: var(--surface); color: var(--turquesa); border-color: var(--turquesa); }
  .ad-btn-danger { background: transparent; color: #8A3A10; }
  .ad-btn-danger.is-confirm { background: var(--canela); color: #FFFFFF; }
  .ad-btn-sm { min-height: 36px; padding: 0 14px; font-size: 13px; }
  .ad-btn:disabled { opacity: .6; cursor: default; }
  .ad-todo { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 14px; }
  .ad-todo-card { display: flex; flex-direction: column; gap: 6px; padding: 18px; border-radius: 16px; background: var(--surface); border: 2px solid var(--line); color: var(--ink); text-decoration: none; }
  .ad-todo-card.is-hot { border-color: var(--plumaje); }
  .ad-num { font-family: var(--font-display); font-weight: 800; font-size: 36px; line-height: 1; font-variant-numeric: tabular-nums; }
  .ad-todo-label { flex: 1 1 auto; font-size: 15px; font-weight: 800; line-height: 1.3; }
  .ad-todo-go { margin-top: 4px; font-size: 14px; font-weight: 800; color: var(--turquesa); }
  .ad-stats { margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .ad-stats div { background: var(--surface); border-radius: 16px; padding: 16px 18px; }
  .ad-stats dt { font-size: 14px; font-weight: 700; color: var(--muted); }
  .ad-stats dd { margin: 4px 0 0; font-family: var(--font-display); font-weight: 800; font-size: 28px; font-variant-numeric: tabular-nums; }
  .ad-two { display: flex; flex-wrap: wrap; gap: 20px; align-items: flex-start; }
  .ad-two > * { flex: 1 1 420px; }
  .ad-rows { list-style: none; margin: 0; padding: 0; }
  .ad-row { display: flex; gap: 12px; align-items: flex-start; padding: 12px 0; border-top: 1px solid var(--line); }
  .ad-row-main { flex: 1; min-width: 0; }
  .ad-row-title { margin: 0; font-weight: 800; font-size: 15px; }
  .ad-row-text { margin: 2px 0 0; font-size: 14px; color: var(--ink-2); line-height: 1.45; overflow-wrap: anywhere; }
  .ad-row-meta { margin: 2px 0 0; font-size: 13px; color: var(--muted); }
  .ad-code { font-size: 13px; background: var(--neblina); padding: 2px 6px; border-radius: 6px; }
