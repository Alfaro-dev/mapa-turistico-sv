  .ad-toast.is-on { opacity: 1; transform: translate(-50%, 0); }
  @media (prefers-reduced-motion: reduce) { .ad-toast { transition: none; } }
  .ad-btn:disabled { opacity: .5; cursor: not-allowed; }
  .ad-minimap { height: 180px; border-radius: 12px; overflow: hidden; }
  .ad-biz-top { display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-start; }
  .ad-biz-photo { width: 180px; height: 120px; border-radius: 14px; object-fit: cover; background: var(--photo); }
  @media (max-width: 860px) {
    .ad { align-content: flex-start; }
    .ad-nav { flex: 0 0 100%; min-width: 0; max-width: 100%; height: auto; position: static; flex-direction: column; padding: 12px; border-right: 0; border-bottom: 1px solid var(--line); }
    .ad-links { min-width: 0; }
    .ad-brand { padding-bottom: 8px; }
    .ad-links { flex-direction: row; overflow-x: auto; scrollbar-width: none; }
    .ad-link { flex-shrink: 0; white-space: nowrap; }
    .ad-nav-foot { flex-direction: row; margin-top: 0; }
    .ad-main { padding: 20px 16px 48px; }
    .ad-todo, .ad-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ad-grid2 { grid-template-columns: 1fr; }
    .ad-span2 { grid-column: auto; }
  }
</style>

<script>
  import { signInWithPopup, signOut, onAuthStateChanged } from 'firebase/auth';
  import { collection, getDocs, getDoc, addDoc, doc, deleteDoc, updateDoc, serverTimestamp, writeBatch } from 'firebase/firestore';
  import { esc, safeUrl, num } from '../../lib/escape';
  import { datePicker } from '../../lib/datePicker';
  import { enableGalleries } from '../../lib/gallery';
  import { db, auth, googleProvider } from '../../lib/firebase';
  import { uploadImage } from '../../lib/cloudinary';

  // Aviso breve abajo de la pantalla, para confirmar lo que se hizo.
  function toast(msg: string) {
    let t = document.getElementById('adToast');
    if (!t) { t = document.createElement('div'); t.id = 'adToast'; t.className = 'ad-toast'; t.setAttribute('role', 'status'); document.body.appendChild(t); }
    t.textContent = msg; t.classList.add('is-on');
    clearTimeout((t as any)._h); (t as any)._h = setTimeout(() => t!.classList.remove('is-on'), 4500);
  }

  // Foto que no carga: se cambia por el recuadro vacío de la misma forma, sin el ícono roto del navegador.
  document.addEventListener('error', (e) => {
    const img = e.target as HTMLElement;
    if (!(img instanceof HTMLImageElement) || img.dataset.broken) return;
    const s = document.createElement('span');
    s.className = `${img.className} img-broken`.trim();
    s.setAttribute('aria-hidden', 'true');
    img.replaceWith(s);
  }, true);


  declare const L: any;
  const $ = (id: string) => document.getElementById(id) as any;
  const normalize = (s: unknown) => String(s ?? '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  const ms = (t: any) => t?.toMillis?.() ?? (typeof t === 'string' ? Date.parse(t) || 0 : 0);
  const ago = (t: any) => {
    const m = ms(t); if (!m) return '';
    const h = Math.round((Date.now() - m) / 3600000);
    if (h < 1) return 'hace un momento'; if (h < 24) return `hace ${h} h`;
    const d = Math.round(h / 24); return d === 1 ? 'ayer' : `hace ${d} días`;
  };
  const CAT: Record<string, string> = { playa: 'Playa', montaña: 'Volcán o montaña', lago: 'Lago', histórico: 'Sitio histórico', cultura: 'Cultura', río: 'Río', aventura: 'Aventura', gastronomía: 'Comida', other: 'Otro' };
  const BIZ: Record<string, string> = { hotel: 'Hospedaje', restaurante: 'Restaurante', cafeteria: 'Cafetería', tienda: 'Tienda', otro: 'Negocio' };

  let user: any = null;
  let places: any[] = [], businesses: any[] = [], reviews: any[] = [], photos: any[] = [], seasonal: any[] = [], reports: any[] = [], archived: any[] = [], accountDeletions: any[] = [];
  let revFilter: 'live' | 'removed' = 'live', phFilter: 'live' | 'removed' = 'live';
  let bizFilter = 'pending', placeFilter = 'all', seasonFilter = 'active', selSeason: string | null = null;
  let selBiz: string | null = null, selPlace: string | null = null;
  let placePhotos: string[] = [], uploading = 0;

  enableGalleries(document);

  // ---------- Paginación (todas las listas) ----------
  const pages: Record<string, number> = {};
  function page<T>(key: string, items: T[], per: number): T[] {
    const total = Math.max(1, Math.ceil(items.length / per));
    const p = (pages[key] = Math.min(Math.max(1, pages[key] || 1), total));
    const nav = document.querySelector(`[data-pager="${key}"]`) as HTMLElement | null;
    if (nav) {
      nav.hidden = items.length <= per;
      nav.innerHTML = `<button type="button" class="ad-btn ad-btn-outline ad-btn-sm" data-page="${key}" data-to="${p - 1}"${p === 1 ? ' disabled' : ''}>Anterior</button>
        <span class="ad-pager-info">Página ${p} de ${total}</span>
        <button type="button" class="ad-btn ad-btn-outline ad-btn-sm" data-page="${key}" data-to="${p + 1}"${p === total ? ' disabled' : ''}>Siguiente</button>`;
    }
    return items.slice((p - 1) * per, p * per);
  }
  const resetPage = (...keys: string[]) => keys.forEach((k) => { pages[k] = 1; });
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('[data-page]') as HTMLButtonElement | null;
    if (!b || b.disabled) return;
    pages[b.dataset.page!] = Number(b.dataset.to);
    ({ biz: renderBizList, places: renderPlaceList, season: renderSeason } as Record<string, () => void>)[b.dataset.page!]?.() ?? renderModeration();
    const card = b.closest('.ad-card, .ad-list-wrap') as HTMLElement | null;
    card?.scrollIntoView({ block: 'start', behavior: 'smooth' });
  });

  // ---------- Entrar ----------
  $('loginBtn').addEventListener('click', () => signInWithPopup(auth, googleProvider).catch(() => {}));
  $('logoutBtn').addEventListener('click', () => signOut(auth));

  onAuthStateChanged(auth, async (u) => {
    user = u;
    $('loading').hidden = true;
    $('logoutBtn').hidden = !u;
    hideSections();
    if (!u) { $('gate').hidden = false; $('gateText').textContent = 'Entrá con la cuenta de Google de administrador de Goz.'; $('loginBtn').hidden = false; return; }
    let admin = false;
    try { admin = (await getDoc(doc(db, 'admins', u.uid))).exists(); } catch { admin = false; }
    if (!admin) {
      $('gate').hidden = false; $('loginBtn').hidden = true;
      $('gateText').innerHTML = 'Esta sección es solo para el administrador de Goz. <a href="/">Volver al mapa</a>';
      return;
    }
    $('gate').hidden = true;
    $('loading').hidden = false;
    await loadAll();
    $('loading').hidden = true;
    route();
  });

  async function loadAll() {
    const [p, b, r, f, s, rp, ar, dl] = await Promise.all(['places', 'businesses', 'reviews', 'photos', 'seasonalBadges', 'reports', 'archive', 'accountDeletions']
      .map((c) => getDocs(collection(db, c)).then((snap) => snap.docs.map((d) => ({ id: d.id, ...d.data() }))).catch(() => [] as any[])));
    places = p.map((x: any) => ({ ...x, lat: Number(x.lat), lng: Number(x.lng) })).sort((a: any, b2: any) => String(a.name).localeCompare(String(b2.name), 'es'));
    businesses = b.sort((a: any, b2: any) => ms(b2.createdAt) - ms(a.createdAt));
    reviews = r.sort((a: any, b2: any) => ms(b2.createdAt) - ms(a.createdAt));
    photos = f.sort((a: any, b2: any) => ms(b2.createdAt) - ms(a.createdAt));
    reports = rp.filter((x: any) => x.status === 'open');
    // Lo archivado se guarda hasta 12 meses; lo más viejo se borra de verdad (política de privacidad).
    const yearAgo = Date.now() - 365 * 864e5;
    const expired = ar.filter((x: any) => ms(x.deletedAt) && ms(x.deletedAt) < yearAgo);
    expired.forEach((x: any) => deleteDoc(doc(db, 'archive', x.id)).catch((e: any) => console.error(e)));
    archived = ar.filter((x: any) => !x.restoredAt && !expired.includes(x)).sort((a: any, b2: any) => ms(b2.deletedAt) - ms(a.deletedAt));
    accountDeletions = dl.filter((x: any) => x.status !== 'done').sort((a: any, b2: any) => ms(a.createdAt) - ms(b2.createdAt));
    seasonal = s.sort((a: any, b2: any) => String(b2.start).localeCompare(String(a.start)));
    renderAll();
    checkPhotos();
  }

  // Revisa que las fotos de cada lugar carguen; las que no, se marcan como problema.
  const brokenPhotos = new Set<string>();
  let brokenTimer: any;
  function checkPhotos() {
    places.forEach((p) => (p.photos || []).filter(Boolean).forEach((u: string) => {
      const img = new Image();
      img.onerror = () => { if (!brokenPhotos.has(u)) { brokenPhotos.add(u); clearTimeout(brokenTimer); brokenTimer = setTimeout(renderAll, 800); } };
      img.src = u;
    }));
  }

  // ---------- Navegación por secciones (#resumen, #negocios…) ----------
  function hideSections() { document.querySelectorAll('.ad-sec').forEach((s) => ((s as HTMLElement).hidden = true)); }
  function route() {
    if (!user || !$('gate').hidden) return;
    // #lugares/nuevo, #lugares/editar/ID, #temporada/nueva, #temporada/editar/ID: formularios en su propia pantalla.
    const [id, sub, arg] = (location.hash.slice(1) || 'resumen').split('/');
    const form = (id === 'lugares' && (sub === 'nuevo' || sub === 'editar')) ? 'lugar' : (id === 'temporada' && (sub === 'nueva' || sub === 'editar')) ? 'insignia' : '';
    hideSections();
    const sec = $(`sec-${form || id}`) || $('sec-resumen');
    sec.hidden = false;
    const parent = sec.dataset.parent || sec.id.replace('sec-', '');
    document.querySelectorAll('.ad-link[data-section]').forEach((a) => {
      const on = (a as HTMLElement).dataset.section === parent;
      a.classList.toggle('is-active', on);
      if (on) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current');
    });
    if (form === 'lugar') setTimeout(() => { initPicker(); openPlace(sub === 'editar' ? decodeURIComponent(arg || '') : null); }, 0);
    if (form === 'insignia') openSeason(sub === 'editar' ? decodeURIComponent(arg || '') : null);
    window.scrollTo(0, 0);
  }
  window.addEventListener('hashchange', route);

  // ---------- Problemas de los lugares ----------
  function issuesOf(p: any): string[] {
    const out: string[] = [];
    if (!(p.lat > 13 && p.lat < 14.6 && p.lng > -90.3 && p.lng < -87.5)) out.push('El punto cae fuera de El Salvador');
    const ph = (p.photos || []).filter(Boolean);
    const broken = ph.filter((u: string) => brokenPhotos.has(u)).length;
    if (broken) out.push(broken === 1 ? 'Una foto no carga' : `${broken} fotos no cargan`);
    if (!ph.length) out.push('No tiene foto');
    else if (ph.some((u: string) => /unsplash\.com|pexels\.com|pixabay\.com/.test(u))) out.push('Foto de stock: puede no ser del lugar');
    if (!p.description || String(p.description).length < 40) out.push('Descripción muy corta o vacía');
    if (!p.schedule) out.push('Sin horario');
    if (/\b(Cascade|Waterfall|Beach|Lake|Park|Church|Volcano)\b/i.test(p.name || '')) out.push('Nombre con palabras en inglés');
    if (/various|variou/i.test(p.municipality || '') || /\.[a-z]/.test(p.description || '')) out.push('Datos con errores de texto');
    return out;
  }
  // Sin foto o sin horario fijo son avisos, no problemas: las fotos las suben los turistas y no todo lugar tiene horario.
  const NOTICES = ['No tiene foto', 'Sin horario'];
  // "No tiene foto" se muestra como aviso, pero no cuenta como problema: las fotos las suben los turistas.
  const problemPlaces = () => places.filter((p) => issuesOf(p).some((i) => !NOTICES.includes(i)));

  function renderAll() {
    const pendingBiz = businesses.filter((b) => b.status === 'pending');
    const week = Date.now() - 7 * 864e5;
    const newReviews = reviews.filter((r) => ms(r.createdAt) >= week);
    const newPhotos = photos.filter((f) => ms(f.createdAt) >= week);
    const probs = problemPlaces();
    const repGroups = reportGroups();
    const setCount = (id: string, n: number) => { $(`count-${id}`).hidden = !n; $(`count-${id}`).textContent = n; };
    setCount('negocios', pendingBiz.length); setCount('resenas', newReviews.length + repGroups.filter((g) => g.type === 'review').length);
    setCount('fotos', newPhotos.length + repGroups.filter((g) => g.type === 'photo').length); setCount('lugares', probs.length);

    $('today').textContent = new Date().toLocaleDateString('es-SV', { weekday: 'long', day: 'numeric', month: 'long' });
    $('tdBiz').textContent = pendingBiz.length; $('tdReviews').textContent = newReviews.length;
    $('tdPlans').textContent = businesses.filter((b) => isPaidPlan(b) && planDays(b) <= 7).length; $('tdPlaces').textContent = probs.length;
    $('tdReports').textContent = repGroups.length;
    ($('tdReportsLink') as HTMLAnchorElement).href = repGroups.some((g) => g.type === 'review') || !repGroups.length ? '#resenas' : '#fotos';
    // Solo se resalta lo que tiene algo pendiente.
    document.querySelectorAll('.ad-todo-card').forEach((c) => c.classList.toggle('is-hot', Number(c.querySelector('.ad-num')?.textContent) > 0));
    const active = businesses.filter((b) => b.status !== 'pending' && b.status !== 'rejected');
    $('stPlaces').textContent = places.length; $('stBiz').textContent = active.length;
    const dest = active.filter((b) => b.plan === 'destacado' || (b.featured && b.plan !== 'pro')).length;
    const pro = active.filter((b) => b.plan === 'pro').length;
    $('stBizPlans').textContent = active.length ? `${dest} ${dest === 1 ? 'Destacado' : 'Destacados'} · ${pro} Pro` : '';
    $('stReviews').textContent = reviews.length; $('stPhotos').textContent = photos.length;
    $('sumReviews').innerHTML = reviews.slice(0, 4).map(reviewRow).join('') || '<li class="ad-empty">Todavía no hay reseñas.</li>';
    $('sumBiz').innerHTML = pendingBiz.slice(0, 4).map((b) => `<li class="ad-row">
      ${safeUrl(b.coverUrl) ? `<img class="ad-thumb" src="${safeUrl(b.coverUrl)}" alt="">` : '<span class="ad-thumb"></span>'}
      <div class="ad-row-main"><p class="ad-row-title">${esc(b.name)}</p><p class="ad-row-meta">${esc(BIZ[b.category] || 'Negocio')}${b.placeName ? ` · ${placeLink(b.placeId, b.placeName)}` : ''} · ${ago(b.createdAt)}</p></div>
      <a class="ad-btn ad-btn-primary ad-btn-sm" href="#negocios" data-open-biz="${esc(b.id)}">Revisar</a></li>`).join('') || '<li class="ad-empty">Nada pendiente. Los negocios nuevos no salen en el mapa hasta que los aprobés.</li>';
    renderDeletions();
    renderBizList(); renderModeration(); renderPlaceList(); renderSeason();
  }

  // ---------- Cuentas borradas ----------
  function renderDeletions() {
    $('delAccounts').hidden = !accountDeletions.length;
    $('delAccList').innerHTML = accountDeletions.map((x) => {
      const days = Math.max(0, 30 - Math.floor((Date.now() - ms(x.createdAt)) / 864e5));
      return `<li class="ad-row"><div class="ad-row-main">
        <p class="ad-row-title">Etiqueta <code class="ad-code">${esc(x.cloudinaryTag)}</code> <span class="ad-tag${days <= 7 ? ' ad-tag-warn' : ''}">${days ? `quedan ${days} días` : 'vence hoy'}</span></p>
        <p class="ad-row-meta">Se borró ${ago(x.createdAt)} · tenía ${num(x.photos)} ${num(x.photos) === 1 ? 'foto' : 'fotos'} y ${num(x.reviews)} ${num(x.reviews) === 1 ? 'reseña' : 'reseñas'}</p>
      </div><button type="button" class="ad-btn ad-btn-outline ad-btn-sm" data-deldone="${esc(x.id)}">Ya las borré</button></li>`;
    }).join('');
  }
  document.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest('[data-deldone]') as HTMLButtonElement | null;
    if (!b) return;
    b.disabled = true;
    try {
      await updateDoc(doc(db, 'accountDeletions', b.dataset.deldone!), { status: 'done', doneAt: serverTimestamp(), doneBy: user.uid });
      accountDeletions = accountDeletions.filter((x) => x.id !== b.dataset.deldone);
      renderDeletions(); toast('Listo. Esa cuenta quedó limpia.');
    } catch (err) { console.error(err); b.disabled = false; b.textContent = 'No se pudo guardar'; }
  });

  // ---------- Reseñas y fotos ----------
  const placeName = (id: string) => places.find((p) => p.id === id)?.name || '';
  // El nombre de un lugar lleva a su página pública, en otra pestaña.
  const placeLink = (id: string, name: string) => id && name ? `<a class="place-link" href="/lugar/${encodeURIComponent(id)}" target="_blank" rel="noopener">${esc(name)}</a>` : esc(name);
  // El nombre de quien publicó lleva a su perfil público.
  const who = (x: any) => x.userId
    ? `<a class="ad-who" href="/perfil?u=${encodeURIComponent(x.userId)}" target="_blank" rel="noopener">${esc(x.userName || 'Visitante')}</a>`
    : esc(x.userName || 'Visitante');
  // Fotos chiquitas que abren el visor con todas las del grupo.
  const galThumbs = (urls: string[], cap: string) => {
    const u = urls.map((x) => safeUrl(x)).filter(Boolean);
    return u.length ? `<div class="ad-mini-photos" data-gal-group>${u.map((x, i) => `<button type="button" class="ad-mini" data-gal data-src="${x}" data-cap="${esc(cap)}" aria-label="Ver foto ${i + 1} de ${u.length}"><img src="${x}" alt="" loading="lazy"></button>`).join('')}</div>` : '';
  };
  function reviewRow(r: any, arch?: any) {
    return `<li class="ad-row">
      <div class="ad-row-main">
        <p class="ad-row-title">${placeLink(r.placeId, placeName(r.placeId) || r.placeName || 'Lugar')} · ${num(r.rating)} de 5${r.verified ? ' <span class="ad-tag ad-tag-ok">Verificada</span>' : ''}</p>
        ${r.comment ? `<p class="ad-row-text">${esc(r.comment)}</p>` : ''}
        ${galThumbs(r.photos || [], `Foto de ${r.userName || 'un visitante'}`)}
        <p class="ad-row-meta">${who(r)} · ${ago(r.createdAt)}</p>
        ${arch ? `<p class="ad-removed">Borrada ${ago(arch.deletedAt)} por ${esc(arch.deletedByName || 'el admin')} · ${esc(arch.reason || '')}</p>` : ''}
      </div>
      ${arch
        ? `<button type="button" class="ad-btn ad-btn-outline ad-btn-sm" data-restore="${esc(arch.id)}">Restaurar</button>`
        : `<button type="button" class="ad-btn ad-btn-danger ad-btn-sm" data-del="reviews/${esc(r.id)}">Borrar</button>`}
    </li>`;
  }
  // ---------- Reportes ----------
  const REASONS: Record<string, string> = {
    falsa: 'Es falsa', ofensiva: 'Ofensiva o con insultos', 'otro-lugar': 'No es de este lugar',
    spam: 'Publicidad o spam', datos: 'Datos personales', otra: 'Otra cosa',
  };
  // Un grupo por reseña o foto reportada, con todos sus reportes abiertos.
  function reportGroups() {
    const g: Record<string, any[]> = {};
    reports.forEach((x) => { (g[`${x.type}/${x.targetId}`] ||= []).push(x); });
    return Object.entries(g).map(([key, list]) => {
      const [type, id] = key.split('/');
      const target = (type === 'review' ? reviews : photos).find((y) => y.id === id);
      return { type, id, list, target };
    }).sort((a, b) => b.list.length - a.list.length);
  }
  function renderReports() {
    const all = reportGroups();
    const html = (groups: ReturnType<typeof reportGroups>) => groups.map(({ type, id, list, target }) => {
      const counts: Record<string, number> = {};
      list.forEach((x) => { counts[x.reason] = (counts[x.reason] || 0) + 1; });
      const why = Object.entries(counts).map(([k, n]) => `${REASONS[k] || k}${n > 1 ? ` (${n})` : ''}`).join(' · ');
      const notes = list.map((x) => x.note).filter(Boolean).slice(0, 3);
      const kind = type === 'review' ? 'reseña' : 'foto';
      const col = type === 'review' ? 'reviews' : 'photos';
      const pName = placeLink(list[0].placeId, placeName(list[0].placeId) || target?.placeName || 'Lugar');
      return `<li class="ad-row ad-report">
        ${type === 'photo' ? (target ? `<button type="button" class="ad-mini ad-mini-lg" data-gal data-src="${safeUrl(target.url)}" data-cap="Foto reportada · de ${esc(target.userName || 'un visitante')}" aria-label="Ver la foto reportada"><img src="${safeUrl(target.url)}" alt=""></button>` : '<span class="ad-thumb"></span>') : ''}
        <div class="ad-row-main">
          <p class="ad-row-title">${type === 'review' ? 'Reseña' : 'Foto'} en ${pName} <span class="ad-tag ad-tag-warn">${list.length} ${list.length === 1 ? 'reporte' : 'reportes'}</span></p>
          ${type === 'review' && target ? `<p class="ad-row-text">${num(target.rating)} de 5 · “${esc(String(target.comment || '').slice(0, 220))}”</p>` : ''}
          ${target ? `<p class="ad-row-meta">De ${who(target)} · ${ago(target.createdAt)}</p>` : `<p class="ad-row-meta">Esta ${kind} ya no existe.</p>`}
          <p class="ad-report-why">${esc(why)}</p>
          ${notes.map((n) => `<p class="ad-report-note">“${esc(n)}”</p>`).join('')}
        </div>
        <div class="ad-report-actions">
          ${target ? `<button type="button" class="ad-btn ad-btn-danger ad-btn-sm" data-del="${col}/${esc(id)}" data-del-label="Borrar la ${kind}">Borrar la ${kind}</button>` : ''}
          <button type="button" class="ad-btn ad-btn-outline ad-btn-sm" data-keep="${type}/${esc(id)}">${target ? 'Dejarla' : 'Cerrar reporte'}</button>
        </div>
      </li>`;
    }).join('');
    $('reportListReviews').innerHTML = html(page('repRev', all.filter((g) => g.type === 'review'), 5)) || '<li class="ad-empty">No hay reseñas reportadas. Cuando un turista marque una, aparece aquí.</li>';
    $('reportListPhotos').innerHTML = html(page('repPh', all.filter((g) => g.type === 'photo'), 5)) || '<li class="ad-empty">No hay fotos reportadas. Cuando un turista marque una, aparece aquí.</li>';
  }
  // Cierra los reportes abiertos de una reseña o foto (status: kept si se deja, removed si se borró).
  async function closeReports(type: string, id: string, status: 'kept' | 'removed') {
    const list = reports.filter((x) => x.type === type && x.targetId === id);
    await Promise.all(list.map((x) => updateDoc(doc(db, 'reports', x.id), { status, closedAt: serverTimestamp() })));
    reports = reports.filter((x) => !(x.type === type && x.targetId === id));
  }

  function renderModeration() {
    renderReports();
    const arRev = archived.filter((x) => x.collection === 'reviews');
    const arPh = archived.filter((x) => x.collection === 'photos');
    document.querySelectorAll('[data-revfilter]').forEach((b: any) => {
      b.setAttribute('aria-pressed', String(b.dataset.revfilter === revFilter));
      b.textContent = b.dataset.revfilter === 'live' ? `Publicadas · ${reviews.length}` : `Borradas · ${arRev.length}`;
    });
    document.querySelectorAll('[data-phfilter]').forEach((b: any) => {
      b.setAttribute('aria-pressed', String(b.dataset.phfilter === phFilter));
      b.textContent = b.dataset.phfilter === 'live' ? `Publicadas · ${photos.length}` : `Borradas · ${arPh.length}`;
    });
    $('allReviews').innerHTML = revFilter === 'live'
      ? (page('reviews', reviews, 10).map((r) => reviewRow(r)).join('') || '<li class="ad-empty">Todavía no hay reseñas.</li>')
      : (page('reviews', arRev, 10).map((a) => reviewRow({ ...a.data, id: a.docId }, a)).join('') || '<li class="ad-empty">No hay reseñas borradas.</li>');
    const phCard = (f: any, a?: any) => `<li>
      <button type="button" class="ad-photo-open" data-gal data-src="${safeUrl(f.url)}" data-cap="${esc(placeName(f.placeId) || f.placeName || '')} · foto de ${esc(f.userName || 'un visitante')}" aria-label="Ver la foto de ${esc(f.userName || 'un visitante')}"><img src="${safeUrl(f.url)}" alt="" loading="lazy"></button>
      <p>${placeLink(f.placeId, placeName(f.placeId) || f.placeName || '')} · ${num(f.votes)} ${num(f.votes) === 1 ? 'voto' : 'votos'} · ${who(f)}</p>
      ${a ? `<p class="ad-removed">Borrada ${ago(a.deletedAt)} · ${esc(a.reason || '')}</p><button type="button" class="ad-btn ad-btn-outline ad-btn-sm" data-restore="${esc(a.id)}">Restaurar</button>`
        : `<button type="button" class="ad-btn ad-btn-danger ad-btn-sm" data-del="photos/${esc(f.id)}">Borrar</button>`}
    </li>`;
    $('allPhotos').innerHTML = phFilter === 'live'
      ? (page('photos', photos, 24).map((f) => phCard(f)).join('') || '<li class="ad-empty">Todavía no hay fotos de turistas.</li>')
      : (page('photos', arPh, 24).map((a) => phCard({ ...a.data, id: a.docId }, a)).join('') || '<li class="ad-empty">No hay fotos borradas.</li>');
  }

  // ---------- Nada se borra para siempre ----------
  // Lo borrado se guarda en archive/{colección}_{id} (solo lo ve el admin) y se puede restaurar.
  const ARCH_NAMES: Record<string, [string, string]> = {
    reviews: ['Reseña borrada', 'review'], photos: ['Foto borrada', 'photo'],
    places: ['Lugar quitado del mapa', ''], seasonalBadges: ['Insignia borrada', ''],
  };
  const listOf = (col: string): any[] => (col === 'reviews' ? reviews : col === 'photos' ? photos : col === 'places' ? places : seasonal);
  function setList(col: string, list: any[]) {
    if (col === 'reviews') reviews = list; else if (col === 'photos') photos = list; else if (col === 'places') places = list; else seasonal = list;
  }
  async function archiveDelete(col: string, id: string, why = '') {
    const type = ARCH_NAMES[col]?.[1] || '';
    const item = listOf(col).find((x) => x.id === id);
    const reps = type ? reports.filter((x) => x.type === type && x.targetId === id) : [];
    const reason = why || (reps.length ? `Reportada: ${[...new Set(reps.map((x) => REASONS[x.reason] || x.reason))].join(', ')}` : 'Desde el admin');
    const { id: _omit, ...data } = item || {};
    const arch = { collection: col, docId: id, placeId: data.placeId || (col === 'places' ? id : ''), data, reason, deletedAt: serverTimestamp(), deletedBy: user.uid, deletedByName: user.displayName || 'Admin' };
    const batch = writeBatch(db);
    batch.set(doc(db, 'archive', `${col}_${id}`), arch);
    batch.delete(doc(db, col, id));
    await batch.commit();
    archived.unshift({ ...arch, id: `${col}_${id}`, deletedAt: { toMillis: () => Date.now() } });
    setList(col, listOf(col).filter((x) => x.id !== id));
    if (type) await closeReports(type, id, 'removed').catch((e2) => console.error(e2));
    toast(`${ARCH_NAMES[col]?.[0] || 'Borrado'}. Está en "Borrad${col === 'places' ? 'os' : 'as'}" por si hay que restaurarl${col === 'places' ? 'o' : 'a'}.`);
  }

  // Borrar pide un segundo toque en el mismo botón (sin ventanas del navegador).
  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-plans-link]')) { bizFilter = 'paid'; selBiz = null; setTimeout(() => renderBizList(), 0); }
    const openBiz = t.closest('[data-open-biz]') as HTMLElement | null;
    if (openBiz) { selBiz = openBiz.dataset.openBiz!; bizFilter = 'pending'; setTimeout(() => { renderBizList(); renderBizDetail(); }, 0); }
    const restore = t.closest('[data-restore]') as HTMLButtonElement | null;
    if (restore) {
      const a = archived.find((x) => x.id === restore.dataset.restore);
      if (!a) return;
      restore.disabled = true; restore.textContent = 'Restaurando…';
      try {
        const batch = writeBatch(db);
        batch.set(doc(db, a.collection, a.docId), a.data);
        batch.update(doc(db, 'archive', a.id), { restoredAt: serverTimestamp(), restoredBy: user.uid });
        await batch.commit();
        archived = archived.filter((x) => x.id !== a.id);
        const back = { ...a.data, id: a.docId };
        if (a.collection === 'places') Object.assign(back, { lat: Number(back.lat), lng: Number(back.lng) });
        setList(a.collection, [back, ...listOf(a.collection)]);
        renderAll();
        toast(a.collection === 'seasonalBadges' ? 'Insignia restaurada.' : `${a.collection === 'reviews' ? 'Reseña restaurada' : a.collection === 'photos' ? 'Foto restaurada' : 'Lugar restaurado'}. Ya se ve otra vez en el mapa.`);
      } catch (err) { console.error(err); restore.disabled = false; restore.textContent = 'No se pudo restaurar'; }
      return;
    }
    const revF = t.closest('[data-revfilter]') as HTMLElement | null;
    if (revF) { revFilter = revF.dataset.revfilter as any; resetPage('reviews'); renderModeration(); return; }
    const phF = t.closest('[data-phfilter]') as HTMLElement | null;
    if (phF) { phFilter = phF.dataset.phfilter as any; resetPage('photos'); renderModeration(); return; }
    const keep = t.closest('[data-keep]') as HTMLButtonElement | null;
    if (keep) {
      const [type, id] = keep.dataset.keep!.split('/');
      keep.disabled = true; keep.textContent = 'Guardando…';
      try { await closeReports(type, id, 'kept'); renderAll(); toast('Reporte cerrado. Se queda publicada.'); }
      catch (err) { console.error(err); keep.disabled = false; keep.textContent = 'No se pudo cerrar'; }
      return;
    }
    const del = t.closest('[data-del]') as HTMLButtonElement | null;
    if (!del) return;
    if (!del.classList.contains('is-confirm')) {
      const label = del.dataset.delLabel || 'Borrar';
      del.classList.add('is-confirm'); del.textContent = `¿Seguro? ${label}`;
      setTimeout(() => { if (del.isConnected) { del.classList.remove('is-confirm'); del.textContent = label; } }, 6000);
      return;
    }
    const [col, id] = del.dataset.del!.split('/');
    del.disabled = true; del.textContent = 'Borrando…';
    try {
      await archiveDelete(col, id);
      renderAll();
    } catch (err) { console.error(err); del.disabled = false; del.textContent = 'No se pudo borrar'; }
  });

  // ---------- Negocios ----------
  document.querySelectorAll('[data-bizfilter]').forEach((b) => b.addEventListener('click', () => {
    bizFilter = (b as HTMLElement).dataset.bizfilter!; selBiz = null; resetPage('biz'); renderBizList(); renderBizDetail();
  }));
  const bizState = (b: any) => b.status === 'pending' ? 'pending' : b.status === 'rejected' ? 'rejected' : 'active';
  // ---------- Planes ----------
  const PLANS: Record<string, { label: string; price: string }> = {
    basico: { label: 'Básico', price: 'Gratis' },
    destacado: { label: 'Destacado', price: '$9.99 al mes' },
    pro: { label: 'Pro', price: '$24.99 al mes' },
  };
  const isPaidPlan = (b: any) => bizState(b) === 'active' && (b.plan === 'destacado' || b.plan === 'pro');
  const todayIso = () => new Date().toLocaleDateString('en-CA');
  // Días que faltan para que venza el plan (negativo = vencido; sin fecha = muchos).
  const planDays = (b: any) => b.planUntil ? Math.round((Date.parse(b.planUntil) - Date.parse(todayIso())) / 864e5) : 9999;
  const planLabel = (b: any) => {
    if (!isPaidPlan(b)) return 'Básico';
    const d = planDays(b);
    return `${PLANS[b.plan].label} · ${d < 0 ? `vencido hace ${-d} días` : d === 9999 ? 'sin fecha' : d === 0 ? 'vence hoy' : `vence en ${d} días`}`;
  };
  const inFilter = (b: any) => bizFilter === 'paid' ? isPaidPlan(b) : bizState(b) === bizFilter;
  function addPeriod(fromIso: string, months: number) {
    const base = fromIso && fromIso > todayIso() ? new Date(fromIso + 'T12:00:00') : new Date();
    base.setMonth(base.getMonth() + months);
    return base.toLocaleDateString('en-CA');
  }
  function renderBizList() {
    document.querySelectorAll('[data-bizfilter]').forEach((b) => b.setAttribute('aria-pressed', String((b as HTMLElement).dataset.bizfilter === bizFilter)));
    const all = businesses.filter(inFilter).sort((a, b2) => bizFilter === 'paid' ? planDays(a) - planDays(b2) : 0);
    const list = page('biz', all, 8);
    if (!selBiz && list[0]) selBiz = list[0].id;
    $('bizList').innerHTML = list.map((b) => `<li><button type="button" class="ad-item${b.id === selBiz ? ' is-active' : ''}" data-biz="${esc(b.id)}">
      ${safeUrl(b.coverUrl) ? `<img class="ad-thumb" src="${safeUrl(b.coverUrl)}" alt="">` : '<span class="ad-thumb"></span>'}
      <span class="ad-item-main"><span class="ad-item-title">${esc(b.name)}</span>
      <span class="ad-item-meta">${esc(BIZ[b.category] || 'Negocio')}${b.placeName ? ` · ${esc(b.placeName)}` : ''}${ago(b.createdAt) ? ` · ${ago(b.createdAt)}` : ''}</span>
      ${bizFilter !== 'pending' ? `<span class="ad-tags"><span class="ad-tag${isPaidPlan(b) && planDays(b) > 7 ? ' ad-tag-ok' : ''}">${esc(planLabel(b))}</span></span>` : ''}</span>
    </button></li>`).join('') || `<li class="ad-empty">${bizFilter === 'pending' ? 'No hay negocios esperando aprobación.' : 'No hay negocios aquí.'}</li>`;
    $('bizList').querySelectorAll('[data-biz]').forEach((el: HTMLElement) => el.addEventListener('click', () => { selBiz = el.dataset.biz!; renderBizList(); renderBizDetail(); }));
    renderBizDetail();
  }
  // Fotos del negocio sin repetir (portada + galería).
  const bizPhotos = (b: any) => [...new Set([b.coverUrl, ...(b.photos || [])].map((x: string) => safeUrl(x || '')).filter(Boolean))];
  const MIN_BIZ_PHOTOS = 2;
  // Revisiones automáticas: si alguna falla, no se puede aprobar.
  function autoChecks(b: any) {
    const n = bizPhotos(b).length;
    const inSV = Number(b.lat) > 13 && Number(b.lat) < 14.6 && Number(b.lng) > -90.3 && Number(b.lng) < -87.5;
    return [
      { ok: String(b.name || '').trim().length >= 3 && !!b.category, label: 'Tiene nombre y tipo de negocio', bad: 'Le falta el nombre o el tipo de negocio', ask: 'el nombre y el tipo de negocio' },
      { ok: String(b.description || '').trim().length >= 40, label: 'La descripción dice qué ofrece', bad: 'La descripción está vacía o es muy corta', ask: 'una descripción de qué ofrecen (unas dos líneas)' },
      { ok: !!String(b.schedule || '').trim(), label: 'Tiene horario', bad: 'No tiene horario', ask: 'el horario' },
      { ok: !!String(b.phone || b.whatsapp || '').replace(/\D/g, ''), label: 'Dejó teléfono o WhatsApp', bad: 'No dejó teléfono ni WhatsApp', ask: 'un teléfono o WhatsApp' },
      { ok: n >= MIN_BIZ_PHOTOS, label: `Tiene ${n} fotos`, bad: n ? `Solo tiene ${n} foto; se piden al menos ${MIN_BIZ_PHOTOS}` : `No tiene fotos; se piden al menos ${MIN_BIZ_PHOTOS}`, ask: `al menos ${MIN_BIZ_PHOTOS} fotos del negocio` },
      { ok: inSV, label: 'El punto cae en El Salvador', bad: 'El punto cae fuera de El Salvador', ask: 'marcar bien la ubicación en el mapa' },
    ];
  }
  let miniMap: any = null;
  function renderBizDetail() {
    const b = businesses.find((x) => x.id === selBiz && inFilter(x));
    if (!b) { $('bizDetail').innerHTML = '<p class="ad-muted">Elegí un negocio de la lista.</p>'; return; }
    const wa = String(b.whatsapp || b.phone || '').replace(/\D/g, '');
    const waUrl = wa ? `https://wa.me/${wa.length === 8 ? '503' + wa : wa}?text=${encodeURIComponent(`Hola, te escribo de Goz sobre el registro de ${b.name}.`)}` : '';
    const st = bizState(b);
    const missing = autoChecks(b).filter((c) => !c.ok);
    const waAsk = wa ? `https://wa.me/${wa.length === 8 ? '503' + wa : wa}?text=${encodeURIComponent(`Hola, te escribo de Goz sobre el registro de ${b.name}. Para publicarlo en el mapa nos falta: ${missing.map((c) => c.ask).join('; ')}. Lo podés agregar desde la app. ¡Gracias!`)}` : '';
    $('bizDetail').innerHTML = `
      <div class="ad-biz-top">
        ${safeUrl(b.coverUrl || b.photos?.[0]) ? `<img class="ad-biz-photo" src="${safeUrl(b.coverUrl || b.photos?.[0])}" alt="">` : '<span class="ad-biz-photo"></span>'}
        <div style="flex:1;min-width:220px">
          <h2 class="ad-h1" style="font-size:26px">${esc(b.name)}</h2>
          <p class="ad-muted">${esc(BIZ[b.category] || 'Negocio')}${b.placeName ? ` · cerca de ${placeLink(b.placeId, b.placeName)}` : ''} · plan ${esc((PLANS[b.plan] || PLANS.basico).label)}</p>
          ${b.description ? `<p class="ad-row-text" style="margin-top:8px">${esc(b.description)}</p>` : ''}
          <p class="ad-row-meta" style="margin-top:6px">${[b.schedule, b.address, b.phone && `Tel. ${b.phone}`, b.whatsapp && `WhatsApp ${b.whatsapp}`, b.email].filter(Boolean).map((x) => esc(x)).join(' · ')}</p>
          <p class="ad-row-meta">Dueño: ${b.ownerId ? who({ userId: b.ownerId, userName: b.ownerName || 'ver su perfil' }) : 'sin cuenta'}${safeUrl(b.menu) ? ` · <a href="${safeUrl(b.menu)}" target="_blank" rel="noopener">menú</a>` : ''}</p>
        </div>
      </div>
      <div>
        <p class="ad-field-label">Fotos (${bizPhotos(b).length})</p>
        ${galThumbs(bizPhotos(b), b.name) || '<p class="ad-muted">No subió fotos.</p>'}
      </div>
      <div class="ad-two">
        <div><p class="ad-field-label">Ubicación que marcó</p><div id="bizMiniMap" class="ad-minimap" role="region" aria-label="Ubicación del negocio"></div></div>
        <div class="ad-approve"${st === 'active' ? ' hidden' : ''}>
          <p class="ad-field-label">Revisión antes de aprobar</p>
          <p class="ad-step">1. Lo que Goz revisa solo</p>
          <ul class="ad-autochecks">${autoChecks(b).map((c) => `<li class="${c.ok ? 'is-ok' : 'is-bad'}"><span aria-hidden="true">${c.ok ? '✓' : '✕'}</span>${esc(c.ok ? c.label : c.bad)}</li>`).join('')}</ul>
          ${missing.length ? `<p class="ad-muted">Falta lo que está en rojo. ${waUrl ? 'Pedíselo al dueño por WhatsApp; cuando lo agregue, aparece aquí.' : 'No dejó teléfono ni WhatsApp: si no lo agrega, rechazalo.'}</p>
            ${waUrl ? `<a class="ad-btn ad-btn-outline ad-btn-sm" href="${waAsk}" target="_blank" rel="noopener">Pedirle lo que falta por WhatsApp</a>` : ''}` : ''}
          <p class="ad-step">2. Lo que revisás vos</p>
          <label class="ad-check"><input type="checkbox" data-check>El punto del mapa está donde queda el negocio</label>
          <label class="ad-check"><input type="checkbox" data-check>Las fotos son de este negocio (no de internet ni de otro lugar)</label>
          <label class="ad-check"><input type="checkbox" data-check>Confirmé por WhatsApp o llamada que existe y que lo registró el dueño o encargado</label>
          ${waUrl && !missing.length ? `<a class="ad-btn ad-btn-outline ad-btn-sm" href="${waUrl}" target="_blank" rel="noopener">Escribirle por WhatsApp</a>` : ''}
          <p class="ad-muted" id="checkHelp"></p>
        </div>
      </div>
      ${st === 'active' ? `<section class="ad-plan">
        <p class="ad-field-label">Plan y pagos</p>
        <p class="ad-muted">Ahora: ${esc(planLabel(b))}. Registrá el pago cuando lo recibás; al vencer, deja de salir como Destacado.</p>
        <div class="ad-grid2">
          <div class="ad-field"><label for="planSel">Plan</label><select id="planSel">${Object.entries(PLANS).map(([k, v]) => `<option value="${k}"${(b.plan || 'basico') === k ? ' selected' : ''}>${v.label} · ${v.price}</option>`).join('')}</select></div>
          <div class="ad-field"><label for="planUntil">Pagado hasta</label><input id="planUntil" type="date" value="${esc(b.planUntil || '')}"></div>
        </div>
        <div class="ad-actions" style="border-top:0;padding-top:0">
          <button type="button" class="ad-btn ad-btn-outline ad-btn-sm" data-addmonths="1">Pagó 1 mes</button>
          <button type="button" class="ad-btn ad-btn-outline ad-btn-sm" data-addmonths="12">Pagó 1 año</button>
          <button type="button" class="ad-btn ad-btn-primary ad-btn-sm" id="savePlan">Guardar plan</button>
        </div>
      </section>` : ''}
      <p id="bizStatus" class="ad-status" role="status"></p>
      <div class="ad-actions">
        ${st !== 'active' ? '<button type="button" class="ad-btn ad-btn-primary" data-setstatus="active" disabled>Aprobar y publicar</button>' : ''}
        ${st === 'active' ? '<button type="button" class="ad-btn ad-btn-outline" data-setstatus="pending">Quitar del mapa (volver a revisión)</button>' : ''}
        ${st !== 'rejected' ? '<button type="button" class="ad-btn ad-btn-danger" data-setstatus="rejected">Rechazar</button>' : ''}
      </div>`;
    if ($('planUntil')) datePicker($('planUntil'), { min: 'today', empty: 'Sin fecha', title: 'Pagado hasta' });
    // Aprobar solo se activa con las 3 revisiones marcadas.
    const checks = [...$('bizDetail').querySelectorAll('[data-check]')] as HTMLInputElement[];
    const approveBtn = $('bizDetail').querySelector('[data-setstatus="active"]') as HTMLButtonElement | null;
    const syncChecks = () => {
      const done = checks.every((c) => c.checked);
      if (approveBtn) approveBtn.disabled = !done || missing.length > 0;
      if ($('checkHelp')) $('checkHelp').textContent = missing.length
        ? 'No se puede aprobar hasta que tenga lo que falta en el paso 1.'
        : done ? 'Listo para aprobar.' : `Marcá las 3 revisiones para poder aprobar (${checks.filter((c) => c.checked).length} de 3).`;
    };
    syncChecks();
    checks.forEach((c) => c.addEventListener('change', syncChecks));
    if (approveBtn && !checks.length) approveBtn.disabled = missing.length > 0;
    $('bizDetail').querySelectorAll('[data-setstatus]').forEach((btn: HTMLButtonElement) => btn.addEventListener('click', async () => {
      const status = btn.dataset.setstatus!;
      // Rechazar o quitar del mapa piden un segundo toque.
      if (status !== 'active' && !btn.classList.contains('is-confirm')) {
        const label = btn.textContent;
        btn.classList.add('is-confirm'); btn.textContent = status === 'rejected' ? '¿Seguro? Rechazar' : '¿Seguro? Quitar del mapa';
        setTimeout(() => { if (btn.isConnected) { btn.classList.remove('is-confirm'); btn.textContent = label; } }, 6000);
        return;
      }
      btn.disabled = true;
      try {
        await updateDoc(doc(db, 'businesses', b.id), {
          status, reviewedAt: serverTimestamp(), reviewedBy: user.uid,
          ...(status === 'active' ? { approvalChecks: [...autoChecks(b).map((c) => c.label), 'Punto revisado', 'Fotos revisadas', 'Dueño confirmado'] } : {}),
        });
        b.status = status;
        toast(status === 'active' ? `${b.name} quedó aprobado y ya sale en el mapa.` : status === 'rejected' ? `${b.name} quedó rechazado. Lo encontrás en Rechazados.` : `${b.name} volvió a Por aprobar y ya no sale en el mapa.`);
        selBiz = null; renderAll();
      } catch (err) { console.error(err); btn.disabled = false; $('bizStatus').textContent = 'No se pudo guardar. Revisá tu conexión.'; $('bizStatus').classList.add('is-error'); }
    }));
    $('bizDetail').querySelectorAll('[data-addmonths]').forEach((btn: HTMLButtonElement) => btn.addEventListener('click', () => {
      $('planUntil').value = addPeriod($('planUntil').value || b.planUntil || '', Number(btn.dataset.addmonths));
      if ($('planSel').value === 'basico') $('planSel').value = 'destacado';
    }));
    $('savePlan')?.addEventListener('click', async () => {
      const plan = $('planSel').value;
      const planUntil = plan === 'basico' ? '' : $('planUntil').value;
      if (plan !== 'basico' && !planUntil) { $('bizStatus').textContent = 'Poné hasta qué fecha está pagado.'; $('bizStatus').classList.add('is-error'); return; }
      if (plan !== 'basico' && planUntil < todayIso()) { $('bizStatus').textContent = 'Esa fecha ya pasó: el negocio no saldría como destacado. Usá "Pagó 1 mes" o poné una fecha futura.'; $('bizStatus').classList.add('is-error'); return; }
      $('bizStatus').classList.remove('is-error');
      try {
        await updateDoc(doc(db, 'businesses', b.id), { plan, planUntil, featured: plan !== 'basico', planUpdatedAt: serverTimestamp() });
        Object.assign(b, { plan, planUntil, featured: plan !== 'basico' });
        renderAll();
        $('bizStatus').textContent = plan === 'basico' ? 'Plan Básico guardado.' : `Plan ${PLANS[plan].label} pagado hasta el ${planUntil}.`;
      } catch (err) { console.error(err); $('bizStatus').textContent = 'No se pudo guardar el plan.'; $('bizStatus').classList.add('is-error'); }
    });
    if (miniMap) { miniMap.remove(); miniMap = null; }
    if (typeof L !== 'undefined' && Number.isFinite(Number(b.lat))) {
      miniMap = L.map('bizMiniMap', { zoomControl: false, attributionControl: false, scrollWheelZoom: false }).setView([Number(b.lat), Number(b.lng)], 15);
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(miniMap);
      L.marker([Number(b.lat), Number(b.lng)], { icon: L.divIcon({ className: '', html: '<div style="width:20px;height:20px;border-radius:10px;background:#C2581F;border:3px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.4)"></div>', iconSize: [20, 20], iconAnchor: [10, 10] }) }).addTo(miniMap);
      // El recuadro toma su ancho final después de pintarse: se vuelve a centrar en el punto.
      const mm = miniMap; setTimeout(() => { if (mm === miniMap) { mm.invalidateSize(); mm.setView([Number(b.lat), Number(b.lng)], 15); } }, 60);
      // Si el mapa se creó con la sección oculta, se recentra cuando ya tiene tamaño.
      new ResizeObserver((_, ro) => { if (mm !== miniMap) return ro.disconnect(); if ($('bizMiniMap').offsetWidth) { mm.invalidateSize(); mm.setView([Number(b.lat), Number(b.lng)], 15); } }).observe($('bizMiniMap'));
    }
  }

  // ---------- Lugares ----------
  document.querySelectorAll('[data-placefilter]').forEach((b) => b.addEventListener('click', () => {
    placeFilter = (b as HTMLElement).dataset.placefilter!; resetPage('places'); renderPlaceList();
  }));
  $('placeSearch').addEventListener('input', () => { resetPage('places'); renderPlaceList(); });
  const matches = (p: any, q: string) => !q || [p.name, p.municipality, p.department].some((v) => normalize(v).includes(q));
  function filteredPlaces() {
    const q = normalize($('placeSearch').value);
    return (placeFilter === 'problems' ? problemPlaces() : places).filter((p) => matches(p, q));
  }
  function renderPlaceList() {
    const q = normalize($('placeSearch').value);
    const removed = archived.filter((a) => a.collection === 'places' && matches(a.data, q));
    document.querySelectorAll('[data-placefilter]').forEach((b) => {
      const f = (b as HTMLElement).dataset.placefilter;
      b.setAttribute('aria-pressed', String(f === placeFilter));
      b.textContent = f === 'all' ? `Todos · ${places.length}` : f === 'problems' ? `Con problemas · ${problemPlaces().length}` : `Borrados · ${archived.filter((a) => a.collection === 'places').length}`;
    });
    $('placesTotal').textContent = `${places.length} lugares en el mapa`;
    if (placeFilter === 'removed') {
      $('placeList').innerHTML = page('places', removed, 15).map((a) => `<li class="ad-place is-removed">
        ${safeUrl(a.data.photos?.[0]) ? `<img class="ad-thumb" src="${safeUrl(a.data.photos[0])}" alt="">` : '<span class="ad-thumb"></span>'}
        <span class="ad-item-main"><span class="ad-item-title">${esc(a.data.name || 'Lugar')}</span>
        <span class="ad-removed">Quitado ${ago(a.deletedAt)} por ${esc(a.deletedByName || 'el admin')}</span></span>
        <button type="button" class="ad-btn ad-btn-outline ad-btn-sm" data-restore="${esc(a.id)}">Restaurar</button>
      </li>`).join('') || '<li class="ad-empty">No hay lugares quitados.</li>';
      return;
    }
    $('placeList').innerHTML = page('places', filteredPlaces(), 15).map((p) => {
      const is = issuesOf(p).sort((a, b) => Number(NOTICES.includes(a)) - Number(NOTICES.includes(b)));
      return `<li><a class="ad-place" href="#lugares/editar/${encodeURIComponent(p.id)}">
        ${safeUrl(p.photos?.[0]) ? `<img class="ad-thumb" src="${safeUrl(p.photos[0])}" alt="">` : '<span class="ad-thumb"></span>'}
        <span class="ad-item-main"><span class="ad-item-title">${esc(p.name)}</span>
        <span class="ad-item-meta">${esc(CAT[p.category] || 'Lugar')}${p.department ? ` · ${esc(p.department)}` : ''}</span>
        ${is.length ? `<span class="ad-tags">${is.slice(0, 3).map((x) => `<span class="ad-tag${NOTICES.includes(x) ? ' is-notice' : ''}">${esc(x)}</span>`).join('')}</span>` : ''}</span>
        <span class="ad-go">Editar</span>
      </a></li>`;
    }).join('') || `<li class="ad-empty">${placeFilter === 'problems' && !$('placeSearch').value ? 'Todo en orden: no hay lugares por corregir.' : 'Ningún lugar coincide con la búsqueda.'}</li>`;
  }

  let picker: any = null, pickerMarker: any = null;
  function initPicker() {
    if (picker || typeof L === 'undefined') { picker?.invalidateSize(); return; }
    picker = L.map('pickerMap', { scrollWheelZoom: false }).setView([13.79, -88.9], 8);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '&copy; OpenStreetMap' }).addTo(picker);
    picker.on('click', (e: any) => { setPoint(e.latlng.lat, e.latlng.lng, false); });
    ['pLat', 'pLng'].forEach((id) => $(id).addEventListener('change', () => {
      const la = parseFloat($('pLat').value), ln = parseFloat($('pLng').value);
      if (Number.isFinite(la) && Number.isFinite(ln)) setPoint(la, ln, true);
    }));
  }
  function setPoint(lat: number, lng: number, pan: boolean) {
    $('pLat').value = lat.toFixed(5); $('pLng').value = lng.toFixed(5);
    if (!picker) return;
    if (!pickerMarker) {
      pickerMarker = L.marker([lat, lng], { draggable: true, icon: L.divIcon({ className: '', html: '<div style="width:22px;height:22px;border-radius:11px;background:#0E7C7B;border:4px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.4)"></div>', iconSize: [22, 22], iconAnchor: [11, 11] }) }).addTo(picker);
      pickerMarker.on('dragend', () => { const ll = pickerMarker.getLatLng(); setPoint(ll.lat, ll.lng, false); });
    } else pickerMarker.setLatLng([lat, lng]);
    if (pan) picker.setView([lat, lng], Math.max(picker.getZoom(), 14));
  }

  function renderPlacePhotos() {
    $('pPhotos').innerHTML = placePhotos.map((u, i) => `<div class="ph">
      <button type="button" class="ad-mini ad-ph-open" data-gal data-src="${safeUrl(u)}" data-cap="Foto ${i + 1} de ${placePhotos.length}" aria-label="Ver foto ${i + 1}"><img src="${safeUrl(u)}" alt=""></button>
      ${/unsplash\.com|pexels\.com|pixabay\.com/.test(u) ? '<span class="stock">Foto de stock</span>' : ''}
      <button type="button" class="ph-rm" data-rmphoto="${i}" aria-label="Quitar foto ${i + 1}">×</button></div>`).join('');
  }
  $('pPhotos').addEventListener('click', (e: Event) => {
    const b = (e.target as HTMLElement).closest('[data-rmphoto]') as HTMLElement | null;
    if (b) { placePhotos.splice(Number(b.dataset.rmphoto), 1); renderPlacePhotos(); }
  });
  async function addPlaceFiles(files: File[]) {
    for (const f of files) {
      uploading++; status('Subiendo foto…');
      try { placePhotos.push(await uploadImage(f, 'places', user.uid)); renderPlacePhotos(); status(''); }
      catch (err: any) { status(err?.message || 'No se pudo subir la foto.', true); }
      finally { uploading--; }
    }
  }
  $('pPhotoInput').addEventListener('change', (e: Event) => {
    const input = e.target as HTMLInputElement;
    const files = Array.from(input.files || []); input.value = '';
    addPlaceFiles(files);
  });
  const drop = $('pDrop') as HTMLElement;
  ['dragenter', 'dragover'].forEach((ev) => drop.addEventListener(ev, (e: Event) => { e.preventDefault(); drop.classList.add('is-over'); }));
  ['dragleave', 'drop'].forEach((ev) => drop.addEventListener(ev, () => drop.classList.remove('is-over')));
  drop.addEventListener('drop', (e: DragEvent) => { e.preventDefault(); addPlaceFiles(Array.from(e.dataTransfer?.files || []).filter((f) => f.type.startsWith('image/'))); });
  function status(msg: string, error = false) { $('placeStatus').textContent = msg; $('placeStatus').classList.toggle('is-error', error); }

  function openPlace(id: string | null) {
    const p = places.find((x) => x.id === id);
    selPlace = p ? p.id : null;
    ($('placeForm') as HTMLFormElement).reset();
    $('placeFormTitle').textContent = p ? p.name : 'Agregar lugar';
    $('placeOnMap').hidden = !p; if (p) $('placeOnMap').href = `/#${encodeURIComponent(p.id)}`;
    $('deletePlaceBtn').hidden = !p;
    $('saveNextBtn').hidden = !p;
    $('deletePlaceBtn').classList.remove('is-confirm'); $('deletePlaceBtn').textContent = 'Quitar del mapa';
    // Arriba solo los problemas reales; "sin foto" o "sin horario" no son errores.
    const real = p ? issuesOf(p).filter((x) => !NOTICES.includes(x)) : [];
    $('placeIssues').innerHTML = real.map((x) => `<li>${esc(x)}</li>`).join('');
    $('placeIssues').hidden = !real.length;
    $('pName').value = p?.name ?? ''; $('pCategory').value = p?.category ?? 'playa';
    $('pMunicipality').value = p?.municipality ?? ''; $('pDepartment').value = p?.department ?? '';
    $('pSchedule').value = p?.schedule ?? ''; $('pPrice').value = p?.price ?? '';
    $('pWebsite').value = p?.website ?? ''; $('pRecs').value = (p?.recommendations || []).join(', ');
    $('pDesc').value = p?.description ?? '';
    placePhotos = [...(p?.photos || [])]; renderPlacePhotos(); status('');
    if (pickerMarker) { pickerMarker.remove(); pickerMarker = null; }
    if (p && Number.isFinite(p.lat)) setPoint(p.lat, p.lng, true); else { $('pLat').value = ''; $('pLng').value = ''; picker?.setView([13.79, -88.9], 8); }
    setTimeout(() => picker?.invalidateSize(), 50);
    if (id && !p) { status('Ese lugar ya no existe. Buscalo en Borrados.', true); }
  }

  let saveNext = false;
  $('saveNextBtn').addEventListener('click', () => { saveNext = true; });
  $('saveBtn').addEventListener('click', () => { saveNext = false; });
  $('placeForm').addEventListener('submit', async (e: Event) => {
    e.preventDefault();
    if (uploading) return status('Esperá a que termine de subir la foto.', true);
    const name = $('pName').value.trim();
    if (!name) { $('pName').focus(); return status('Falta el nombre del lugar.', true); }
    const lat = parseFloat($('pLat').value), lng = parseFloat($('pLng').value);
    if (!Number.isFinite(lat) || !Number.isFinite(lng)) return status('Falta la ubicación. Tocá el mapa donde está el lugar.', true);
    if (!(lat > 13 && lat < 14.6 && lng > -90.3 && lng < -87.5)) return status('El punto queda fuera de El Salvador. Marcalo en el mapa.', true);
    const web = $('pWebsite').value.trim();
    if (web && !/^https?:\/\/[^\s.]+\.[^\s]+$/i.test(web)) { $('pWebsite').focus(); return status('El sitio web tiene que empezar con https:// (por ejemplo https://ejemplo.com).', true); }
    if (!placePhotos.length) { drop.focus?.(); return status('Agregá al menos una foto del lugar.', true); }
    const fields = {
      name, category: $('pCategory').value, municipality: $('pMunicipality').value.trim(), department: $('pDepartment').value.trim(),
      lat, lng, schedule: $('pSchedule').value.trim(), price: $('pPrice').value.trim(), website: web,
      recommendations: $('pRecs').value.split(',').map((x: string) => x.trim()).filter(Boolean),
      description: $('pDesc').value.trim(), photos: placePhotos,
    };
    status('Guardando…');
    try {
      let savedId = selPlace;
      if (selPlace) {
        await updateDoc(doc(db, 'places', selPlace), { ...fields, updatedAt: serverTimestamp() });
        Object.assign(places.find((x) => x.id === selPlace), fields);
      } else {
        const ref = await addDoc(collection(db, 'places'), { ...fields, visitCount: 0, createdAt: serverTimestamp(), createdBy: user.uid });
        places.push({ id: ref.id, ...fields });
        savedId = ref.id;
      }
      renderAll();
      if (saveNext && savedId) {
        const list = filteredPlaces();
        const i = list.findIndex((x) => x.id === savedId);
        const next = list[i + 1] || list[0];
        toast('Guardado. Seguimos con el próximo.');
        location.hash = next ? `#lugares/editar/${encodeURIComponent(next.id)}` : '#lugares';
      } else {
        toast(selPlace ? 'Cambios guardados.' : `${name} quedó en el mapa.`);
        location.hash = '#lugares';
      }
    } catch (err) { console.error(err); status('No se pudo guardar. Revisá tu conexión.', true); }
  });

  $('deletePlaceBtn').addEventListener('click', async () => {
    const btn = $('deletePlaceBtn');
    if (!selPlace) return;
    if (!btn.classList.contains('is-confirm')) {
      btn.classList.add('is-confirm'); btn.textContent = '¿Seguro? Quitar del mapa';
      setTimeout(() => { if (btn.isConnected) { btn.classList.remove('is-confirm'); btn.textContent = 'Quitar del mapa'; } }, 6000);
      return;
    }
    btn.disabled = true;
    try {
      await archiveDelete('places', selPlace, 'Quitado desde el admin');
      renderAll(); location.hash = '#lugares';
    } catch (err) { console.error(err); status('No se pudo quitar. Revisá tu conexión.', true); }
    finally { btn.disabled = false; }
  });

  // ---------- Insignias de temporada ----------
  const MESES_C = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
  const fmtDay = (iso: string) => { const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(iso || ''); return m ? `${Number(m[3])} de ${MESES_C[Number(m[2]) - 1]}${Number(m[1]) !== new Date().getFullYear() ? ` de ${m[1]}` : ''}` : iso; };
  const seasonState = (x: any, today: string) => (x.end < today ? 'ended' : x.start > today ? 'next' : 'active');
  const SEASON_TAG: Record<string, string> = { active: 'Activa', next: 'Próxima', ended: 'Terminó' };
  document.querySelectorAll('[data-seasonfilter]').forEach((b) => b.addEventListener('click', () => {
    seasonFilter = (b as HTMLElement).dataset.seasonfilter!; resetPage('season'); renderSeason();
  }));
  function renderSeason() {
    const today = new Date().toLocaleDateString('en-CA');
    const removed = archived.filter((a) => a.collection === 'seasonalBadges');
    const count = (f: string) => f === 'removed' ? removed.length : seasonal.filter((x) => seasonState(x, today) === f).length;
    document.querySelectorAll('[data-seasonfilter]').forEach((b: any) => {
      const f = b.dataset.seasonfilter;
      b.setAttribute('aria-pressed', String(f === seasonFilter));
      b.textContent = `${{ active: 'Activas', next: 'Próximas', ended: 'Terminaron', removed: 'Borradas' }[f as 'active']} · ${count(f)}`;
    });
    const row = (x: any, a?: any) => {
      const st = seasonState(x, today);
      return `<li class="ad-row"><div class="ad-row-main">
        <p class="ad-row-title">${esc(x.name)} ${a ? '' : `<span class="ad-tag${st === 'active' ? ' ad-tag-ok' : ''}">${SEASON_TAG[st]}</span>`}</p>
        <p class="ad-row-text">${placeLink(x.placeId, placeName(x.placeId) || 'Lugar')} · del ${esc(fmtDay(x.start))} al ${esc(fmtDay(x.end))}</p>
        ${x.description ? `<p class="ad-row-meta">${esc(x.description)}</p>` : ''}
        ${a ? `<p class="ad-removed">Borrada ${ago(a.deletedAt)} por ${esc(a.deletedByName || 'el admin')}</p>` : ''}
      </div>
      <div class="ad-row-actions">${a
        ? `<button type="button" class="ad-btn ad-btn-outline ad-btn-sm" data-restore="${esc(a.id)}">Restaurar</button>`
        : `<a class="ad-btn ad-btn-outline ad-btn-sm" href="#temporada/editar/${encodeURIComponent(x.id)}">Editar</a><button type="button" class="ad-btn ad-btn-danger ad-btn-sm" data-del="seasonalBadges/${esc(x.id)}">Borrar</button>`}</div></li>`;
    };
    const empty: Record<string, string> = {
      active: 'No hay insignias activas hoy. Creá una o revisá las próximas.', next: 'No hay insignias programadas.',
      ended: 'Todavía no ha terminado ninguna.', removed: 'No hay insignias borradas.',
    };
    $('seasonList').innerHTML = seasonFilter === 'removed'
      ? (page('season', removed, 10).map((a) => row({ ...a.data, id: a.docId }, a)).join('') || `<li class="ad-empty">${empty.removed}</li>`)
      : (page('season', seasonal.filter((x) => seasonState(x, today) === seasonFilter)
          .sort((a, b) => seasonFilter === 'ended' ? String(b.end).localeCompare(String(a.end)) : String(a.start).localeCompare(String(b.start))), 10)
          .map((x) => row(x)).join('') || `<li class="ad-empty">${empty[seasonFilter]}</li>`);
  }
  const seasonPickers = [
    datePicker($('sStart'), { empty: 'Elegí el día', title: 'Primer día de la insignia' }),
    datePicker($('sEnd'), { empty: 'Elegí el día', title: 'Último día de la insignia' }),
  ];
  const seasonMsg = (m: string, err = false) => { $('seasonStatus').textContent = m; $('seasonStatus').classList.toggle('is-error', err); };
  function openSeason(id: string | null) {
    const x = seasonal.find((y) => y.id === id);
    selSeason = x ? x.id : null;
    ($('seasonForm') as HTMLFormElement).reset();
    $('sPlace').innerHTML = '<option value="">Elegí un lugar</option>' + places.map((p) => `<option value="${esc(p.id)}">${esc(p.name)}</option>`).join('');
    $('seasonFormTitle').textContent = x ? 'Editar insignia' : 'Nueva insignia';
    $('seasonSubmit').textContent = x ? 'Guardar cambios' : 'Crear insignia';
    $('sName').value = x?.name ?? ''; $('sDesc').value = x?.description ?? ''; $('sPlace').value = x?.placeId ?? '';
    $('sStart').value = x?.start ?? ''; $('sEnd').value = x?.end ?? '';
    seasonPickers.forEach((pk) => pk.refresh());
    seasonMsg(id && !x ? 'Esa insignia ya no existe. Buscala en Borradas.' : '', !!(id && !x));
  }
  $('seasonForm').addEventListener('submit', async (e: Event) => {
    e.preventDefault();
    const data = { name: $('sName').value.trim(), description: $('sDesc').value.trim(), placeId: $('sPlace').value, start: $('sStart').value, end: $('sEnd').value };
    if (!data.name) { $('sName').focus(); return seasonMsg('Falta el nombre de la insignia.', true); }
    if (!data.placeId) { $('sPlace').focus(); return seasonMsg('Elegí en qué lugar se gana.', true); }
    if (!data.start || !data.end) return seasonMsg('Elegí el primer y el último día.', true);
    if (data.end < data.start) return seasonMsg('El último día tiene que ser igual o después del primero.', true);
    try {
      if (selSeason) {
        await updateDoc(doc(db, 'seasonalBadges', selSeason), { ...data, updatedAt: serverTimestamp() });
        Object.assign(seasonal.find((y) => y.id === selSeason), data);
        toast('Insignia guardada.');
      } else {
        const ref = await addDoc(collection(db, 'seasonalBadges'), { ...data, createdAt: serverTimestamp() });
        seasonal.unshift({ id: ref.id, ...data });
        toast('Insignia creada. Ya sale en el perfil de los turistas.');
      }
      seasonFilter = seasonState(data, new Date().toLocaleDateString('en-CA'));
      renderSeason();
      location.hash = '#temporada';
    } catch (err) { console.error(err); seasonMsg('No se pudo guardar. Revisá tu conexión.', true); }
  });
</script>
