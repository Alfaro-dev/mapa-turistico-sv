---
import Layout from '../layouts/Layout.astro';
import GozMark from '../components/GozMark.astro';
import GozLoader from '../components/GozLoader.astro';
---

<Layout title="Mi perfil · Goz" noindex>
  <header class="pf-top">
    <a href="/" class="pf-back" aria-label="Volver al mapa">
      <span class="pf-mark"><GozMark size={18} simple id="perfil" /></span>
      <span>Volver al mapa</span>
    </a>
  </header>

  <main class="pf">
    <section id="pfLogin" class="pf-card pf-login" hidden>
      <h1 class="pf-h1">Tu perfil en Goz</h1>
      <p class="pf-lead">Entrá con Google para ver tus insignias, tus fotos y el mapa de los lugares que ya conocés.</p>
      <button type="button" id="pfLoginBtn" class="pf-btn pf-btn-primary">Entrar con Google</button>
    </section>

    <GozLoader id="pfLoading" text="Cargando el perfil…" />

    <div id="pfBody" hidden>
      <section class="pf-hero">
        <span id="pfAvatar" class="pf-avatar" aria-hidden="true"></span>
        <div class="pf-who">
          <h1 id="pfName" class="pf-h1"></h1>
          <p id="pfSub" class="pf-sub">El Salvador, un país chiquito, pero no te lo acabás.</p>
        </div>
      </section>

      <dl class="pf-stats">
        <div><dt>Reseñas</dt><dd id="stReviews">0</dd></div>
        <div><dt>Lugares visitados</dt><dd id="stPlaces">0</dd></div>
        <div><dt>Fotos</dt><dd id="stPhotos">0</dd></div>
        <div><dt>Votos recibidos</dt><dd id="stVotes">0</dd></div>
      </dl>

      <section class="pf-section" aria-labelledby="hBadges">
        <div class="pf-section-head">
          <h2 id="hBadges" class="pf-h2">Insignias</h2>
          <a href="/insignias" id="badgesAll" class="pf-link">Ver todas las insignias</a>
        </div>
        <p id="badgeCount" class="pf-muted"></p>
        <ul id="badges" class="bd-grid"></ul>
        <div id="badgesEmpty" class="pf-empty" hidden>
          <p>Escribí tu primera reseña y ganás <strong>Primer paso</strong>.</p>
          <a href="/" class="pf-btn pf-btn-primary">Ir al mapa</a>
        </div>
      </section>

      <section class="pf-section" aria-labelledby="hGallery">
        <div class="pf-section-head">
          <h2 id="hGallery" class="pf-h2">Galería</h2>
          <div class="pf-toggle" role="group" aria-label="Ver la galería como">
            <button type="button" id="viewGrid" aria-pressed="true">Cuadrícula</button>
            <button type="button" id="viewMap" aria-pressed="false">Mapa</button>
          </div>
        </div>
        <div id="galleryEmpty" class="pf-empty" hidden>
          <p id="galleryEmptyTxt">Todavía no subiste fotos. Aparecen aquí cuando subís una desde un lugar.</p>
        </div>
        <ul id="gallery" class="pf-grid"></ul>
        <div id="galleryMap" class="pf-map" hidden role="region" aria-label="Mapa de tus fotos y lugares visitados"></div>
      </section>

      <section class="pf-section" aria-labelledby="hReviews">
        <h2 id="hReviews" class="pf-h2">Reseñas</h2>
        <div id="reviewsEmpty" class="pf-empty" hidden>
          <p id="reviewsEmptyTxt">Todavía no escribiste reseñas.</p>
        </div>
        <ul id="myReviews" class="pf-reviews"></ul>
      </section>

      <div id="pfAccount" class="pf-account">
        <button type="button" id="pfLogout" class="pf-btn pf-btn-ghost">Salir de mi cuenta</button>
        <section class="pf-section" aria-labelledby="hBiz">
          <h2 id="hBiz" class="pf-h2">Tu negocio</h2>
          <p class="pf-lead">Registrá tu restaurante, hospedaje o tienda, mirá cuántos lo ven y publicá cupones.</p>
          <a href="/negocios" class="pf-btn pf-btn-outline pf-link-btn">Ir a Tu negocio en Goz</a>
        </section>
        <section class="pf-section" aria-labelledby="hExport">
          <h2 id="hExport" class="pf-h2">Tus datos</h2>
          <p class="pf-lead">Descargá en un archivo lo que Goz tiene de vos: tu cuenta, reseñas, fotos, votos y cupones.</p>
          <p id="expStatus" class="pf-del-status" role="status"></p>
          <div class="pf-del-actions"><button type="button" id="expBtn" class="pf-btn pf-btn-ghost">Descargar mis datos</button></div>
        </section>
        <section id="pfDelete" class="pf-section pf-delete" aria-labelledby="hDelete">
          <h2 id="hDelete" class="pf-h2">Borrar mi cuenta</h2>
          <p class="pf-lead">Se borran tus reseñas, tus fotos y tu perfil de Goz, y tu cuenta deja de existir aquí. No se puede deshacer.</p>
          <p id="delBiz" class="pf-warn" hidden></p>
          <div id="delConfirm" class="pf-del-confirm" hidden>
            <label class="pf-del-check"><input type="checkbox" id="delCheck">Entiendo que se borra todo y que no se puede recuperar.</label>
            <p class="pf-muted">Google te va a pedir que confirmés que sos vos.</p>
          </div>
          <p id="delStatus" class="pf-del-status" role="status"></p>
          <div class="pf-del-actions">
            <button type="button" id="delStart" class="pf-btn pf-btn-danger">Borrar mi cuenta</button>
            <button type="button" id="delCancel" class="pf-btn pf-btn-ghost" hidden>Cancelar</button>
          </div>
        </section>
        <p class="pf-legal"><a href="/privacidad">Privacidad</a> · <a href="/terminos">Términos</a></p>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  html, body { height: auto; min-height: 100%; background: var(--neblina); }
  .pf-top { position: sticky; top: 0; z-index: 10; background: var(--surface); border-bottom: 1px solid var(--line); padding: 10px max(16px, env(safe-area-inset-left)); }
  .pf-back { display: inline-flex; align-items: center; gap: 10px; height: 44px; color: var(--ink); font-weight: 800; text-decoration: none; }
  .pf-mark { width: 34px; height: 34px; border-radius: 17px; background: var(--plumaje); display: flex; align-items: center; justify-content: center; }
  .pf { max-width: 980px; margin: 0 auto; padding: 24px max(16px, env(safe-area-inset-left)) 56px; display: flex; flex-direction: column; gap: 24px; }
  .pf-card { background: var(--surface); border-radius: 20px; padding: 28px; }
  .pf-login { display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .pf-h1 { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: 32px; line-height: 1.1; color: var(--ink); }
  .pf-h2 { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: 22px; color: var(--ink); }
  .pf-lead { margin: 0; font-size: 16px; line-height: 1.5; color: var(--ink-2); }
  .pf-muted { margin: 0; font-size: 14px; color: var(--muted); }
  .pf-sub { margin: 4px 0 0; font-size: 15px; color: var(--muted); }
  .pf-btn { height: 46px; padding: 0 22px; border-radius: 23px; font-size: 15px; font-weight: 800; cursor: pointer; border: 2px solid transparent; }
  .pf-btn-primary { background: var(--primary); color: #FFFFFF; }
  .pf-btn-ghost { align-self: flex-start; background: transparent; color: var(--muted); border-color: var(--line); }
  .pf-hero { display: flex; align-items: center; gap: 16px; }
  .pf-avatar { width: 76px; height: 76px; border-radius: 38px; background: var(--plumaje); overflow: hidden; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-weight: 800; font-size: 32px; color: var(--rama); }
  .pf-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .pf-stats { margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .pf-stats div { background: var(--surface); border-radius: 16px; padding: 14px 16px; }
  .pf-stats dt { font-size: 13px; font-weight: 700; color: var(--muted); }
  .pf-stats dd { margin: 2px 0 0; font-family: var(--font-display); font-weight: 800; font-size: 28px; color: var(--ink); font-variant-numeric: tabular-nums; }
  .pf-section { background: var(--surface); border-radius: 20px; padding: 20px; display: flex; flex-direction: column; gap: 14px; }
  .pf-account { display: flex; flex-direction: column; gap: 20px; }
  .pf-delete { border: 1.5px solid #EBC6B1; }
  .pf-warn { margin: 0; padding: 12px 14px; border-radius: 12px; background: #F6D9C8; color: #6E2E0C; font-weight: 700; font-size: 14px; }
  .pf-del-confirm { display: flex; flex-direction: column; gap: 6px; }
  .pf-del-check { display: flex; gap: 10px; align-items: flex-start; font-weight: 700; cursor: pointer; }
  .pf-del-check input { width: 20px; height: 20px; margin: 1px 0 0; accent-color: #A3461A; flex: none; }
  .pf-del-status { margin: 0; font-size: 14px; font-weight: 700; color: var(--muted); }
  .pf-del-status:empty { display: none; }
  .pf-del-status.is-error { color: #8A3A10; }
  .pf-del-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .pf-btn-danger { background: #A3461A; color: #FFFFFF; }
  .pf-btn-danger:disabled { opacity: .6; cursor: default; }
  .pf-legal { margin: 0; font-size: 13px; color: var(--muted); }
  .pf-legal a { color: var(--turquesa); font-weight: 700; }
  .pf-section-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; }
  #pfBody:not([hidden]) { display: flex; flex-direction: column; gap: 24px; }
  .pf-link { color: var(--link); font-size: 15px; font-weight: 800; text-decoration: none; }
  .pf-link:hover { text-decoration: underline; }
  .pf-empty { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding: 16px; border-radius: 14px; background: var(--neblina); }
  .pf-empty[hidden] { display: none; }
  .pf-empty p { margin: 0; font-size: 15px; color: var(--ink-2); }
  a.pf-btn { display: inline-flex; align-items: center; text-decoration: none; }
  a.pf-btn[hidden] { display: none; }
  .pf-btn-outline { background: transparent; color: var(--primary); border-color: var(--primary); }
  .pf-link-btn { align-self: flex-start; display: inline-flex; align-items: center; text-decoration: none; }
  .pf-toggle { display: inline-flex; padding: 3px; border-radius: 22px; background: var(--neblina); }
  .pf-toggle button { height: 38px; padding: 0 16px; border: 0; border-radius: 19px; background: transparent; color: var(--ink); font-size: 14px; font-weight: 800; cursor: pointer; }
  .pf-toggle button[aria-pressed="true"] { background: var(--rama); color: #FFFFFF; }
  .pf-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; }
  .pf-grid li { position: relative; }
  .pf-grid img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 12px; display: block; background: var(--photo); }
  .pf-grid-meta { position: absolute; left: 6px; right: 6px; bottom: 6px; display: flex; justify-content: space-between; gap: 4px; }
  .pf-grid-meta span:first-child { flex: 1 1 auto; min-width: 0; }
  .pf-grid-meta .pf-votes { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 3px; }
  .pf-grid-meta span { padding: 2px 8px; border-radius: 10px; background: rgba(20,48,47,0.78); color: #FFFFFF; font-size: 11px; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pf-grid-cover { position: absolute; left: 6px; top: 6px; padding: 2px 8px; border-radius: 10px; background: var(--plumaje); color: var(--rama); font-size: 11px; font-weight: 800; }
  .pf-map { height: 420px; border-radius: 16px; overflow: hidden; }
  .pf-map[hidden] { display: none; }
  .pf-reviews { list-style: none; margin: 0; padding: 0; }
  .pf-reviews li { padding: 12px 0; border-top: 1px solid var(--line); }
  .pf-reviews a { color: var(--ink); font-weight: 800; text-decoration: none; }
  .pf-reviews p { margin: 4px 0 0; font-size: 14px; color: var(--ink-2); line-height: 1.5; }
  .pf-stars { color: var(--star); font-size: 14px; margin-left: 6px; }
  .map-thumb { width: 44px; height: 44px; border-radius: 12px; border: 3px solid #FFFFFF; background: var(--plumaje) center / cover no-repeat; box-shadow: 0 2px 6px rgba(0,0,0,0.35); position: relative; }
  .map-thumb b { position: absolute; right: -8px; top: -8px; min-width: 20px; height: 20px; padding: 0 5px; box-sizing: border-box; border-radius: 10px; background: var(--rama); color: #FFFFFF; font-size: 11px; display: flex; align-items: center; justify-content: center; }
  .map-visited { width: 16px; height: 16px; border-radius: 8px; background: var(--turquesa); border: 3px solid #FFFFFF; box-sizing: border-box; box-shadow: 0 1px 4px rgba(0,0,0,0.35); }
  @media (max-width: 640px) {
    .pf-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pf-h1 { font-size: 26px; }
    .pf-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pf-map { height: 360px; }
  }
</style>

<script>
  import { signInWithPopup, signOut, onAuthStateChanged, reauthenticateWithPopup, deleteUser } from 'firebase/auth';
  import { collection, getDocs, getDoc, query, where, doc, writeBatch, setDoc, deleteDoc, serverTimestamp } from 'firebase/firestore';
  import { auth, googleProvider, db } from '../lib/firebase';
  import { LEGAL } from '../lib/legal';
  import { esc, safeUrl, num } from '../lib/escape';
  import { type SeasonalBadge } from '../lib/badges';
  import { loadUserData, userBadges, seasonalTag } from '../lib/userData';
  import { badgeCard } from '../lib/badgeCard';
  import '../styles/badges.css';

  // Foto que no carga: se cambia por el recuadro vacío de la misma forma, sin el ícono roto del navegador.
  document.addEventListener('error', (e) => {
    const img = e.target as HTMLElement;
    if (!(img instanceof HTMLImageElement) || img.dataset.broken) return;
    const s = document.createElement('span');
    s.className = `${img.className} img-broken`.trim();
    s.setAttribute('aria-hidden', 'true');
    img.replaceWith(s);
  }, true);


  declare const L: any;
  const $ = (id: string) => document.getElementById(id) as any;

  let places: any[] = [];
  let photos: any[] = [];
  let reviews: any[] = [];
  let map: any = null;

  $('pfLoginBtn').addEventListener('click', () => signInWithPopup(auth, googleProvider).catch(() => {}));
  $('pfLogout').addEventListener('click', async () => { await signOut(auth); location.href = '/'; });

  // ---------- Descargar mis datos (portabilidad) ----------
  const plain = (v: any): any => v?.toDate ? v.toDate().toISOString() : Array.isArray(v) ? v.map(plain)
    : v && typeof v === 'object' ? Object.fromEntries(Object.entries(v).map(([k, x]) => [k, plain(x)])) : v;
  $('expBtn').addEventListener('click', async () => {
    const user = auth.currentUser;
    if (!user) return;
    const btn = $('expBtn') as HTMLButtonElement;
    btn.disabled = true; $('expStatus').textContent = 'Juntando tus datos…'; $('expStatus').classList.remove('is-error');
    try {
      const mine = (col: string) => getDocs(query(collection(db, col), where('userId', '==', user.uid)))
        .then((sn) => sn.docs.map((d) => ({ id: d.id, ...plain(d.data()) }))).catch(() => []);
      const [reviews, photos, votes, redemptions, profile] = await Promise.all([
        mine('reviews'), mine('photos'), mine('photoVotes'), mine('couponRedemptions'),
        getDoc(doc(db, 'users', user.uid)).then((d) => (d.exists() ? plain(d.data()) : null)).catch(() => null),
      ]);
      const data = {
        exportadoEl: new Date().toISOString(),
        cuenta: { id: user.uid, nombre: user.displayName, correo: user.email, foto: user.photoURL, creada: user.metadata.creationTime },
        perfil: profile, resenas: reviews, fotos: photos, votos: votes, cupones: redemptions,
        nota: 'Los reportes que hiciste los puede ver solo el administrador; si los querés, pedilos a ' + LEGAL.contact + '.',
      };
      const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `goz-mis-datos-${new Date().toISOString().slice(0, 10)}.json`;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 2000);
      $('expStatus').textContent = 'Listo: se descargó el archivo con tus datos.';
    } catch (err) {
      console.error(err);
      $('expStatus').textContent = 'No se pudo armar el archivo. Revisá tu conexión y probá otra vez.'; $('expStatus').classList.add('is-error');
    } finally { btn.disabled = false; }
  });

  // ---------- Borrar mi cuenta ----------
  // Primero Google confirma que es la persona; después se borran reseñas, fotos y perfil,
  // se deja aviso al admin para borrar las imágenes en Cloudinary y al final se borra la cuenta.
  const delMsg = (m: string, err = false) => { $('delStatus').textContent = m; $('delStatus').classList.toggle('is-error', err); };
  let delStep = 0;
  $('delCancel').addEventListener('click', () => {
    delStep = 0; $('delConfirm').hidden = true; $('delCancel').hidden = true; $('delBiz').hidden = true;
    $('delStart').textContent = 'Borrar mi cuenta'; delMsg('');
  });
  $('delStart').addEventListener('click', async () => {
    const user = auth.currentUser;
    if (!user) return;
    if (delStep === 0) {
      delStep = 1;
      $('delConfirm').hidden = false; $('delCancel').hidden = false;
      $('delStart').textContent = 'Sí, borrar mi cuenta';
      try {
        const biz = await getDocs(query(collection(db, 'businesses'), where('ownerId', '==', user.uid)));
        if (!biz.empty) {
          $('delBiz').textContent = `Tenés ${biz.size === 1 ? 'un negocio registrado' : `${biz.size} negocios registrados`} en Goz. No se borra${biz.size === 1 ? '' : 'n'} con tu cuenta: escribinos a ${LEGAL.contact} para darl${biz.size === 1 ? 'o' : 'os'} de baja.`;
          $('delBiz').hidden = false;
        }
      } catch { /* sin negocios o sin conexión */ }
      ($('delCheck') as HTMLInputElement).focus();
      return;
    }
    if (!($('delCheck') as HTMLInputElement).checked) { delMsg('Marcá la casilla para confirmar.', true); ($('delCheck') as HTMLInputElement).focus(); return; }
    const btn = $('delStart') as HTMLButtonElement;
    btn.disabled = true; $('delCancel').hidden = true;
    try {
      delMsg('Confirmá con Google que sos vos…');
      await reauthenticateWithPopup(user, googleProvider);
      delMsg('Borrando tus reseñas y fotos…');
      const uid = user.uid;
      const [rv, ph] = await Promise.all([
        getDocs(query(collection(db, 'reviews'), where('userId', '==', uid))),
        getDocs(query(collection(db, 'photos'), where('userId', '==', uid))),
      ]);
      // Aviso para el admin: las imágenes en Cloudinary se borran a mano con la etiqueta uid_…
      await setDoc(doc(db, 'accountDeletions', uid), { uid, cloudinaryTag: `uid_${uid}`, reviews: rv.size, photos: ph.size, status: 'pending', createdAt: serverTimestamp() });
      const docs = [...rv.docs, ...ph.docs];
      for (let i = 0; i < docs.length; i += 400) {
        const batch = writeBatch(db);
        docs.slice(i, i + 400).forEach((d) => batch.delete(d.ref));
        await batch.commit();
      }
      await deleteDoc(doc(db, 'users', uid)).catch(() => {});
      await deleteUser(user);
      document.getElementById('pfBody')!.innerHTML = '<section class="pf-section"><h1 class="pf-h1">Tu cuenta se borró</h1><p class="pf-lead">Borramos tus reseñas, tus fotos y tu perfil. Las imágenes terminan de borrarse en un plazo de hasta 30 días. Gracias por haber sido parte de Goz.</p><a href="/" class="pf-btn pf-btn-primary">Ir al mapa</a></section>';
    } catch (err: any) {
      console.error(err);
      btn.disabled = false; $('delCancel').hidden = false;
      delMsg(err?.code === 'auth/popup-closed-by-user' || err?.code === 'auth/cancelled-popup-request'
        ? 'No se borró nada: cerraste la ventana de Google. Probá otra vez cuando querás.'
        : err?.code === 'auth/user-mismatch' ? 'Elegiste otra cuenta de Google. Usá la misma con la que entraste.'
        : 'No se pudo terminar. Revisá tu conexión y probá otra vez; si algo ya se borró, se termina de borrar al reintentar.', true);
    }
  });

  // /perfil?u=UID muestra el perfil público de otra persona (sus fotos, reseñas e insignias), sin pedir cuenta.
  const viewUid = new URLSearchParams(location.search).get('u') || '';
  let rendered = false;
  const loadFail = (id: string, msg: string) => { $(id).classList.add('is-stopped'); $(id).querySelector('.gl-text').textContent = msg; };

  async function loadAndRender(uid: string, user: any | null) {
    $('pfLoading').hidden = false;
    $('pfLogin').hidden = true;
    $('pfBody').hidden = true;
    try {
      const data = await loadUserData(uid);
      ({ places, reviews, photos } = data);
      // De otra persona: el nombre y la foto salen de lo que publicó.
      const src: any = photos[0] || reviews[0] || {};
      const who = user || { displayName: src.userName || 'Visitante', photoURL: src.userPhoto || '' };
      render(who, data.seasonal, !user);
      rendered = true;
    } catch (err) {
      console.error(err);
      loadFail('pfLoading', 'No se pudo cargar este perfil. Revisá tu conexión y recargá la página.');
    }
  }

  onAuthStateChanged(auth, async (user) => {
    if (viewUid && (!user || user.uid !== viewUid)) {
      if (!rendered) loadAndRender(viewUid, null);
      return;
    }
    rendered = false;
    $('pfLoading').hidden = !user;
    $('pfLogin').hidden = !!user;
    $('pfBody').hidden = true;
    if (!user) return;
    loadAndRender(user.uid, user);
  });

  function render(user: any, seasonal: SeasonalBadge[], isPublic = false) {
    $('pfLoading').hidden = true;
    $('pfBody').hidden = false;
    const name = user.displayName || 'Visitante';
    document.title = isPublic ? `${name} · Goz` : 'Mi perfil · Goz';
    $('pfAccount').hidden = isPublic;
    $('badgesAll').href = isPublic ? `/insignias?u=${encodeURIComponent(viewUid)}` : '/insignias';
    $('pfSub').textContent = isPublic ? 'Turista en Goz' : 'El Salvador, un país chiquito, pero no te lo acabás.';
    $('galleryEmptyTxt').textContent = isPublic ? 'Todavía no ha subido fotos.' : 'Todavía no subiste fotos. Aparecen aquí cuando subís una desde un lugar.';
    $('reviewsEmptyTxt').textContent = isPublic ? 'Todavía no ha escrito reseñas.' : 'Todavía no escribiste reseñas.';
    $('badgesEmpty').querySelector('p').innerHTML = isPublic ? 'Todavía no ha ganado insignias.' : 'Escribí tu primera reseña y ganás <strong>Primer paso</strong>.';
    ($('badgesEmpty').querySelector('a') as HTMLElement).hidden = isPublic;
    $('pfName').textContent = name;
    const pic = user.photoURL ? safeUrl(user.photoURL) : '';
    $('pfAvatar').innerHTML = pic ? `<img src="${pic}" alt="" referrerpolicy="no-referrer">` : esc(name.charAt(0).toUpperCase());

    const visited = new Set([...reviews.map((r) => r.placeId), ...photos.map((p) => p.placeId)]);
    $('stReviews').textContent = reviews.length;
    $('stPlaces').textContent = visited.size;
    $('stPhotos').textContent = photos.length;
    $('stVotes').textContent = photos.reduce((s, p) => s + num(p.votes), 0);

    // Insignias: aquí solo las ganadas y las que ya llevan avance (más las de temporada activas).
    // Todas las demás están en /insignias.
    const all = userBadges({ places, reviews, photos, seasonal });
    const mine = all.filter((b) => b.earned || b.count > 0 || b.seasonal)
      .sort((a, b) => Number(b.earned) - Number(a.earned) || (b.count / b.required) - (a.count / a.required));
    const earned = all.filter((b) => b.earned).length;
    $('badgeCount').textContent = earned ? `${isPublic ? 'Ganó' : 'Ganaste'} ${earned} de ${all.length}.` : '';
    $('badgeCount').hidden = !earned;
    $('badges').innerHTML = mine.map((b) => badgeCard(b, seasonalTag(b, seasonal))).join('');
    $('badges').hidden = !mine.length;
    $('badgesEmpty').hidden = mine.length > 0;

    // Galería en cuadrícula.
    const placeName = (id: string) => places.find((p) => p.id === id)?.name || '';
    $('galleryEmpty').hidden = photos.length > 0;
    $('gallery').innerHTML = photos.map((ph) => `<li>
      <a href="/lugar/${encodeURIComponent(ph.placeId)}"><img src="${safeUrl(ph.url)}" alt="Foto en ${esc(placeName(ph.placeId) || ph.placeName || 'un lugar')}" loading="lazy"></a>
      <span class="pf-grid-meta"><a class="place-link" href="/lugar/${encodeURIComponent(ph.placeId)}">${esc(placeName(ph.placeId) || ph.placeName || '')}</a><span class="pf-votes" aria-label="${num(ph.votes)} ${num(ph.votes) === 1 ? 'voto' : 'votos'}"><svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 5 6.4 5c2 0 3.6 1.1 4.6 2.6C12 6.1 13.6 5 15.6 5 19 5 21.1 8.4 19.6 11.8 17.5 16.4 12 21 12 21z"/></svg>${num(ph.votes)}</span></span>
    </li>`).join('');

    // Mis reseñas.
    $('reviewsEmpty').hidden = reviews.length > 0;
    $('myReviews').innerHTML = reviews.slice(0, 20).map((r) => `<li>
      <a href="/lugar/${encodeURIComponent(r.placeId)}">${esc(placeName(r.placeId) || r.placeName || 'Lugar')}</a><span class="pf-stars" aria-label="${num(r.rating)} de 5">${'★'.repeat(num(r.rating))}${'☆'.repeat(5 - num(r.rating))}</span>
      ${r.comment ? `<p>${esc(r.comment)}</p>` : ''}
    </li>`).join('');
  }

  // Galería en mapa: cada lugar con su foto más votada; los visitados sin foto, como punto.
  function showMap() {
    if (!map) {
      map = L.map('galleryMap', { zoomControl: true }).setView([13.75, -88.9], 8);
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>' }).addTo(map);
      const pts: any[] = [];
      const byPlace: Record<string, any[]> = {};
      photos.forEach((ph) => { (byPlace[ph.placeId] ||= []).push(ph); });
      const visited = new Set([...reviews.map((r) => r.placeId), ...Object.keys(byPlace)]);
      visited.forEach((pid) => {
        const p = places.find((x) => x.id === pid);
        if (!p || !Number.isFinite(p.lat)) return;
        const list = byPlace[pid] || [];
        const icon = list.length
          ? L.divIcon({ className: 'pin-wrap', html: `<div class="map-thumb" style="background-image:url('${safeUrl(list[0].url)}')">${list.length > 1 ? `<b>${list.length}</b>` : ''}</div>`, iconSize: [44, 44], iconAnchor: [22, 22] })
          : L.divIcon({ className: 'pin-wrap', html: '<div class="map-visited"></div>', iconSize: [16, 16], iconAnchor: [8, 8] });
        L.marker([p.lat, p.lng], { icon, title: p.name, alt: p.name })
          .bindTooltip(esc(`${p.name}${list.length ? ` · ${list.length} ${list.length === 1 ? 'foto' : 'fotos'}` : ''}`), { direction: 'top', offset: [0, -20], className: 'pin-label' })
          .on('click', () => { location.href = `/#${encodeURIComponent(p.id)}`; })
          .addTo(map);
        pts.push([p.lat, p.lng]);
      });
      if (pts.length) map.fitBounds(L.latLngBounds(pts), { padding: [40, 40], maxZoom: 11 });
    }
    setTimeout(() => map.invalidateSize(), 50);
  }

  function setView(mapView: boolean) {
    $('viewGrid').setAttribute('aria-pressed', String(!mapView));
    $('viewMap').setAttribute('aria-pressed', String(mapView));
    $('gallery').hidden = mapView;
    $('galleryMap').hidden = !mapView;
    if (mapView) { $('galleryEmpty').hidden = true; showMap(); }
    else $('galleryEmpty').hidden = photos.length > 0;
  }
  $('viewGrid').addEventListener('click', () => setView(false));
  $('viewMap').addEventListener('click', () => setView(true));
</script>
